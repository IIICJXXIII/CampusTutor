<view class="card" bindtap="onTap">
  <view class="left-section">
    <image class="avatar" src="{{teacher.avatarUrl || '/static/images/default-avatar.png'}}" mode="aspectFill"></image>
    <view class="badge" wx:if="{{teacher.certStatus === 2}}">已认证</view>
  </view>
  
  <view class="right-section">
    <view class="header">
      <text class="name">{{teacher.realName || '教员'}}</text>
      <text class="price">¥{{teacher.expectPrice}}/h</text>
    </view>
    
    <view class="school-info">
      <text class="uni">{{teacher.universityName}}</text>
      <text class="divider">|</text>
      <text class="major">{{teacher.major}}</text>
    </view>

    <view class="meta-row">
      <view class="rating">
        <text class="star">⭐</text>
        <text class="score">{{teacher.rating || 5.0}}</text>
      </view>
      <text class="distance" wx:if="{{teacher.distance}}">距您 {{filters.formatDistance(teacher.distance)}}</text>
    </view>

    <view class="tags">
      <text class="tag style" wx:if="{{teacher.teachStyle}}">{{teacher.teachStyle}}</text>
      <block wx:for="{{teacher.teachSubjects}}" wx:key="*this" wx:if="{{index < 3}}">
        <text class="tag">{{item}}</text>
      </block>
    </view>
  </view>
</view>

<wxs module="filters">
  var formatDistance = function(d) {
    if (!d) return '';
    if (d < 1) {
      return (d * 1000).toFixed(0) + 'm';
    }
    return d.toFixed(1) + 'km';
  }
  module.exports.formatDistance = formatDistance;
</wxs>