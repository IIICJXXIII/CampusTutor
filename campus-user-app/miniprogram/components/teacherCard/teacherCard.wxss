.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}

.left-section {
  position: relative;
  margin-right: 24rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f5f5f5;
}
.badge {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  background: #409EFF;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  border: 2rpx solid #fff;
}

.right-section {
  flex: 1;
  overflow: hidden; /* 防止内容溢出 */
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.price {
  font-size: 32rpx;
  color: #f56c6c;
  font-weight: bold;
}

.school-info {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}
.divider {
  margin: 0 10rpx;
  color: #ddd;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.rating {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  background: #fffbf0;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}
.star { font-size: 20rpx; margin-right: 4rpx; }
.score { color: #ff9900; font-weight: bold; }
.distance { color: #999; }

.tags {
  display: flex;
  flex-wrap: wrap;
}
.tag {
  font-size: 20rpx;
  color: #666;
  background: #f5f7fa;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}
.tag.style {
  background: #ecf5ff;
  color: #409EFF;
}