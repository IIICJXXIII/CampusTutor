<!-- aiAssistant.wxml -->
<view class="ai-assistant-container">
  <!-- 悬浮按钮 -->
  <view class="floating-btn" bindtap="toggleChatWindow">
    <image class="btn-icon" src="/static/icons/question.svg"></image>
    <view class="notification-badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</view>
  </view>

  <!-- 聊天窗口 -->
  <view class="chat-window" wx:if="{{isChatOpen}}">
    <!-- 头部 -->
    <view class="chat-header">
      <view class="header-left">
        <image class="ai-avatar" src="/static/images/avatar.png"></image>
        <view class="header-info">
          <text class="ai-name">AI智能助手</text>
          <text class="ai-status">在线</text>
        </view>
      </view>
      <view class="header-right">
        <text class="close-btn" bindtap="closeChatWindow">×</text>
      </view>
    </view>

    <!-- 聊天内容 -->
    <scroll-view class="chat-content" scroll-y="true" scroll-into-view="{{scrollToView}}" scroll-with-animation="true">
      <!-- 系统消息 -->
      <view class="system-message">
        <text>您好！我是CampusTutor AI智能助手，有什么可以帮您的吗？</text>
      </view>

      <!-- 消息列表 -->
      <block wx:for="{{messages}}" wx:key="id">
        <!-- 用户消息 -->
        <view class="message user-message" wx:if="{{item.sender === 'user'}}">
          <view class="message-content">
            <text>{{item.content}}</text>
          </view>
          <view class="message-avatar">
            <image src="/static/images/default-avatar.png"></image>
          </view>
        </view>

        <!-- AI消息 -->
        <view class="message ai-message" wx:else>
          <view class="message-avatar">
            <image src="/static/images/avatar.png"></image>
          </view>
          <view class="message-content">
            <text>{{item.content}}</text>
          </view>
        </view>
      </block>

      <!-- 加载中 -->
      <view class="loading-message" wx:if="{{isLoading}}">
        <image class="loading-icon" src="/static/icons/ai-loading.png"></image>
        <text>AI正在思考...</text>
      </view>
    </scroll-view>

    <!-- 快捷问题 -->
    <view class="quick-questions" wx:if="{{showQuickQuestions}}">
      <block wx:for="{{quickQuestions}}" wx:key="id">
        <view class="quick-question-item" bindtap="sendQuickQuestion" data-question="{{item}}">
          <text>{{item}}</text>
        </view>
      </block>
    </view>

    <!-- 输入区域 -->
    <view class="input-area">
      <input 
        class="input-field" 
        placeholder="请输入您的问题..." 
        value="{{inputValue}}"
        bindinput="handleInput"
        bindconfirm="sendMessage"
      />
      <view class="send-btn" bindtap="sendMessage">
        <text>发送</text>
      </view>
    </view>
  </view>
</view>