/* 消息列表页面样式 - messageList.wxss */
.message-list-page {
  min-height: 100vh;
  background: var(--bg-body);
  padding: 24rpx;
}

/* 系统通知 */
.notice-section {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.notice-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(108, 99, 255, 0.3);
}

.notice-icon image {
  width: 48rpx;
  height: 48rpx;
}

.notice-content {
  flex: 1;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.notice-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 24rpx;
}

.notice-time {
  font-size: 22rpx;
  color: var(--text-placeholder);
  margin-bottom: 12rpx;
}

.badge {
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.3);
}

/* 分割线 */
.divider {
  padding: 16rpx 8rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* 会话列表 */
.session-list {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--bg-body);
  transition: background 0.3s;
}

.session-item:last-child {
  border-bottom: none;
}

.session-item:active {
  background: var(--bg-body);
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--bg-body);
}

.unread-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 36rpx;
  text-align: center;
  border: 4rpx solid var(--bg-card);
}

.session-content {
  flex: 1;
  overflow: hidden;
}

.session-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.time {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.last-message {
  font-size: 26rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-placeholder);
}

.empty-state image {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.3;
  margin-bottom: 32rpx;
  filter: grayscale(100%);
}

.empty-state text {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 16rpx;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: var(--text-placeholder);
  font-size: 24rpx;
}
