/* AI助手入口中转页样式 */
page {
  background: #F8F9FA;
  --primary: #1E6F9F;
  --primary-light: #E8F8F5;
  --accent: #f093fb;
  --accent-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.container {
  padding: 24rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
  padding-top: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  background: var(--accent-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 12rpx;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: #64748B;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.feature-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  transition: transform 0.3s ease;
}

.feature-card:active {
  transform: scale(0.98);
}

.feature-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  font-size: 60rpx;
}

.feature-icon.lesson-plan {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.feature-icon.comment {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.feature-icon.chat {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.feature-icon.growth {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.feature-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 8rpx;
  display: block;
}

.feature-desc {
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.4;
}

.tips-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.tips-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 20rpx;
  display: block;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.tip-icon {
  font-size: 24rpx;
  color: var(--accent);
  line-height: 1.4;
}

.tip-text {
  font-size: 22rpx;
  color: #4A5568;
  line-height: 1.4;
  flex: 1;
}
