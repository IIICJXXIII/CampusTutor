.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 0;
}

.loading-tip, .empty-tip {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #999;
}

/* 连接状态提示 */
.connection-tip {
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
}

.connection-tip.connected {
  color: #67c23a;
}

.connection-tip.disconnected {
  color: #f56c6c;
}

/* 消息项 */
.message-item {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.message-item.mine {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ddd;
  flex-shrink: 0;
}

.bubble-wrapper {
  max-width: 60%;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}

.message-item.mine .bubble-wrapper {
  align-items: flex-end;
}

.message-item.other .bubble-wrapper {
  align-items: flex-start;
}

.bubble {
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
}

.message-item.other .bubble {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
}

.message-item.mine .bubble {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-top-right-radius: 4rpx;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.bottom-space {
  height: 32rpx;
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-left: 16rpx;
  padding: 0;
  font-size: 28rpx;
  background: #e0e0e0;
  color: #999;
  border-radius: 36rpx;
  border: none;
  transition: all 0.2s ease;
}

.send-btn.active {
  background: #409EFF;
  color: #fff;
}

.send-btn[disabled] {
  opacity: 0.7;
}

