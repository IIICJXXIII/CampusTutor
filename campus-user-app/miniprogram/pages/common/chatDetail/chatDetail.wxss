/* 聊天详情页样式 - chatDetail.wxss */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-body);
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 32rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.loading-tip, .empty-tip {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: var(--text-placeholder);
}

/* 连接状态提示 */
.connection-tip {
  text-align: center;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 32rpx;
  margin: 0 auto 32rpx;
  display: inline-block;
  width: fit-content;
  align-self: center;
}

.connection-tip.connected {
  color: var(--success);
  background: rgba(76, 217, 100, 0.1);
}

.connection-tip.disconnected {
  color: var(--danger);
  background: rgba(255, 77, 79, 0.1);
}

/* 消息项 */
.message-item {
  display: flex;
  margin-bottom: 40rpx;
  align-items: flex-start;
}

.message-item.mine {
  justify-content: flex-end;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--bg-card);
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.bubble-wrapper {
  max-width: 65%;
  margin: 0 20rpx;
  display: flex;
  flex-direction: column;
}

.message-item.mine .bubble-wrapper {
  align-items: flex-end;
}

.message-item.other .bubble-wrapper {
  align-items: flex-start;
}

.bubble {
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.message-item.other .bubble {
  background: #fff;
  color: #333;
  border: 1rpx solid #E8E0D9;
  border-top-left-radius: 4rpx;
}

.message-item.mine .bubble {
  background: var(--primary); /* Caramel or Blue depending on theme */
  color: #fff;
  border-top-right-radius: 4rpx;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  padding: 0 8rpx;
}

.bottom-space {
  height: 32rpx;
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 10;
}

.input {
  flex: 1;
  height: 80rpx;
  padding: 0 32rpx;
  background: var(--bg-body);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-main);
  transition: all 0.3s;
}

.input:focus {
  background: #fff;
  border: 2rpx solid var(--primary-fade);
}

.send-btn {
  width: 140rpx !important;
  min-width: 140rpx !important;
  height: 80rpx !important;
  min-height: 80rpx !important;
  line-height: 80rpx !important;
  margin-left: 20rpx !important;
  padding: 0 !important;
  font-size: 28rpx;
  background: #f5f5f5;
  color: #999;
  border-radius: 40rpx;
  border: none;
  transition: all 0.2s ease;
  font-weight: 500;
  text-align: center;
  flex-shrink: 0;
}

.send-btn.active {
  background: #409EFF; /* 明亮的蓝色 */
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(64, 158, 255, 0.3);
}


.send-btn.active:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.send-btn[disabled] {
  opacity: 0.7;
}

