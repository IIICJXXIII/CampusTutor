<view class="chat-page">
  <!-- 消息列表 -->
  <scroll-view 
    class="message-list" 
    scroll-y 
    scroll-into-view="{{scrollToMessage}}"
    scroll-with-animation
  >
    <!-- 加载中 -->
    <view class="loading-tip" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 连接状态提示 -->
    <view class="connection-tip {{wsConnected ? 'connected' : 'disconnected'}}" wx:if="{{!loading}}">
      <text wx:if="{{wsConnected}}">● 实时连接中</text>
      <text wx:else bindtap="connectWebSocket">○ 离线模式，点击重连</text>
    </view>

    <!-- 消息列表 -->
    <view 
      class="message-item {{item.senderId == currentUserId ? 'mine' : 'other'}}" 
      wx:for="{{messages}}" 
      wx:key="id"
      id="msg-{{item.id}}"
    >
      <!-- 对方消息 -->
      <block wx:if="{{item.senderId != currentUserId}}">
        <image 
          class="avatar" 
          src="{{targetAvatar || '/static/icons/avatar.png'}}" 
          mode="aspectFill"
        ></image>
        <view class="bubble-wrapper">
          <view class="bubble">{{item.content}}</view>
          <text class="time">{{item.createTime}}</text>
        </view>
      </block>

      <!-- 我的消息 -->
      <block wx:else>
        <view class="bubble-wrapper">
          <view class="bubble">{{item.content}}</view>
          <text class="time">{{item.createTime}}</text>
        </view>
        <image 
          class="avatar" 
          src="{{'/static/icons/avatar.png'}}" 
          mode="aspectFill"
        ></image>
      </block>
    </view>

    <!-- 空状态 -->
    <view class="empty-tip" wx:if="{{!loading && messages.length === 0}}">
      <text>暂无消息，发送一条消息开始聊天吧</text>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input 
      class="input" 
      type="text" 
      placeholder="输入消息..." 
      value="{{inputValue}}"
      bindinput="onInputChange"
      bindconfirm="sendMessage"
      confirm-type="send"
      adjust-position="{{true}}"
    />
    <button 
      class="send-btn {{inputValue ? 'active' : ''}}" 
      bindtap="sendMessage"
    >
      {{sending ? '...' : '发送'}}
    </button>
  </view>
</view>
