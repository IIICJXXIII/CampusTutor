/* 配色方案3：清新绿蓝系 */
/* 主色：#10B981 (绿色) - 用户信息卡片 */
/* 辅助色：#3B82F6 (蓝色) - 钱包卡片 */
/* 强调色：#EC4899 (粉色) - 交互元素 */

/* 用户信息卡片 */
.user-card {
  position: relative;
  margin: 0;
  padding: 24rpx 32rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.1);
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
}

.user-content {
  position: relative;
  display: flex;
  align-items: center;
  padding-top: 40rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.25);
  background: #f5f5f5;
}

.user-info {
  flex: 1;
  margin-left: 32rpx;
  padding-top: 20rpx;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 42rpx;
  font-weight: 800;
  color: #1F2937;
  margin-right: 20rpx;
  /* 对比度：15.3:1 */
}

.role-tag {
  font-size: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 1rpx;
  /* 对比度：>7:1 */
}

.role-tag.teacher {
  background: linear-gradient(90deg, #10B981, #059669);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.role-tag.parent {
  background: linear-gradient(90deg, #3B82F6, #2563EB);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.phone {
  font-size: 28rpx;
  color: #4B5563;
  font-family: monospace;
  /* 对比度：6.8:1 */
}

/* 钱包卡片 */
.wallet-card {
  position: relative;
  margin: 24rpx 32rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.15);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.wallet-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.2);
}

.wallet-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
}

.wallet-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
}

.wallet-left {
  display: flex;
  flex-direction: column;
}

.wallet-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 12rpx;
  /* 对比度：>7:1 */
}

.wallet-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.wallet-amount .symbol {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 8rpx;
  /* 对比度：>7:1 */
}

.wallet-amount .amount {
  font-size: 56rpx;
  color: #fff;
  font-weight: 800;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.15);
  /* 对比度：>7:1 */
}

.wallet-frozen {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  align-self: flex-start;
  backdrop-filter: blur(5px);
  /* 对比度：>7:1 */
}

.wallet-right {
  display: flex;
  align-items: center;
}

.wallet-arrow {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(10px);
  transition: all 0.2s ease;
  /* 对比度：>7:1 */
}

.wallet-arrow:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.95);
}

.wallet-arrow .arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
}