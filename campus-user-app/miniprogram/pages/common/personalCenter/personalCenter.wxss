/* 个人中心页面样式 - personalCenter.wxss */
page {
  background-color: #f5f7fa;
  min-height: 100vh;
}

.container {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding: 0;
}

/* 用户信息卡片 */
.user-card {
  position: relative;
  margin: 0;
  padding: 0 0 56rpx;
  border-radius: 0 0 36rpx 36rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.06);
  width: 100%;
  transition: all 0.3s ease;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
}

.user-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 0;
  gap: 36rpx;
}

.avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  border: 8rpx solid #fff;
  box-shadow: 0 12rpx 32rpx rgba(59, 130, 246, 0.18);
  background: #f8fafc;
  transition: all 0.3s ease;
}

.avatar:active {
  transform: scale(0.95);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.nickname {
  font-size: 44rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.2;
  letter-spacing: 0.5rpx;
}

.role-tag {
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  color: #3b82f6;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  background: rgba(59, 130, 246, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.12);
  transition: all 0.3s ease;
}

.role-tag.teacher {
  background: rgba(59, 130, 246, 0.12);
  color: #3b82f6;
}

.role-tag.parent {
  background: rgba(16, 185, 129, 0.12);
  color: #10b981;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.12);
}

.phone {
  font-size: 30rpx;
  color: #64748b;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
  font-weight: 400;
}

/* 个人资料按钮 */
.profile-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(59, 130, 246, 0.1);
  border-radius: 28rpx;
  align-self: flex-start;
  transition: all 0.3s ease;
  cursor: pointer;
  margin-top: 24rpx;
}

.profile-btn:active {
  background: rgba(59, 130, 246, 0.15);
  transform: scale(0.98);
}

.profile-btn-text {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.profile-btn-arrow {
  font-size: 24rpx;
  color: #3b82f6;
  font-weight: 600;
}

/* 个人资料模态窗口 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  z-index: 999;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 2rpx solid #f1f5f9;
  background: #f8fafc;
  border-radius: 32rpx 32rpx 0 0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: 0.5rpx;
}

.modal-close {
  font-size: 48rpx;
  color: #64748b;
  cursor: pointer;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.modal-close:active {
  background: #e2e8f0;
  color: #334155;
}

.modal-content {
  padding: 40rpx;
  overflow-y: auto;
  flex: 1;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e2e8f0;
  border-top: 6rpx solid #3b82f6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 24rpx;
  text-align: center;
}

.error-text {
  font-size: 28rpx;
  color: #ef4444;
  font-weight: 500;
  line-height: 1.4;
}

.retry-btn {
  padding: 12rpx 32rpx;
  background: #3b82f6;
  color: #fff;
  border: none;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.retry-btn:active {
  background: #2563eb;
  transform: scale(0.98);
}

/* 空数据状态 */
.empty-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* 个人资料信息展示 */
.profile-info {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.info-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: 0.5rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.info-value {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  text-align: right;
  word-break: break-all;
}

/* 用户信息补充区域（可根据需要添加） */
.user-meta {
  display: flex;
  gap: 32rpx;
  padding: 24rpx 40rpx 0;
  margin-top: 16rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-label {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 钱包卡片 */
.wallet-card {
  position: relative;
  margin: 24rpx 16rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(147, 197, 253, 0.15);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  background: #fff;
  width: calc(100% - 32rpx);
}

.wallet-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.2);
}

.wallet-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
  opacity: 0.9;
}

.wallet-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
}

.wallet-left {
  display: flex;
  flex-direction: column;
}

.wallet-label {
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.wallet-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.wallet-amount .symbol {
  font-size: 32rpx;
  color: #1f2937;
  font-weight: bold;
  margin-right: 8rpx;
}

.wallet-amount .amount {
  font-size: 56rpx;
  color: #111827;
  font-weight: 800;
  text-shadow: none;
}

.wallet-frozen {
  font-size: 24rpx;
  color: #6b7280;
  background: rgba(156, 163, 175, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.wallet-right {
  display: flex;
  align-items: center;
}

.wallet-arrow {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #4b5563;
  background: rgba(156, 163, 175, 0.15);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(10px);
}

.wallet-arrow .arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
}

/* 菜单区域 */
.menu-section {
  margin: 0 32rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  width: calc(100% - 64rpx); /* 调整宽度，充分利用可用空间 */
}

.menu-title {
  font-size: 28rpx;
  color: #999;
  padding: 28rpx 32rpx 16rpx;
  font-weight: 500;
}

.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx; /* 调整内边距，优化间距 */
  border-bottom: 1rpx solid #f8f9fc;
  transition: background-color 0.2s ease;
}

.menu-item:active {
  background-color: #fafbfc;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  background: #f8f9fc;
  transition: all 0.2s ease;
}

.menu-item:active .menu-icon-wrap {
  background: #eef2f7;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
}

.menu-title-text {
  font-size: 34rpx;
  color: #333;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #e0e0e0;
}

/* 退出登录 */
.logout-section {
  padding: 32rpx 32rpx 64rpx;
}

.btn-logout {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: #fff;
  color: #ff4d4f;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.1);
  transition: all 0.2s ease;
}

.btn-logout::after {
  border: none;
}

.btn-logout:active {
  background: #fff1f0;
  transform: scale(0.99);
  box-shadow: 0 4rpx 16rpx rgba(255, 77, 79, 0.15);
}