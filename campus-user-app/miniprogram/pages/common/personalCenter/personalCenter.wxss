/* 个人中心页面样式 - personalCenter.wxss */
page {
  background-color: var(--bg-body);
}

.container {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 用户信息卡片 */
.user-card {
  position: relative;
  margin: 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #E6F4FF 0%, #F0F7FF 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  padding: 40rpx;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #E6F4FF 0%, #F0F7FF 100%);
}

/* 装饰圆圈 */
.user-bg::after {
  content: '';
  position: absolute;
  top: -15%;
  right: -8%;
  width: 280rpx;
  height: 280rpx;
  background: rgba(108, 99, 255, 0.12);
  border-radius: 50%;
}

.user-content {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

/* 查看个人资料按钮 */
.view-profile-btn {
  align-self: flex-end;
  height: 64rpx;
  padding: 0 48rpx;
  background: rgba(108, 99, 255, 0.1);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 60rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(108, 99, 255, 0.15);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.view-profile-btn:active {
  background: var(--primary);
  color: #fff;
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(108, 99, 255, 0.3);
}

.view-profile-btn::after {
  border: none;
}

/* 按钮禁用状态 */
.view-profile-btn:disabled {
  background: rgba(108, 99, 255, 0.05);
  color: rgba(108, 99, 255, 0.5);
  border: 2rpx solid rgba(108, 99, 255, 0.3);
  box-shadow: none;
  transform: none;
  opacity: 0.6;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  background: var(--bg-body);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 12rpx;
  line-height: 1.2;
}

.role-tag {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.role-tag.teacher {
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  box-shadow: 0 4rpx 12rpx rgba(108, 99, 255, 0.3);
}

.role-tag.parent {
  background: linear-gradient(90deg, #36d1dc, #5b86e5);
  box-shadow: 0 4rpx 12rpx rgba(54, 209, 220, 0.3);
}

.phone {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-family: monospace;
  line-height: 1.4;
}

/* 钱包卡片 */
.wallet-card {
  position: relative;
  margin: 0 32rpx 32rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.wallet-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #D1E7FF;
}

.wallet-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
}

.wallet-left {
  display: flex;
  flex-direction: column;
}

.wallet-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  font-weight: 600;
}

.wallet-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.wallet-amount .symbol {
  font-size: 36rpx;
  color: var(--text-main);
  font-weight: 700;
  margin-right: 8rpx;
}

.wallet-amount .amount {
  font-size: 64rpx;
  color: var(--text-main);
  font-weight: 800;
  line-height: 1;
}

.wallet-frozen {
  font-size: 24rpx;
  color: var(--text-secondary);
  background: rgba(0, 0, 0, 0.08);
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  align-self: flex-start;
}

.wallet-right {
  display: flex;
  align-items: center;
}

.wallet-arrow {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--primary);
  background: rgba(108, 99, 255, 0.15);
  padding: 16rpx 32rpx;
  border-radius: 36rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.wallet-arrow:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.wallet-arrow .arrow {
  margin-left: 12rpx;
  font-size: 24rpx;
}

/* 菜单区域 */
.menu-section {
  margin: 0 32rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-title {
  font-size: 28rpx;
  color: var(--text-placeholder);
  padding: 32rpx 32rpx 16rpx;
  font-weight: 600;
}

.menu-list {
  padding: 0 16rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--bg-body);
  transition: background 0.3s;
  border-radius: var(--radius-md);
}

.menu-item:active {
  background-color: var(--bg-body);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  background: var(--bg-body);
  transition: transform 0.3s;
}

.menu-item:active .menu-icon-wrap {
  transform: scale(0.95);
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
}

.menu-title-text {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 600;
}

.menu-arrow {
  font-size: 24rpx;
  color: var(--text-placeholder);
  font-family: monospace;
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 32rpx;
}

.btn-logout {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--bg-card);
  color: var(--danger);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s;
}

.btn-logout::after {
  border: none;
}

.btn-logout:active {
  background: var(--bg-body);
  transform: scale(0.98);
}