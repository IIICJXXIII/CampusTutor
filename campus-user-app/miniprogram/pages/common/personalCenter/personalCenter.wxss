/* 个人中心页面样式 - personalCenter.wxss */
page {
  background-color: var(--bg-body);
}

.container {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 用户信息卡片 */
.user-card {
  position: relative;
  margin: 32rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
}

/* 装饰圆圈 */
.user-bg::after {
  content: '';
  position: absolute;
  top: -20%;
  right: -10%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.user-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid var(--bg-card);
  box-shadow: var(--shadow-sm);
  background: var(--bg-body);
}

.user-info {
  flex: 1;
  margin-left: 32rpx;
  padding-top: 60rpx;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-right: 16rpx;
}

.role-tag {
  font-size: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.role-tag.teacher {
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  box-shadow: 0 4rpx 12rpx rgba(108, 99, 255, 0.3);
}

.role-tag.parent {
  background: linear-gradient(90deg, #36d1dc, #5b86e5);
  box-shadow: 0 4rpx 12rpx rgba(54, 209, 220, 0.3);
}

.phone {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-family: monospace;
}

/* 钱包卡片 */
.wallet-card {
  position: relative;
  margin: 0 32rpx 32rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.wallet-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--secondary), #ff9a9e);
}

.wallet-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
}

.wallet-left {
  display: flex;
  flex-direction: column;
}

.wallet-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
}

.wallet-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.wallet-amount .symbol {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  margin-right: 8rpx;
}

.wallet-amount .amount {
  font-size: 60rpx;
  color: #fff;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.wallet-frozen {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  align-self: flex-start;
  backdrop-filter: blur(4px);
}

.wallet-right {
  display: flex;
  align-items: center;
}

.wallet-arrow {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(10px);
  font-weight: 600;
  transition: opacity 0.3s;
}

.wallet-arrow:active {
  opacity: 0.8;
}

.wallet-arrow .arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
}

/* 菜单区域 */
.menu-section {
  margin: 0 32rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-title {
  font-size: 28rpx;
  color: var(--text-placeholder);
  padding: 32rpx 32rpx 16rpx;
  font-weight: 600;
}

.menu-list {
  padding: 0 16rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--bg-body);
  transition: background 0.3s;
  border-radius: var(--radius-md);
}

.menu-item:active {
  background-color: var(--bg-body);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  background: var(--bg-body);
  transition: transform 0.3s;
}

.menu-item:active .menu-icon-wrap {
  transform: scale(0.95);
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
}

.menu-title-text {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 600;
}

.menu-arrow {
  font-size: 24rpx;
  color: var(--text-placeholder);
  font-family: monospace;
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 32rpx;
}

.btn-logout {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--bg-card);
  color: var(--danger);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s;
}

.btn-logout::after {
  border: none;
}

.btn-logout:active {
  background: var(--bg-body);
  transform: scale(0.98);
}