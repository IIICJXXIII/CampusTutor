/* 个人中心页面样式 - personalCenter.wxss */
page {
  background-color: #f8f9fc;
}

.container {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 用户信息卡片 */
.user-card {
  position: relative;
  margin: 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.08);
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.user-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 64rpx 40rpx 48rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  background: #f5f5f5;
}

.user-info {
  flex: 1;
  margin-left: 32rpx;
  padding-top: 60rpx;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-right: 20rpx;
}

.role-tag {
  font-size: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.role-tag.teacher {
  background: linear-gradient(90deg, #667eea, #764ba2);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.role-tag.parent {
  background: linear-gradient(90deg, #36d1dc, #5b86e5);
  box-shadow: 0 4rpx 12rpx rgba(54, 209, 220, 0.3);
}

.phone {
  font-size: 28rpx;
  color: #888;
  font-family: monospace;
}

/* 钱包卡片 */
.wallet-card {
  position: relative;
  margin: 0 32rpx 32rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(240, 147, 251, 0.2);
}

.wallet-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.wallet-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
}

.wallet-left {
  display: flex;
  flex-direction: column;
}

.wallet-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.wallet-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.wallet-amount .symbol {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 8rpx;
}

.wallet-amount .amount {
  font-size: 56rpx;
  color: #fff;
  font-weight: 800;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.wallet-frozen {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.wallet-right {
  display: flex;
  align-items: center;
}

.wallet-arrow {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(10px);
}

.wallet-arrow .arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
}

/* 菜单区域 */
.menu-section {
  margin: 0 32rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.menu-title {
  font-size: 28rpx;
  color: #999;
  padding: 32rpx 32rpx 16rpx;
  font-weight: 500;
}

.menu-list {
  padding: 0 16rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 16rpx; /* 增加点击区域和间距 */
  border-bottom: 1rpx solid #f8f9fc;
}

.menu-item:active {
  background-color: #fcfcfc;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  background: #f8f9fc;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
}

.menu-title-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.menu-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 退出登录 */
.logout-section {
  padding: 48rpx 32rpx;
}

.btn-logout {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #fff;
  color: #ff4d4f;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.1);
}

.btn-logout::after {
  border: none;
}

.btn-logout:active {
  background: #fff1f0;
  transform: scale(0.99);
}