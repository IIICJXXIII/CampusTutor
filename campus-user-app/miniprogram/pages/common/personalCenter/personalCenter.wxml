<!-- 个人中心页面 - personalCenter.wxml -->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card" bindtap="goToUserInfoView">
    <view class="user-bg"></view>
    <view class="user-content">
      <image class="avatar" src="{{userInfo.avatarUrl || '/static/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-info">
        <view class="name-row">
          <text class="nickname">{{userInfo.nickname || '未登录'}}</text>
          <view class="role-tag {{userInfo.role === 1 ? 'teacher' : 'parent'}}">
            {{userInfo.role === 1 ? '教师' : '家长'}}
          </view>
        </view>
        <text class="phone">{{userInfo.username || ''}}</text>
      </view>
    </view>
  </view>

  <!-- 钱包资产卡片（教师专属） -->
  <view wx:if="{{userInfo.role === 1}}" class="wallet-card" bindtap="goToIncome">
    <view class="wallet-bg"></view>
    <view class="wallet-content">
      <view class="wallet-left">
        <text class="wallet-label">我的钱包</text>
        <view class="wallet-amount">
          <text class="symbol">¥</text>
          <text class="amount">{{walletInfo.balance || '0.00'}}</text>
        </view>
        <text class="wallet-frozen">冻结中: ¥{{walletInfo.frozenAmount || '0.00'}}</text>
      </view>
      <view class="wallet-right">
        <view class="wallet-arrow">
          <text>收入明细</text>
          <text class="arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-title">常用功能</view>
    <view class="menu-list">
      <block wx:for="{{menuList}}" wx:key="title">
        <view class="menu-item" bindtap="handleMenuClick" data-url="{{item.url}}">
          <view class="menu-left">
            <view class="menu-icon-wrap" style="background: {{item.bgColor || '#f5f5f5'}}">
              <image class="menu-icon" src="/static/icons/{{item.icon}}.png" mode="aspectFit"></image>
            </view>
            <text class="menu-title-text">{{item.title}}</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
      </block>
    </view>
  </view>

  <!-- 其他设置 -->
  <view class="menu-section">
    <view class="menu-title">其他</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="handleAbout">
        <view class="menu-left">
          <view class="menu-icon-wrap" style="background: #e8f4fd">
            <image class="menu-icon" src="/static/icons/question.svg" mode="aspectFit"></image>
          </view>
          <text class="menu-title-text">关于我们</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="handleFeedback">
        <view class="menu-left">
          <view class="menu-icon-wrap" style="background: #fff5e6">
            <image class="menu-icon" src="/static/icons/customer-service.svg" mode="aspectFit"></image>
          </view>
          <text class="menu-title-text">意见反馈</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>
</view>