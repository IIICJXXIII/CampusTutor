<!-- 个人中心页面 - personalCenter.wxml -->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-bg"></view>
    <view class="user-content">
      <image class="avatar" src="{{userInfo.avatar || '/static/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-info">
        <view class="name-row">
          <text class="nickname">{{userInfo.nickname || '未登录'}}</text>
          <view class="role-tag {{userInfo.role === 1 ? 'teacher' : 'parent'}}">
            {{userInfo.role === 1 ? '教师' : '家长'}}
          </view>
        </view>
        <text class="phone">{{userInfo.username || ''}}</text>
        <!-- 个人资料按钮 -->
        <view class="profile-btn" bindtap="showProfileModal">
          <text class="profile-btn-text">查看个人资料</text>
          <text class="profile-btn-arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 个人资料模态窗口 -->
  <view class="modal-overlay" wx:if="{{showProfileModal}}" bindtap="hideProfileModal"></view>
  <view class="profile-modal" wx:if="{{showProfileModal}}">
    <view class="modal-header">
      <text class="modal-title">个人资料</text>
      <view class="modal-close" bindtap="hideProfileModal">×</view>
    </view>
    <view class="modal-content">
      <!-- 加载状态 -->
      <view wx:if="{{profileLoading}}" class="loading-container">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      
      <!-- 加载失败状态 -->
      <view wx:elif="{{profileError}}" class="error-container">
        <text class="error-text">{{profileError}}</text>
        <button class="retry-btn" bindtap="loadProfileData">重试</button>
      </view>
      
      <!-- 空数据状态 -->
      <view wx:elif="{{!profileData || (!profileData.name && !profileData.phone && !profileData.email)}}" class="empty-container">
        <text class="empty-text">暂无个人资料信息</text>
      </view>
      
      <!-- 正常数据展示 -->
      <view wx:else class="profile-info">
        <view class="info-section">
          <text class="section-title">基本信息</text>
          <view class="info-item">
            <text class="info-label">姓名</text>
            <text class="info-value">{{profileData.name || '-'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">性别</text>
            <text class="info-value">{{profileData.gender === 1 ? '男' : profileData.gender === 2 ? '女' : '-'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">出生日期</text>
            <text class="info-value">{{profileData.birthDate || '-'}}</text>
          </view>
        </view>
        
        <view class="info-section">
          <text class="section-title">联系方式</text>
          <view class="info-item">
            <text class="info-label">联系电话</text>
            <text class="info-value">{{profileData.desensitizedPhone || '-'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">电子邮箱</text>
            <text class="info-value">{{profileData.desensitizedEmail || '-'}}</text>
          </view>
        </view>
        
        <view class="info-section">
          <text class="section-title">身份信息</text>
          <view class="info-item">
            <text class="info-label">身份证号</text>
            <text class="info-value">{{profileData.desensitizedIdCard || '-'}}</text>
          </view>
        </view>
        
        <view class="info-section">
          <text class="section-title">注册信息</text>
          <view class="info-item">
            <text class="info-label">注册时间</text>
            <text class="info-value">{{profileData.registerTime || '-'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 钱包资产卡片（教师专属） -->
  <view wx:if="{{userInfo.role === 1}}" class="wallet-card" bindtap="goToIncome">
    <view class="wallet-bg"></view>
    <view class="wallet-content">
      <view class="wallet-left">
        <text class="wallet-label">我的钱包</text>
        <view class="wallet-amount">
          <text class="symbol">¥</text>
          <text class="amount">{{walletInfo.balance || '0.00'}}</text>
        </view>
        <text class="wallet-frozen">冻结中: ¥{{walletInfo.frozenAmount || '0.00'}}</text>
      </view>
      <view class="wallet-right">
        <view class="wallet-arrow">
          <text>收入明细</text>
          <text class="arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-title">常用功能</view>
    <view class="menu-list">
      <block wx:for="{{menuList}}" wx:key="title">
        <view class="menu-item" bindtap="handleMenuClick" data-url="{{item.url}}">
          <view class="menu-left">
            <view class="menu-icon-wrap" style="background: {{item.bgColor || '#f5f5f5'}}">
              <image class="menu-icon" src="/static/icons/{{item.icon}}.png" mode="aspectFit"></image>
            </view>
            <text class="menu-title-text">{{item.title}}</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
      </block>
    </view>
  </view>

  <!-- 其他设置 -->
  <view class="menu-section">
    <view class="menu-title">其他</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="handleAbout">
        <view class="menu-left">
          <view class="menu-icon-wrap" style="background: #e8f4fd">
            <image class="menu-icon" src="/static/icons/question.svg" mode="aspectFit"></image>
          </view>
          <text class="menu-title-text">关于我们</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="handleFeedback">
        <view class="menu-left">
          <view class="menu-icon-wrap" style="background: #fff5e6">
            <image class="menu-icon" src="/static/icons/customer-service.svg" mode="aspectFit"></image>
          </view>
          <text class="menu-title-text">意见反馈</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>
</view>