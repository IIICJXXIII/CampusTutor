/* 错题本页面样式 - wrongBook.wxss */
page {
  background-color: var(--bg-body);
}

.container {
  padding: 32rpx;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 2rpx;
  position: relative;
  padding-left: 24rpx;
}

.title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: var(--primary);
  border-radius: 4rpx;
}

.item {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s;
  border: 1rpx solid transparent;
}

.item:active {
  transform: scale(0.99);
  background: var(--bg-body);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.q {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  flex: 1;
  margin-right: 24rpx;
  line-height: 1.5;
}

.tag {
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(108, 99, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid var(--bg-body);
  padding-top: 16rpx;
  margin-top: 16rpx;
}

.date {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.resolve {
  background: var(--success);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(76, 217, 100, 0.3);
}

.loading, .empty {
  text-align: center;
  color: var(--text-placeholder);
  padding: 60rpx;
  font-size: 26rpx;
}
