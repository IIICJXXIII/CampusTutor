.container {
  padding: 40rpx;
  background-color: #fff;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  margin-top: 100rpx;
  margin-bottom: 80rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.form-box {
  width: 100%;
}

.input-group {
  margin-bottom: 40rpx;
  border-bottom: 1px solid #eee;
  padding-bottom: 10rpx;
}

.input-group.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.input {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
}

.code-btn {
  font-size: 28rpx;
  color: #409EFF;
  padding: 10rpx 20rpx;
}

.submit-btn {
  margin-top: 60rpx;
  background-color: #409EFF;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.wx-login-btn {
  margin-top: 24rpx;
  background-color: #07C160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
}

.footer-actions {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.link {
  padding: 20rpx;
}

.divider {
  color: #ddd;
}