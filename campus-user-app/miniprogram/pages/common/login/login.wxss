/* pages/common/login/login.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background-color: #fff;
  height: 100vh;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  background-color: #eee; /* 占位色，防止图片加载失败看不到 */
  border-radius: 50%;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.form-box {
  width: 100%;
}

.input-group {
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #eee;
  padding: 20rpx 0;
}

.input {
  width: 100%;
  font-size: 32rpx;
  color: #333;
}

.btn-primary {
  background-color: #0052D9; /* 蓝色主题 */
  color: #fff;
  border-radius: 40rpx;
  margin-top: 60rpx;
  font-weight: normal;
}

.action-links {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.divider {
  margin: 0 20rpx;
  color: #ccc;
}