/* 用户信息查看页面样式 - userInfoView.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, var(--bg-body) 0%, #eef1f5 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面头部 */
.page-header {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.header-right {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

/* 删除不需要的样式 */
.header-left,
.back-icon,
.header-right {
  display: none;
}

/* 修改按钮样式 */
.edit-btn {
  font-size: 28rpx;
  color: var(--primary);
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-weight: 600;
}

.edit-btn::after {
  border: none;
}

/* 主要内容 */
.content {
  padding: 40rpx 32rpx;
}

/* 用户头像区域 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 60rpx;
}

.avatar-container {
  position: relative;
  margin-bottom: 32rpx;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: var(--shadow-md);
  background: var(--bg-card);
}

.avatar-badge {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  box-shadow: var(--shadow-sm);
  border: 4rpx solid #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.user-name-section {
  text-align: center;
}

.user-nickname {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 8rpx;
  display: block;
}

.user-username {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-family: monospace;
}

/* 信息卡片 */
.info-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 24rpx 16rpx;
  border-bottom: 1rpx solid var(--bg-body);
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  border-left: 6rpx solid var(--primary);
  padding-left: 14rpx;
  margin: 0;
}

/* 基本信息版块修改按钮样式 */
.card-edit-btn {
  font-size: 22rpx;
  color: var(--primary);
  background: transparent;
  border: 1rpx solid var(--primary);
  border-radius: 16rpx;
  padding: 6rpx 16rpx !important;
  line-height: 1.2;
  font-weight: 500;
  box-shadow: none;
  transition: all 0.3s ease;
  min-width: auto !important;
  width: auto !important;
  white-space: nowrap;
  height: auto !important;
  display: block;
  margin: 0 !important;
  text-align: center;
  overflow: visible;
  position: relative;
}

/* 重置微信小程序按钮默认样式 */
.card-edit-btn::after {
  display: none !important;
  content: none !important;
}

.card-edit-btn:active {
  background: var(--primary);
  color: #fff;
  transform: scale(0.95);
  border-color: var(--primary);
}

/* 确保按钮不会继承任何额外样式 */
.card-edit-btn:focus {
  outline: none;
}

/* 调整卡片头部布局，确保按钮完全靠右 */
.card-header {
  position: relative;
}

.card-header .card-edit-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--bg-body);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.info-value {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: right;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 状态标签样式 */
.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  text-align: right;
}

/* 不同状态的样式 */
.status-badge.passed {
  background: rgba(100, 200, 80, 0.15);
  color: #64C850;
}

.status-badge.failed {
  background: rgba(255, 87, 34, 0.15);
  color: #FF5722;
}

.status-badge.pending {
  background: rgba(255, 193, 7, 0.15);
  color: #FFC107;
}

.status-text {
  font-size: 24rpx;
  font-weight: 600;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  padding: 40rpx 0;
}

.tip-text {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* 编辑模式样式 */
.edit-input-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.edit-input {
  width: 100%;
  max-width: 400rpx;
  height: 64rpx;
  border: 2rpx solid var(--border);
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-main);
  background: var(--bg-body);
  text-align: right;
}

.edit-input:focus {
  border-color: var(--primary);
  background: #fff;
}

.edit-select-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.edit-picker {
  width: 100%;
  max-width: 400rpx;
  height: 64rpx;
  border: 2rpx solid var(--border);
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-main);
  background: var(--bg-body);
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.picker-value {
  text-align: right;
  flex: 1;
}

/* 编辑模式底部按钮 */
.edit-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.footer-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin: 0 16rpx;
  transition: all 0.3s;
  border: none;
}

.footer-btn::after {
  border: none;
}

.cancel-btn {
  background: var(--bg-body);
  color: var(--text-main);
  border: 2rpx solid var(--border);
}

.cancel-btn:active {
  background: var(--border);
}

.save-btn {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  box-shadow: var(--shadow-md);
}

.save-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}