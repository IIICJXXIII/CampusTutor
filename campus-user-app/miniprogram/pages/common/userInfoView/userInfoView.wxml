<!-- 用户信息查看页面 - userInfoView.wxml -->
<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="header-center">
      <text class="title">个人信息</text>
    </view>
  </view>

  <!-- 主要内容 -->
  <view class="content">
    <!-- 用户头像区域 -->
    <view class="avatar-section">
      <view class="avatar-container">
        <image 
          class="avatar" 
          src="{{userInfo.avatar || userInfo.avatarUrl || '/static/images/default-avatar.png'}}" 
          mode="aspectFill"
        ></image>
        <view class="avatar-badge">
          <text class="badge-text">{{userInfo.role === 1 ? '教师' : '家长'}}</text>
        </view>
      </view>
      <view class="user-name-section">
        <text class="user-nickname">{{userInfo.nickname || userInfo.username || '未设置昵称'}}</text>
        <text class="user-username">{{userInfo.username || '未设置账号'}}</text>
      </view>
    </view>

    <!-- 信息卡片 -->
    <view class="info-card">
      <view class="card-header">
        <text class="card-title">基本信息</text>
        <button wx:if="{{!isEditMode}}" class="card-edit-btn" bindtap="switchToEditMode">
          修改
        </button>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">账号</text>
          <text class="info-hint">登录账号</text>
        </view>
        <text class="info-value">{{userInfo.username || '未设置'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">昵称</text>
          <text class="info-hint">个人昵称</text>
        </view>
        <view wx:if="{{isEditMode}}" class="edit-input-wrap">
          <input 
            class="edit-input" 
            placeholder="请输入昵称" 
            value="{{editUserInfo.nickname || ''}}" 
            data-field="nickname" 
            bindinput="onInputChange"
          />
        </view>
        <text wx:else class="info-value">{{userInfo.nickname || '未设置'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">角色</text>
          <text class="info-hint">用户身份</text>
        </view>
        <view class="role-badge {{userInfo.role === 1 ? 'teacher' : 'parent'}}">
          <text class="role-text">{{userInfo.role === 1 ? '教师' : '家长'}}</text>
        </view>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">手机号</text>
          <text class="info-hint">联系电话</text>
        </view>
        <view wx:if="{{isEditMode}}" class="edit-input-wrap">
          <input 
            class="edit-input" 
            placeholder="请输入手机号" 
            value="{{editUserInfo.phone || editUserInfo.username || ''}}" 
            data-field="phone" 
            bindinput="onInputChange"
            type="number"
          />
        </view>
        <text wx:else class="info-value">{{userInfo.phone || userInfo.username || '未设置'}}</text>
      </view>

    </view>
    
    <!-- 认证信息卡片 -->
    <view class="info-card" wx:if="{{userInfo.role === 1}}">
      <view class="card-header">
        <text class="card-title">教师认证信息</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">真实姓名</text>
          <text class="info-hint">认证姓名</text>
        </view>
        <text class="info-value">{{userInfo.realName || '未认证'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">身份证号</text>
          <text class="info-hint">认证身份证</text>
        </view>
        <text class="info-value">{{userInfo.idCard || '未认证'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">学历</text>
          <text class="info-hint">最高学历</text>
        </view>
        <text class="info-value">{{userInfo.education || '未认证'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">毕业院校</text>
          <text class="info-hint">毕业学校</text>
        </view>
        <text class="info-value">{{userInfo.school || '未认证'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">专业</text>
          <text class="info-hint">所学专业</text>
        </view>
        <text class="info-value">{{userInfo.major || '未认证'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">教龄</text>
          <text class="info-hint">教学经验</text>
        </view>
        <text class="info-value">{{userInfo.teachingExperience || '未认证'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">认证状态</text>
          <text class="info-hint">当前认证情况</text>
        </view>
        <view class="status-badge {{userInfo.certificationStatus === 1 ? 'passed' : userInfo.certificationStatus === 2 ? 'failed' : 'pending'}}">
          <text class="status-text">
            {{userInfo.certificationStatus === 1 ? '已通过' : userInfo.certificationStatus === 2 ? '未通过' : '待审核'}}
          </text>
        </view>
      </view>
    </view>
    
    <!-- 家长认证信息卡片 -->
    <view class="info-card" wx:if="{{userInfo.role === 2}}">
      <view class="card-header">
        <text class="card-title">家长认证信息</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">真实姓名</text>
          <text class="info-hint">认证姓名</text>
        </view>
        <text class="info-value">{{userInfo.realName || '未认证'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">身份证号</text>
          <text class="info-hint">认证身份证</text>
        </view>
        <text class="info-value">{{userInfo.idCard || '未认证'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">学生姓名</text>
          <text class="info-hint">子女姓名</text>
        </view>
        <text class="info-value">{{userInfo.studentName || '未设置'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">学生年级</text>
          <text class="info-hint">子女年级</text>
        </view>
        <text class="info-value">{{userInfo.studentGrade || '未设置'}}</text>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="footer-tip" wx:if="{{!isEditMode}}">
      <text class="tip-text">点击头像可查看大图</text>
    </view>
    
    <!-- 编辑模式底部按钮 -->
    <view wx:if="{{isEditMode}}" class="edit-footer">
      <button class="footer-btn cancel-btn" bindtap="cancelEdit">取消</button>
      <button class="footer-btn save-btn" bindtap="saveEdit">保存</button>
    </view>
  </view>
</view>