<!-- 用户信息查看页面 - userInfoView.wxml -->
<wxs src="../../../utils/array.wxs" module="arrayUtil" />
<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="header-center">
      <text class="title">个人信息</text>
    </view>
    <view class="header-right">
      <text wx:if="{{userInfo.role === 1 && !isEditing}}" class="edit-btn" bindtap="toggleEdit">编辑</text>
      <text wx:if="{{userInfo.role === 1 && isEditing}}" class="cancel-btn" bindtap="toggleEdit">取消</text>
    </view>
  </view>

  <!-- 主要内容 -->
  <view class="content">
    <!-- 用户头像区域 -->
    <view class="avatar-section">
      <view class="avatar-container">
        <image 
          class="avatar" 
          src="{{userInfo.avatar || userInfo.avatarUrl || '/static/images/default-avatar.png'}}" 
          mode="aspectFill"
        ></image>
        <view class="avatar-badge">
          <text class="badge-text">{{userInfo.role === 1 ? '教师' : '家长'}}</text>
        </view>
      </view>
      <view class="user-name-section">
        <text class="user-nickname">{{userInfo.nickname || userInfo.username || '未设置昵称'}}</text>
        <text class="user-username">{{userInfo.username || '未设置账号'}}</text>
      </view>
    </view>

    <!-- 基本信息卡片 -->
    <view class="info-card">
      <view class="card-header">
        <text class="card-title">基本信息</text>
        <button wx:if="{{!isEditMode}}" class="card-edit-btn" bindtap="switchToEditMode">
          修改
        </button>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">账号</text>
        </view>
        <text class="info-value">{{userInfo.username || '未设置'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">昵称</text>
        </view>
        <view wx:if="{{isEditMode}}" class="edit-input-wrap">
          <input 
            class="edit-input" 
            placeholder="请输入昵称" 
            value="{{editUserInfo.nickname || ''}}" 
            data-field="nickname" 
            bindinput="onInputChange"
          />
        </view>
        <text wx:else class="info-value">{{userInfo.nickname || '未设置'}}</text>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">角色</text>
        </view>
        <view class="role-badge {{userInfo.role === 1 ? 'teacher' : 'parent'}}">
          <text class="role-text">{{userInfo.role === 1 ? '教师' : '家长'}}</text>
        </view>
      </view>
    </view>

    <!-- 教学设置卡片（仅教师） -->
    <view wx:if="{{userInfo.role === 1}}" class="info-card teaching-card">
      <view class="card-header">
        <text class="card-title">教学设置</text>
        <text wx:if="{{isEditing}}" class="edit-hint">点击选择/取消</text>
      </view>

      <!-- 可教授年级 -->
      <view class="setting-section">
        <view class="setting-label">可教授年级</view>
        <view class="tag-container">
          <view 
            wx:for="{{gradeList}}" 
            wx:key="id" 
            class="tag {{arrayUtil.includes(selectedGrades, item.id) ? 'selected' : ''}} {{isEditing ? 'editable' : ''}}"
            bindtap="toggleGrade"
            data-id="{{item.id}}"
          >{{item.name}}</view>
        </view>
      </view>

      <!-- 可教授科目 -->
      <view class="setting-section">
        <view class="setting-label">可教授科目</view>
        <view class="tag-container">
          <view 
            wx:for="{{subjectList}}" 
            wx:key="id" 
            class="tag {{arrayUtil.includes(selectedSubjects, item.id) ? 'selected' : ''}} {{isEditing ? 'editable' : ''}}"
            bindtap="toggleSubject"
            data-id="{{item.id}}"
          >{{item.name}}</view>
        </view>
      </view>

      <!-- 期望时薪 -->
      <view class="setting-section">
        <view class="setting-label">期望时薪</view>
        <view class="price-display" wx:if="{{!isEditing}}">
          <text class="price-value">¥{{expectPrice || '未设置'}}</text>
          <text wx:if="{{expectPrice}}" class="price-unit">/小时</text>
        </view>
        <view class="price-input-wrap" wx:if="{{isEditing}}">
          <text class="price-symbol">¥</text>
          <input 
            class="price-input" 
            type="digit" 
            placeholder="请输入时薪" 
            value="{{expectPrice}}" 
            bindinput="onPriceInput"
          />
          <text class="price-suffix">/小时</text>
        </view>
      </view>

      <!-- 保存按钮 -->
      <view wx:if="{{isEditing}}" class="save-section">
        <button class="save-btn" bindtap="saveProfile" loading="{{isSaving}}">保存修改</button>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="footer-tip" wx:if="{{!isEditing}}">
      <text class="tip-text">{{userInfo.role === 1 ? '点击右上角"编辑"可修改教学设置' : '如需修改信息请联系客服'}}</text>
    </view>
    
    <!-- 编辑模式底部按钮 -->
    <view wx:if="{{isEditMode}}" class="edit-footer">
      <button class="footer-btn cancel-btn" bindtap="cancelEdit">取消</button>
      <button class="footer-btn save-btn" bindtap="saveEdit">保存</button>
    </view>
  </view>
</view>