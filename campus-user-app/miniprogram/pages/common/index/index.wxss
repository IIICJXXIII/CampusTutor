/* 首页样式 - index.wxss */
page {
  background: var(--bg-body);
}

.container {
  padding: 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 顶部欢迎区域 */
.header {
  padding: 20rpx 0 40rpx;
}

.welcome {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 8rpx;
  letter-spacing: -1rpx;
}

.subtitle {
  font-size: 30rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

/* 数据统计卡片（教师端） */
.stats-card {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  border-radius: var(--radius-xl);
  padding: 40rpx 32rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 48rpx;
  box-shadow: var(--shadow-primary);
  position: relative;
  overflow: hidden;
}

/* 装饰性背景圆圈 */
.stats-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  pointer-events: none;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.95); /* Keep white if background is dark gradient */
  margin-bottom: 4rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

/* Fix visibility if background is light */
.stats-card {
  background: white; /* Override gradient */
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05); /* Softer shadow */
}
.stats-card .stat-value {
    color: #333; /* Dark text for visibility */
    text-shadow: none;
}
.stats-card .stat-label {
    color: #666;
}
.stats-card .stat-divider {
    background: #E0E0E0;
}
.stats-card::before {
    background: rgba(0, 0, 0, 0.03); /* Subtle dark circle instead of white */
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 快捷功能区 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 48rpx;
}

.grid-row {
  display: grid; 
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  width: 100%;
}

.quick-actions.five {
  display: flex;
  justify-content: space-between;
}

.quick-actions.five .action-item {
  flex: 1;
  margin: 0 6rpx;
}

.action-item {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.action-item:active {
  transform: scale(0.96);
  box-shadow: none;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx; /* Squircle */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}

/* 图标光泽效果 */
.action-icon::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 100%);
}

.icon-text {
  font-size: 40rpx;
}

.action-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  text-align: center;
}

/* 区块 */
.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.section-more {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

/* 需求卡片（教师端） */
.demand-card {
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.demand-card:active {
  transform: scale(0.99);
  border-color: var(--primary-light);
}

.demand-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.demand-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.demand-price {
  font-size: 32rpx;
  color: var(--secondary);
  font-weight: 700;
}

.demand-sub {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.demand-address {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: flex;
  align-items: center;
}

.demand-address::before {
  content: '📍';
  margin-right: 6rpx;
  font-size: 24rpx;
}

.demand-mode {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-fade);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-left: 20rpx;
  font-weight: 600;
}

/* 需求卡片（家长端简版） */
.demand-card-simple {
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.demand-info {
  display: flex;
  flex-direction: column;
}

.demand-time {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

.demand-status {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-weight: 600;
}

.demand-status.active {
  background: rgba(41, 121, 255, 0.1);
  color: var(--info);
}

.demand-status.matched {
  background: rgba(0, 191, 165, 0.1);
  color: var(--success);
}

/* 订单卡片 */
.order-card {
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.order-info {
  display: flex;
  flex-direction: column;
}

.order-subject {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.order-progress {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.order-btn {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  background: var(--primary-fade);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-placeholder);
  font-size: 28rpx;
  background: rgba(255,255,255,0.5);
  border-radius: var(--radius-lg);
  border: 2rpx dashed var(--border);
}
