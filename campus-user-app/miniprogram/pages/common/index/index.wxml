<!-- 首页（根据角色显示不同内容） - index.wxml -->

<!-- 教师端视图 -->
<block wx:if="{{userInfo.role === 1}}">
  <view class="container">
    <!-- 顶部欢迎区域 -->
    <view class="header">
      <view class="welcome">
        <text class="greeting">Hello, {{userInfo.nickname || '老师'}} <text style="font-size:48rpx">👋</text></text>
        <text class="subtitle">新的机会正在等着你</text>
      </view>
    </view>

    <!-- 数据统计卡片 -->
    <view class="stats-card">
      <view class="stat-item">
        <text class="stat-value">{{stats.orderCount || 0}}</text>
        <text class="stat-label">完成订单</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.rating || '5.0'}}</text>
        <text class="stat-label">综合评分</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="goToIncome">
        <text class="stat-value">¥{{walletInfo.balance || '0'}}</text>
        <text class="stat-label">账户余额</text>
      </view>
    </view>

    <!-- 快捷功能区 -->
    <view class="section">
      <view class="quick-actions five">
        <view class="action-item" bindtap="goToStudentList">
            <view class="action-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%)">
              <text class="icon-text">🎒</text>
            </view>
            <text class="action-title">招学生</text>
          </view>
        <view class="action-item" bindtap="goToTeacherOrders">
          <view class="action-icon" style="background: linear-gradient(135deg, #fa8c16 0%, #ffc53d 100%)">
            <text class="icon-text">📚</text>
          </view>
          <text class="action-title">我的订单</text>
        </view>
        <view class="action-item" bindtap="goToTeacherLessons">
          <view class="action-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)">
            <text class="icon-text">📖</text>
          </view>
          <text class="action-title">课时记录</text>
        </view>
        <view class="action-item" bindtap="goToCertification">
          <view class="action-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%)">
            <text class="icon-text">📜</text>
          </view>
          <text class="action-title">我的认证</text>
        </view>
        <view class="action-item" bindtap="goToIncome">
          <view class="action-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)">
            <text class="icon-text">💰</text>
          </view>
          <text class="action-title">收入明细</text>
        </view>
      </view>
    </view>

    <!-- 附近需求 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">附近的家教需求</text>
        <text class="section-more" bindtap="goToMap">查看地图 ></text>
      </view>
      <view class="demand-list" wx:if="{{nearbyDemands.length > 0}}">
        <block wx:for="{{nearbyDemands}}" wx:key="id">
          <view class="demand-card">
            <view class="demand-main">
              <text class="demand-title">{{item.subject}} - {{item.grade}}</text>
              <text class="demand-price">¥{{item.expectPrice}}/小时</text>
            </view>
            <view class="demand-sub">
              <text class="demand-address">{{item.address || '位置未知'}}</text>
              <text class="demand-mode">{{item.teachMode === 1 ? '上门' : item.teachMode === 2 ? '网课' : '均可'}}</text>
            </view>
          </view>
        </block>
      </view>
      <view class="empty-tip" wx:else>
        <text>暂无附近需求，点击上方查看地图</text>
      </view>
    </view>
  </view>
</block>

<!-- 家长端视图 -->
<block wx:else>
  <view class="container">
    <!-- 顶部欢迎区域 -->
    <view class="header">
      <view class="welcome">
        <text class="greeting">Hello, {{userInfo.nickname || '家长'}} <text style="font-size:48rpx">👋</text></text>
        <text class="subtitle">为孩子找到最适合的家教</text>
      </view>
    </view>

    <!-- 快捷功能区 -->
    <view class="section">
      <view class="quick-actions">
        <view class="grid-row">
          <view class="action-item" bindtap="goToPublish">
            <view class="action-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%)">
              <text class="icon-text">📝</text>
            </view>
            <text class="action-title">发布需求</text>
          </view>
          <view class="action-item" bindtap="goToParentOrders">
            <view class="action-icon" style="background: linear-gradient(135deg, #fa8c16 0%, #ffc53d 100%)">
              <text class="icon-text">📚</text>
            </view>
            <text class="action-title">我的订单</text>
          </view>
          <view class="action-item" bindtap="goToParentLessons">
            <view class="action-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)">
              <text class="icon-text">📖</text>
            </view>
            <text class="action-title">课时记录</text>
          </view>
          <view class="action-item" bindtap="goToMyDemands">
            <view class="action-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%)">
              <text class="icon-text">📋</text>
            </view>
            <text class="action-title">我的需求</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 最近需求 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">我的需求</text>
        <text class="section-more" bindtap="goToMyDemands">查看全部 ></text>
      </view>
      <view class="demand-list" wx:if="{{demandList.length > 0}}">
        <block wx:for="{{demandList}}" wx:key="id">
          <view class="demand-card-simple">
            <view class="demand-info">
              <text class="demand-title">{{item.subject}} - {{item.grade}}</text>
              <text class="demand-time">{{item.createTime}}</text>
            </view>
            <view class="demand-status {{item.status === 2 ? 'matched' : 'active'}}">
              {{item.status === 2 ? '已匹配' : item.status === 1 ? '寻找中' : '已下架'}}
            </view>
          </view>
        </block>
      </view>
      <view class="empty-tip" wx:else>
        <text>暂无需求，点击上方发布</text>
      </view>
    </view>

    <!-- 最近订单 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">进行中的订单</text>
        <text class="section-more" bindtap="goToParentOrders">查看全部 ></text>
      </view>
      <view class="order-list" wx:if="{{orderList.length > 0}}">
        <block wx:for="{{orderList}}" wx:key="id">
          <view class="order-card">
            <view class="order-info">
              <text class="order-subject">{{item.subject}}</text>
              <text class="order-progress">已上 {{item.usedHours}}/{{item.totalHours}} 课时</text>
            </view>
            <view class="order-action">
              <text class="order-btn">查看</text>
            </view>
          </view>
        </block>
      </view>
      <view class="empty-tip" wx:else>
        <text>暂无进行中的订单</text>
      </view>
    </view>
  </view>
</block>

<!-- AI智能助手 -->
<ai-assistant></ai-assistant>

