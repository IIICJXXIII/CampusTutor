/* 注册页面样式 - register.wxss */
page {
  background-color: var(--bg-body);
}

.container {
  padding: 40rpx;
  min-height: 100vh;
}

.header {
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 2rpx;
}

/* 角色选择器样式 */
.role-selector {
  display: flex;
  justify-content: space-between;
  margin-bottom: 60rpx;
}

.role-item {
  width: 46%;
  height: 200rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 4rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

.role-item::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, transparent 50%, rgba(108, 99, 255, 0.1) 50%);
  border-top-right-radius: var(--radius-lg);
}

.role-item.active {
  background: #fff;
  border-color: var(--primary);
  box-shadow: 0 8rpx 24rpx rgba(108, 99, 255, 0.2);
  transform: translateY(-4rpx);
}

.role-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  transition: color 0.3s;
}

.role-item.active .role-name {
  color: var(--primary);
}

.role-desc {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* 表单样式 */
.form-box {
  width: 100%;
}

.input-group {
  margin-bottom: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 12rpx 32rpx;
  transition: all 0.3s;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
}

.input-group:focus-within {
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(108, 99, 255, 0.1);
  background: #fff;
}

.input-group.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: var(--text-main);
}

.code-btn {
  font-size: 28rpx;
  color: var(--primary);
  padding: 10rpx 0;
  min-width: 160rpx;
  text-align: right;
  font-weight: 600;
}

.code-btn.disabled {
  color: var(--text-placeholder);
}

.submit-btn {
  margin-top: 80rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: var(--shadow-primary);
  letter-spacing: 2rpx;
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.footer-actions {
  margin-top: 48rpx;
  text-align: center;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.text {
  color: var(--text-secondary);
}

.link {
  color: var(--primary);
  margin-left: 12rpx;
  font-weight: 700;
}