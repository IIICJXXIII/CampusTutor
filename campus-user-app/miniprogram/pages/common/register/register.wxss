/* pages/common/register/register.wxss */
.container {
  padding: 60rpx 40rpx;
  background-color: #fff;
  min-height: 100vh;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 角色选择切换器 */
.role-selector {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 50rpx;
}

.role-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.role-item.active {
  background-color: #fff;
  color: #0052D9; /* 品牌蓝 */
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 表单区域 */
.form-box {
  width: 100%;
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.input {
  width: 100%;
  height: 90rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 0 30rpx;
  box-sizing: border-box; /* 关键：防止padding撑大宽度 */
  font-size: 30rpx;
  color: #333;
}

.btn-register {
  background-color: #0052D9;
  color: #fff;
  border-radius: 45rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
  margin-top: 60rpx;
  font-weight: 500;
  width: 100% !important; /* 覆盖默认样式 */
}

.login-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.link-text {
  color: #0052D9;
  margin-left: 10rpx;
}