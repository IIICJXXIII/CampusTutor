<view class="container">
  <view class="header">
    <text class="title">创建账号</text>
    <text class="subtitle">请填写信息以完成注册</text>
  </view>

  <view class="role-selector">
    <view class="role-item {{role === 'PARENT' ? 'active' : ''}}" bindtap="switchRole" data-role="PARENT">我是家长</view>
    <view class="role-item {{role === 'TEACHER' ? 'active' : ''}}" bindtap="switchRole" data-role="TEACHER">我是教师</view>
  </view>

  <view class="form-box">
    <view class="input-group">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入11位手机号" maxlength="11" model:value="{{phone}}" />
    </view>

    <view class="input-group">
      <text class="label">设置密码</text>
      <input class="input" type="password" placeholder="6-20位字母或数字" model:value="{{password}}" />
    </view>

    <view class="input-group">
      <text class="label">确认密码</text>
      <input class="input" type="password" placeholder="再次输入密码" model:value="{{confirmPassword}}" />
    </view>

    <button class="btn-register" bindtap="handleRegister">立即注册</button>

    <view class="login-link">
      <text>已有账号？</text>
      <text class="link-text" bindtap="goToLogin">去登录</text>
    </view>
  </view>
</view>