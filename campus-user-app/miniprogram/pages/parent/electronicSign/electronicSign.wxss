/* 家长端 - 电子签约页样式 (简约专业风) */
page {
  background: #F0F2F5;
  --prof-primary: #1E6F9F;
  --prof-text-main: #2D3748;
  --prof-text-sub: #8C8177;
  --prof-border: #E2E8F0;
  --paper-bg: #FFFFFA;
}

.container {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.header-section {
  text-align: center;
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
  font-family: monospace;
}

/* 仿纸质合同 */
.contract-paper {
  flex: 1;
  background: var(--paper-bg);
  border-radius: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08); /* Paper shadow */
  padding: 40rpx;
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
  border: 1rpx solid #E6E6E6;
}

/* 纸张纹理 */
.contract-paper::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: linear-gradient(#eee .1em, transparent .1em);
  background-size: 100% 2em;
  opacity: 0.1;
  pointer-events: none;
}

.contract-content {
  height: 100%;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 16rpx;
}

.section-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
  text-align: justify;
}

.section-text text {
  display: block;
  margin-bottom: 8rpx;
}

.signature-area {
  margin-top: 60rpx;
  display: flex;
  justify-content: space-between;
  padding-top: 40rpx;
  border-top: 2rpx dashed #ccc;
}

.sign-box {
  display: flex;
  flex-direction: column;
  font-size: 26rpx;
  color: #333;
}

.sign-box.right {
  align-items: flex-end;
}

.sign-name {
  font-family: cursive, 'KaiTi', serif; /* Handwriting font fallback */
  font-size: 40rpx;
  margin: 16rpx 0;
  color: #333;
  border-bottom: 1rpx solid #333;
  padding: 0 20rpx;
  min-width: 120rpx;
  text-align: center;
}

.sign-date {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作区 */
.footer-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.agreement-check {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.checkbox-label {
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox-label checkbox {
  transform: scale(0.8);
  margin-right: 8rpx;
}

.btn-sign {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--prof-primary); /* Deep Blue */
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 8rpx;
  border: none;
}

.btn-sign:active {
  background: #165b85;
}

.btn-sign[disabled] {
  background: #CFD8DC;
  color: #fff;
}

.btn-sign.signed {
  background: #909399; /* Grey */
  color: #fff;
}
