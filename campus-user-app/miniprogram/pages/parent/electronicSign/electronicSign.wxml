<!-- 家长端 - 电子签约页 -->
<view class="container">
  <!-- 顶部标题区 -->
  <view class="header-section">
    <text class="page-title">家教服务电子合同</text>
    <text class="order-no">订单编号：{{orderNo || 'ORD-20230520-XXXX'}}</text>
  </view>

  <!-- 合同内容区（仿纸质感） -->
  <view class="contract-paper">
    <scroll-view scroll-y class="contract-content">
      <view class="section">
        <text class="section-title">一、服务内容</text>
        <view class="section-text">
          <text>1. 甲方（家长）聘请乙方（教员）担任家教老师。</text>
          <text>2. 辅导科目：{{subject || '数学'}}</text>
          <text>3. 辅导年级：{{grade || '高一'}}</text>
          <text>4. 授课方式：{{teachMode === 1 ? '线下上门' : '在线授课'}}</text>
        </view>
      </view>

      <view class="section">
        <text class="section-title">二、课时安排与费用</text>
        <view class="section-text">
          <text>1. 课时单价：{{unitPrice || '0'}} 元/小时</text>
          <text>2. 预计总课时：{{totalHours || '0'}} 课时</text>
          <text>3. 订单总额：{{totalAmount || '0.00'}} 元</text>
        </view>
      </view>

      <view class="section">
        <text class="section-title">三、双方权利义务</text>
        <view class="section-text">
          <text>1. 乙方应按时授课，认真备课，保证教学质量。</text>
          <text>2. 甲方应按时支付费用，并为乙方提供必要的教学便利。</text>
          <text>3. 因特殊情况需调整上课时间，需提前 24 小时沟通。</text>
          <text>4. 双方应互相尊重，保持良好的沟通。</text>
        </view>
      </view>

      <view class="section">
        <text class="section-title">四、违约责任</text>
        <view class="section-text">
          <text>1. 任何一方违反本合同约定，应承担相应的违约责任。</text>
          <text>2. 如遇不可抗力因素，双方可协商解决。</text>
        </view>
      </view>
      
      <view class="signature-area">
        <view class="sign-box left">
          <text>甲方（家长）</text>
          <text class="sign-name">{{parentName || '李家长'}}</text>
          <text class="sign-date">{{currentDate}}</text>
        </view>
        <view class="sign-box right">
          <text>乙方（教员）</text>
          <text class="sign-name">{{tutorName || '张老师'}}</text>
          <text class="sign-date">{{currentDate}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部操作区 -->
  <view class="footer-action">
    <view class="agreement-check">
      <checkbox-group bindchange="handleAgreementChange">
        <label class="checkbox-label">
          <checkbox value="agreed" checked="{{isAgreed}}" color="#1E6F9F"/>
          <text>我已阅读并同意以上合同条款</text>
        </label>
      </checkbox-group>
    </view>
    
    <button class="btn-sign {{isSigned ? 'signed' : ''}}" 
            bindtap="handleSign" 
            disabled="{{!isAgreed || isSigned}}">
      {{isSigned ? '已完成签约' : '同意并电子签约'}}
    </button>
  </view>
</view>
