/* 教师详情页样式 - 温馨亲和风 */
page {
  background-color: var(--bg-body);
}

/* 顶部背景 - Warm Gradient */
.header-bg {
  height: 240rpx;
  background: linear-gradient(135deg, #FFF0E6 0%, #FFE0B2 100%); /* Soft Orange Gradient */
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

/* 卡片通用样式 */
.profile-card, .section-card {
  background: #fff;
  border-radius: var(--radius-lg);
  margin: 0 32rpx 32rpx;
  padding: 36rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.profile-card {
  margin-top: -140rpx; /* 上移覆盖背景 */
  position: relative;
  z-index: 10;
}

/* 个人信息区 */
.main-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  margin-right: 28rpx;
  background-color: #eee;
  box-shadow: 0 4rpx 12rpx rgba(139, 90, 43, 0.1);
}

.content {
  flex: 1;
}

.row-1 {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.cert-badge {
  font-size: 20rpx;
  color: #fff;
  background: var(--success); /* Soft Green */
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}

.row-2 {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.divider {
  margin: 0 12rpx;
  color: #E8E0D9;
}

/* 数据统计 */
.stats-box {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx dashed #E8E0D9;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item .num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.stat-item .num.score {
  color: #FFA000; /* Warm Amber */
}

.stat-item .label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 详情板块 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--primary); /* Caramel Bar */
  line-height: 1;
  color: var(--text-main);
}

.info-row {
  display: flex;
  margin-bottom: 24rpx;
}

.info-row .label {
  width: 140rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  font-weight: 500;
}

.tags-wrapper {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.tag.blue {
  background: rgba(139, 90, 43, 0.08); /* Caramel Fade */
  color: var(--primary);
}

.tag.green {
  background: rgba(102, 187, 106, 0.1); 
  color: var(--success);
}

.text-content {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.5;
}

/* 简介 */
.intro-content {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.7;
  text-align: justify;
  margin-bottom: 24rpx;
}

.style-box {
  background: var(--bg-body); /* Warm bg */
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--primary);
  border: 1rpx solid rgba(139, 90, 43, 0.1);
}

/* 证书 */
.cert-scroll {
  display: flex;
  height: 200rpx;
}

.cert-img {
  height: 100%;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background-color: var(--bg-body);
}

/* 底部栏 */
.footer-placeholder {
  height: 140rpx;
}

.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  box-shadow: 0 -4rpx 16rpx rgba(139, 90, 43, 0.05);
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.price-section {
  color: var(--danger); /* Soft Red */
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 30rpx;
  font-weight: bold;
}

.amount {
  font-size: 50rpx;
  font-weight: 800;
  margin: 0 4rpx;
}

.unit {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.contact-btn {
  margin: 0;
  margin-right: 20rpx;
  background: var(--secondary); /* Soft Orange Pink */
  color: var(--primary);
  font-size: 28rpx;
  border-radius: 44rpx;
  padding: 0 36rpx;
  height: 84rpx;
  line-height: 84rpx;
  border: none;
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

.book-btn {
  margin: 0;
  background: var(--primary); /* Caramel Brown */
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 0 54rpx;
  height: 84rpx;
  line-height: 84rpx;
  box-shadow: var(--shadow-primary);
}

/* Loading */
.loading-container {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}
.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid var(--primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 课表预约 */
.schedule-section .section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.schedule-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: normal;
}

.schedule-scroll {
  max-height: 500rpx;
  margin-bottom: 20rpx;
}

.schedule-grid {
  min-width: 600rpx;
}

.grid-header {
  display: flex;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border);
}

.header-cell {
  flex: 1;
  min-width: 60rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
}

.header-cell.corner {
  min-width: 80rpx;
  flex: none;
  color: var(--text-secondary);
}

.grid-row {
  display: flex;
  margin-top: 10rpx;
}

.time-cell {
  min-width: 80rpx;
  flex: none;
  font-size: 22rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
}

.schedule-cell {
  flex: 1;
  min-width: 60rpx;
  height: 54rpx;
  margin: 4rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  transition: all 0.2s ease;
  background: var(--bg-body);
}

.schedule-cell.available {
  background: rgba(102, 187, 106, 0.1); /* Very soft green */
  color: var(--success);
  border: 1rpx solid rgba(102, 187, 106, 0.2);
}

.schedule-cell.selected {
  background: var(--primary); /* Caramel */
  color: #fff;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(139, 90, 43, 0.3);
}

.schedule-cell.unavailable {
  background: #F0F2F5;
  color: #DDD;
}

.schedule-cell:active {
  transform: scale(0.95);
}

.no-schedule {
  text-align: center;
  padding: 40rpx;
  color: var(--text-placeholder);
  font-size: 28rpx;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.legend-dot.available {
  background: rgba(102, 187, 106, 0.15);
  border: 1rpx solid var(--success);
}

.legend-dot.selected {
  background: var(--primary);
  border: none;
}

.legend-dot.unavailable {
  background: #F0F2F5;
  border: 1rpx solid #ddd;
}