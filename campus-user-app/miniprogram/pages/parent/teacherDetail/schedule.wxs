// 教师详情页课表辅助模块
// WXS 用于在 WXML 中进行数据处理

/**
 * 判断时段是否可用
 * @param scheduleData - 二维数组 [slotIdx][dayIdx] = true/false
 * @param slotIdx - 时段索引
 * @param dayIdx - 星期索引
 */
function isSlotAvailable(scheduleData, slotIdx, dayIdx) {
  if (!scheduleData || !scheduleData[slotIdx]) {
    return false;
  }
  return !!scheduleData[slotIdx][dayIdx];
}

/**
 * 判断时段是否被选中
 * @param bookingData - 二维数组 [slotIdx][dayIdx] = true/false
 * @param slotIdx - 时段索引
 * @param dayIdx - 星期索引
 */
function isSlotBooked(bookingData, slotIdx, dayIdx) {
  if (!bookingData || !bookingData[slotIdx]) {
    return false;
  }
  return !!bookingData[slotIdx][dayIdx];
}

/**
 * 获取单元格样式类名
 * @param scheduleData - 可用时段数据
 * @param bookingData - 选中时段数据
 * @param slotIdx - 时段索引
 * @param dayIdx - 星期索引
 */
function getCellClass(scheduleData, bookingData, slotIdx, dayIdx) {
  if (isSlotBooked(bookingData, slotIdx, dayIdx)) {
    return 'selected';
  }
  if (isSlotAvailable(scheduleData, slotIdx, dayIdx)) {
    return 'available';
  }
  return 'unavailable';
}

module.exports = {
  isSlotAvailable: isSlotAvailable,
  isSlotBooked: isSlotBooked,
  getCellClass: getCellClass
};
