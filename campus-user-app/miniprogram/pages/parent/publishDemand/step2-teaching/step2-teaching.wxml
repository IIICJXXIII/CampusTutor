<view class="container">
  <view class="step-header">
    <view class="step-item finished">
      <view class="step-num">✓</view>
      <text>学生信息</text>
    </view>
    <view class="step-line active"></view>
    <view class="step-item active">
      <view class="step-num">2</view>
      <text>教学目标</text>
    </view>
    <view class="step-line"></view>
    <view class="step-item">
      <view class="step-num">3</view>
      <text>提交需求</text>
    </view>
  </view>

  <view class="form-box">
    <view class="header-tip">
      <text class="h1">明确辅导需求</text>
      <text class="p">合理的预算和时间安排能更快匹配到老师</text>
    </view>

    <view class="input-group">
      <view class="label">辅导科目</view>
      <picker bindchange="handleSubjectChange" value="{{subjectIndex}}" range="{{subjects}}">
        <view class="picker {{subjectIndex === -1 ? 'placeholder' : ''}}">
          {{subjectIndex === -1 ? '请选择科目' : subjects[subjectIndex]}}
        </view>
      </picker>
    </view>

    <view class="input-group">
      <view class="label">授课方式</view>
      <view class="radio-group">
        <view class="radio-item {{formData.teachMode === 1 ? 'active' : ''}}" bindtap="selectMode" data-val="1">上门授课 🏠</view>
        <view class="radio-item {{formData.teachMode === 2 ? 'active' : ''}}" bindtap="selectMode" data-val="2">在线授课 💻</view>
      </view>
    </view>

    <view class="input-group">
      <view class="label">期望课酬 (元/小时)</view>
      <input class="input" type="number" placeholder="例如：100" bindinput="handleInput" data-field="expectPrice" value="{{formData.expectPrice}}" />
      <view class="suffix">元/小时</view>
    </view>
    <view class="tip-text">参考价：大学生 80-150元，专职教师 200元起</view>

    <view class="input-group vertical">
      <view class="label">期望上课时间 (可多选)</view>
      <view class="tag-container">
        <block wx:for="{{timeSlots}}" wx:key="*this">
          <view class="tag {{item.selected ? 'selected' : ''}}" bindtap="toggleTime" data-index="{{index}}">
            {{item.name}}
          </view>
        </block>
      </view>
    </view>

    <view class="input-group vertical">
      <view class="label">详细要求 (选填)</view>
      <textarea class="textarea" placeholder="例如：希望老师有耐心，侧重讲解几何部分，每周2次..." bindinput="handleInput" data-field="detail" value="{{formData.detail}}" maxlength="200"></textarea>
    </view>
  </view>

  <view class="btn-group">
    <button class="action-btn outline" bindtap="prevStep">上一步</button>
    <button class="action-btn primary" bindtap="nextStep">下一步</button>
  </view>
</view>