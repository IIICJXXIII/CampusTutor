/* 继承或复用 Step 1 的基础样式 */
.container {
  padding-bottom: 120rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

/* 步骤条复用 step1 的 wxss，此处省略重复部分 */
.step-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  background: #fff;
  margin-bottom: 20rpx;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}
.step-item.active { color: #409EFF; }
.step-item.finished { color: #409EFF; } /* 完成态 */
.step-num {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #eee; color: #666;
  text-align: center; line-height: 40rpx; margin-bottom: 8rpx;
}
.step-item.active .step-num, .step-item.finished .step-num {
  background: #409EFF; color: #fff;
}
.step-line {
  width: 60rpx; height: 2rpx; background: #eee; margin: -30rpx 20rpx 0;
}
.step-line.active { background: #409EFF; }

/* 内容区 */
.form-box {
  background: #fff;
  padding: 0 30rpx 30rpx;
}
.header-tip { padding: 30rpx 0; }
.h1 { font-size: 40rpx; font-weight: bold; display: block; margin-bottom: 10rpx; }
.p { font-size: 26rpx; color: #999; }

.input-group {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: center;
}
.input-group.vertical { display: block; }
.label { width: 180rpx; font-size: 30rpx; color: #333; font-weight: 500; }
.vertical .label { margin-bottom: 20rpx; display: block; width: 100%; }
.input, .picker { flex: 1; font-size: 30rpx; color: #333; }
.suffix { font-size: 28rpx; color: #666; margin-left: 20rpx; }
.tip-text { font-size: 24rpx; color: #ff9900; margin-top: 10rpx; background: #fffbf0; padding: 10rpx; border-radius: 8rpx; display: inline-block; }

/* 单选组 */
.radio-group { display: flex; flex: 1; }
.radio-item {
  margin-right: 30rpx; padding: 10rpx 30rpx;
  background: #f5f7fa; border-radius: 30rpx;
  font-size: 28rpx; color: #666; border: 1px solid transparent;
}
.radio-item.active { background: #ecf5ff; color: #409EFF; border-color: #409EFF; }

/* 标签 */
.tag-container { display: flex; flex-wrap: wrap; }
.tag {
  padding: 12rpx 24rpx; background: #f5f5f5; border-radius: 8rpx;
  font-size: 26rpx; color: #666; margin-right: 20rpx; margin-bottom: 20rpx;
}
.tag.selected { background: #409EFF; color: #fff; }

.textarea {
  width: 100%; height: 160rpx; background: #f9f9f9;
  border-radius: 12rpx; padding: 20rpx; box-sizing: border-box; font-size: 28rpx;
}

/* 底部按钮组 */
.btn-group {
  display: flex; justify-content: space-between; margin-top: 60rpx; padding: 0 30rpx;
}
.action-btn {
  width: 45%; height: 88rpx; line-height: 88rpx;
  border-radius: 44rpx; font-size: 32rpx;
}
.action-btn.outline {
  background: #fff; color: #666; border: 1rpx solid #ddd;
}
.action-btn.primary {
  background: #409EFF; color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(64, 158, 255, 0.3);
}