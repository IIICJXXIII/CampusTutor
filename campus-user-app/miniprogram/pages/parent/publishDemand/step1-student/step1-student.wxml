<view class="container">
  <view class="header-tips">请先确认上课学生信息</view>

  <view wx:if="{{!isAdding && studentList.length > 0}}" class="select-mode">
    <view class="list-box">
      <block wx:for="{{studentList}}" wx:key="id">
        <view class="student-card {{selectedId === item.id ? 'active' : ''}}" bindtap="selectStudent" data-id="{{item.id}}">
          <view class="card-left">
            <text class="name">{{item.studentName}}</text>
            <text class="tag">{{item.grade}}</text>
            <text class="tag">{{item.gender === 1 ? '男' : '女'}}</text>
          </view>
          <view class="check-icon" wx:if="{{selectedId === item.id}}">✓</view>
        </view>
      </block>
    </view>

    <view class="action-row">
      <view class="add-link" bindtap="toggleMode">+ 添加新学生</view>
    </view>
    
    <button class="next-btn" bindtap="handleNext" disabled="{{!selectedId}}">下一步</button>
  </view>

  <view wx:else class="form-mode">
    <view class="form-group">
      <view class="label">学生姓名</view>
      <input class="input" placeholder="请输入姓名" bindinput="handleInput" data-field="studentName" value="{{form.studentName}}"/>
    </view>

    <view class="form-group">
      <view class="label">性别</view>
      <view class="radio-group">
        <view class="radio {{form.gender === 1 ? 'active' : ''}}" bindtap="setGender" data-val="1">男</view>
        <view class="radio {{form.gender === 2 ? 'active' : ''}}" bindtap="setGender" data-val="2">女</view>
      </view>
    </view>

    <view class="form-group">
      <view class="label">年龄段</view>
      <picker bindchange="handleGradeChange" value="{{gradeIndex}}" range="{{grades}}">
        <view class="picker-val {{!form.grade ? 'placeholder' : ''}}">
          {{form.grade || '请选择年龄段'}}
        </view>
      </picker>
    </view>

    <view class="form-group">
      <view class="label">所在学校 (选填)</view>
      <input class="input" placeholder="请输入学校名称" bindinput="handleInput" data-field="schoolName" value="{{form.schoolName}}"/>
    </view>

    <view class="form-group vertical">
      <view class="label">学习情况 / 期望</view>
      <textarea class="textarea" placeholder="例如：零基础，对积木拼搭感兴趣..." bindinput="handleInput" data-field="studyDesc" value="{{form.studyDesc}}"></textarea>
    </view>

    <view class="btn-row">
      <button class="btn plain" bindtap="toggleMode" wx:if="{{studentList.length > 0}}">取消</button>
      <button class="btn primary" bindtap="saveAndNext">保存并下一步</button>
    </view>
  </view>
</view>