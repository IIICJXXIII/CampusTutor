/* 复用之前的步骤条样式，或者单独定义 */
.container {
  padding-bottom: 120rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.step-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  background: #fff;
  margin-bottom: 20rpx;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}
.step-item.active {
  color: #409EFF;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eee;
  color: #666;
  text-align: center;
  line-height: 40rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}
.step-item.active .step-num {
  background: #409EFF;
  color: #fff;
}
.step-line {
  width: 60rpx;
  height: 2rpx;
  background: #eee;
  margin: -30rpx 20rpx 0;
}

/* 头部提示 */
.header-tip {
  padding: 30rpx;
}
.header-tip .h1 {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}
.header-tip .p {
  font-size: 26rpx;
  color: #999;
}

/* 表单区域 */
.form-box {
  background: #fff;
  padding: 0 30rpx 30rpx;
  margin-top: 20rpx;
}

.input-group {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: center;
}
.input-group.vertical {
  display: block;
}

.label {
  width: 180rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.vertical .label {
  margin-bottom: 20rpx;
  display: block;
  width: 100%;
}

.input, .picker {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.placeholder {
  color: #ccc;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  flex: 1;
}
.radio-item {
  margin-right: 30rpx;
  padding: 10rpx 30rpx;
  background: #f5f7fa;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  border: 1px solid transparent;
}
.radio-item.active {
  background: #ecf5ff;
  color: #409EFF;
  border-color: #409EFF;
}

/* 标签云 */
.tag-container {
  display: flex;
  flex-wrap: wrap;
}
.tag {
  padding: 12rpx 30rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s;
}
.tag.selected {
  background: #409EFF;
  color: #fff;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.next-btn {
  margin: 60rpx 30rpx;
  background: #409EFF;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(64, 158, 255, 0.3);
}