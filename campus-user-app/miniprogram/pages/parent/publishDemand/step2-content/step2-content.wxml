<view class="container">
  
  <view class="form-box">
    <view class="input-group">
      <view class="label">需求标题</view>
      <input class="input" placeholder="例：寻找科创启蒙教练" bindinput="handleInput" data-field="title" value="{{form.title}}"/>
    </view>

    <view class="input-group">
      <view class="label">素质科目</view>
      <picker mode="multiSelector" bindchange="handleSubjectChange" bindcolumnchange="handleSubjectColumnChange" value="{{selectedCategoryIndex}}" range="{{subjectCategories}}">
        <view class="picker-val {{!form.subject ? 'placeholder' : ''}}">
          {{form.subject || '请选择科目分类'}}
        </view>
      </picker>
    </view>

    <view class="input-group">
      <view class="label">基础水平</view>
      <picker bindchange="handleSkillLevelChange" range="{{skillLevels}}">
        <view class="picker-val {{!form.skillLevel ? 'placeholder' : ''}}">
          {{form.skillLevel || '请选择基础水平'}}
        </view>
      </picker>
    </view>

    <view class="input-group">
      <view class="label">场地要求</view>
      <picker bindchange="handleVenueTypeChange" range="{{venueTypes}}">
        <view class="picker-val {{!form.venueType ? 'placeholder' : ''}}">
          {{form.venueType || '请选择场地要求'}}
        </view>
      </picker>
    </view>

    <view class="input-group">
      <view class="label">期望薪资</view>
      <input class="input" type="number" placeholder="0" bindinput="handleInput" data-field="expectPrice" value="{{form.expectPrice}}"/>
      <text class="suffix">元/小时</text>
    </view>

    <view class="input-group">
      <view class="label">授课方式</view>
      <view class="tags-row">
        <view class="tag {{form.teachMode === 1 ? 'active' : ''}}" bindtap="setTeachMode" data-val="1">上门</view>
        <view class="tag {{form.teachMode === 2 ? 'active' : ''}}" bindtap="setTeachMode" data-val="2">在线</view>
        <view class="tag {{form.teachMode === 3 ? 'active' : ''}}" bindtap="setTeachMode" data-val="3">均可</view>
      </view>
    </view>

    <view class="input-group" bindtap="chooseLocation">
      <view class="label">上课地点</view>
      <view class="location-box">
        <view class="addr-text {{!form.address ? 'placeholder' : ''}}">
          {{form.address || '点击选择地图位置'}}
        </view>
        <text class="icon">📍</text>
      </view>
    </view>

    <view class="input-group vertical">
      <view class="label">详细要求</view>
      <textarea class="textarea" placeholder="请输入具体要求，如：每周3次，希望老师有耐心..." bindinput="handleInput" data-field="detail" value="{{form.detail}}"></textarea>
    </view>
  </view>

  <button class="submit-btn" bindtap="submitDemand" loading="{{isSubmitting}}">确认发布</button>
</view>