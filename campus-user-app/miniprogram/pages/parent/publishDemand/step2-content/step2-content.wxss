.container {
  padding: 30rpx;
  background-color: #f6f7f9;
  min-height: 100vh;
}

.form-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
}

.input-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.input-group.vertical {
  display: block;
  border-bottom: none;
}
.input-group:last-child {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: #333;
  width: 160rpx;
}
.input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
}
.picker-val {
  font-size: 30rpx;
  color: #333;
}
.picker-val.placeholder {
  color: #ccc;
}
.suffix {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #999;
}

/* 标签选择 */
.tags-row {
  display: flex;
}
.tag {
  padding: 8rpx 30rpx;
  background: #f5f7fa;
  border-radius: 30rpx;
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #666;
  border: 1px solid transparent;
}
.tag.active {
  background: #ecf5ff;
  color: #409EFF;
  border-color: #409EFF;
}

/* 位置 */
.location-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.addr-text {
  font-size: 28rpx;
  color: #333;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.addr-text.placeholder {
  color: #999;
}
.icon {
  margin-left: 10rpx;
}

/* 文本域 */
.vertical .label {
  margin-bottom: 20rpx;
}
.textarea {
  width: 100%;
  height: 200rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.submit-btn {
  margin-top: 60rpx;
  background: #409EFF;
  color: #fff;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(64, 158, 255, 0.3);
}