/* 家长课时列表样式 - 简约专业风 */
page {
  background: #F8F9FA;
  --prof-primary: #1E6F9F;
  --prof-primary-dark: #165b85;
  --prof-secondary: #E8F8F5;
  --prof-warning: #FF7F50;
  --prof-success-bg: #E8F8F5;
  --prof-card-bg: #FFFFFF;
  --prof-border: #E2E8F0;
  --prof-radius: 12rpx;
}

.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 待处理提醒 */
.pending-tip {
  display: flex;
  align-items: center;
  background: #FFF4E5; /* Light Orange */
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  color: var(--prof-warning);
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid #FFCCBC;
}

.tip-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}

/* 课时卡片 */
.lesson-card {
  background: var(--prof-card-bg);
  border-radius: var(--prof-radius);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05); /* Minimal shadow */
  border: 1rpx solid var(--prof-border);
  transition: all 0.2s ease;
}

.lesson-card:active {
  background-color: #FAFAFA;
}

.lesson-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.lesson-index {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3748;
}

.lesson-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx; /* Sharper tags */
  font-weight: 500;
}

.lesson-status.pending {
  background: #FFF;
  color: var(--prof-warning);
  border: 1rpx solid var(--prof-warning);
}

.lesson-status.confirmed {
  background: var(--prof-secondary);
  color: #1E6F9F;
}

.lesson-status.disputed {
  background: #FFF1F0;
  color: #F5222D;
}

.lesson-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.info-label {
  font-size: 26rpx;
  color: #8C8177;
  flex-shrink: 0;
  width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #2D3748;
  flex: 1;
  text-align: right;
  line-height: 1.4;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.content-text {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #555;
  font-style: normal;
}

/* 操作按钮 */
.lesson-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.btn-confirm {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #1E6F9F 0%, #165b85 100%); /* Deep Blue Gradient */
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 8rpx; /* 4px radius */
  border: none;
  box-shadow: none;
}

.btn-confirm:active {
  background: #165b85;
}

.btn-dispute {
  flex: 1;
  height: 72rpx;
  line-height: 70rpx;
  background: #fff;
  color: #8C8177;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 8rpx;
  border: 1rpx solid #E2E8F0;
}

.btn-dispute:active {
  background: #F8F9FA;
  color: #333;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

/* 申诉弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: none; /* No blur for performance/clean look */
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.dispute-input {
  width: 100%;
  height: 200rpx;
  padding: 16rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  color: #333;
  border: 1rpx solid #E2E8F0;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 8rpx;
  border: none;
}

.modal-btn.cancel {
  background: #F8F9FA;
  color: #666;
}

.modal-btn.confirm {
  background: var(--prof-warning); /* Coral for dispute action */
  color: #fff;
  box-shadow: none;
}
