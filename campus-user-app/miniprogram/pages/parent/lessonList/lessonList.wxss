/* 家长课时列表样式 */
page {
  background: #f8f9fc;
}

.container {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 待处理提醒 */
.pending-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fff7e6 0%, #ffedd5 100%);
  padding: 24rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  color: #d4380d;
  font-size: 28rpx;
  font-weight: 500;
}

.tip-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

/* 课时卡片 */
.lesson-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.lesson-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.lesson-index {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.lesson-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.lesson-status.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.lesson-status.confirmed {
  background: #f0f9eb;
  color: #52c41a;
}

.lesson-status.disputed {
  background: #fff1f0;
  color: #f5222d;
}

.lesson-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
  width: 160rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

.content-text {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 操作按钮 */
.lesson-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f5f5f5;
}

.btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
}

.btn-dispute {
  flex: 1;
  height: 80rpx;
  line-height: 78rpx;
  background: #fff;
  color: #fa8c16;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: 2rpx solid #fa8c16;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

/* 申诉弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.dispute-input {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  background: #f8f9fc;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #fa8c16 0%, #ffa940 100%);
  color: #fff;
}
