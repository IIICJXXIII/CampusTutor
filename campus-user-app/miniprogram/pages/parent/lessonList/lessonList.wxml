<!-- 家长课时列表页面 -->
<view class="container">
  <!-- 待处理提醒 -->
  <view class="pending-tip" wx:if="{{pendingCount > 0}}">
    <text class="tip-icon">⏰</text>
    <text>您有 {{pendingCount}} 节课时待确认</text>
  </view>

  <!-- 课时列表 -->
  <view class="lesson-list" wx:if="{{lessonList.length > 0}}">
    <block wx:for="{{lessonList}}" wx:key="id">
      <view class="lesson-card" bindtap="goToDetail" data-item="{{item}}">
        <view class="lesson-header">
          <text class="lesson-index">第{{item.lessonIndex}}节课</text>
          <view class="lesson-status {{item.status === 1 ? 'confirmed' : item.status === 2 ? 'disputed' : 'pending'}}">
            {{item.statusText || (item.status === 1 ? '已确认' : item.status === 2 ? '申诉中' : '待确认')}}
          </view>
        </view>
        
        <view class="lesson-content">
          <view class="info-row">
            <text class="info-label">上课时间</text>
            <text class="info-value">{{item.startTimeText}}</text>
          </view>
          <view class="info-row" wx:if="{{item.endTime}}">
            <text class="info-label">下课时间</text>
            <text class="info-value">{{item.endTimeText}}</text>
          </view>
          <view class="info-row" wx:if="{{item.contentSummary}}">
            <text class="info-label">教学内容</text>
            <text class="info-value content-text">{{item.contentSummary}}</text>
          </view>
        </view>

        <!-- 待确认状态显示操作按钮 -->
        <view class="lesson-actions" wx:if="{{item.status === 0 && item.endTime}}">
          <button class="btn-confirm" catchtap="handleConfirm" data-id="{{item.id}}">
            确认课时
          </button>
          <button class="btn-dispute" catchtap="showDisputeModal" data-id="{{item.id}}">
            申诉
          </button>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-tip" wx:else>
    <text class="empty-icon">📚</text>
    <text>暂无课时记录</text>
  </view>
</view>

<!-- 申诉弹窗 -->
<view class="modal-mask" wx:if="{{showDispute}}" bindtap="hideDisputeModal">
  <view class="modal-content" catchtap="">
    <view class="modal-title">申诉课时</view>
    <textarea class="dispute-input" placeholder="请填写申诉原因..." 
              bindinput="onDisputeInput" value="{{disputeReason}}" maxlength="200"/>
    <view class="modal-actions">
      <button class="modal-btn cancel" bindtap="hideDisputeModal">取消</button>
      <button class="modal-btn confirm" bindtap="handleDispute" loading="{{isSubmitting}}">提交申诉</button>
    </view>
  </view>
</view>
