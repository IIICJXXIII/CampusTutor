<view class="container">
  <view class="list-box">
    <block wx:for="{{demandList}}" wx:key="id">
      <view class="demand-card">
        <view class="card-header">
          <text class="title">{{item.title}}</text>
          <view class="status-tag" 
                style="color:{{statusMap[item.status].color}}; background:{{statusMap[item.status].bg}}">
            {{statusMap[item.status].text}}
          </view>
        </view>

        <view class="card-body">
          <view class="info-row">
            <text class="label">科目：</text>
            <text class="val">{{item.grade}} {{item.subject}}</text>
          </view>
          <view class="info-row">
            <text class="label">预算：</text>
            <text class="val price">¥{{item.expectPrice}}/小时</text>
          </view>
          <view class="info-row">
            <text class="label">发布：</text>
            <text class="val time">{{item.createTimeStr}}</text>
          </view>
        </view>

        <view class="card-footer">
          <view class="left-info">
            <text wx:if="{{item.teachMode===1}}">上门授课</text>
            <text wx:elif="{{item.teachMode===2}}">在线授课</text>
            <text wx:else>方式不限</text>
          </view>
          
          <view class="btn-group">
            <button class="btn delete" catchtap="handleDelete" data-id="{{item.id}}">删除</button>
            
            <button class="btn action" 
                    wx:if="{{item.status !== 2}}"
                    catchtap="toggleStatus" 
                    data-id="{{item.id}}" 
                    data-status="{{item.status}}">
              {{item.status === 1 ? '关闭需求' : '重新上架'}}
            </button>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && demandList.length === 0}}" class="empty-state">
      <image class="empty-img" src="/static/images/empty.png" wx:if="{{false}}"></image>
      <text>您还没有发布过需求</text>
      <button class="pub-btn" bindtap="goPublish">去发布</button>
    </view>
  </view>

  <view class="float-btn" bindtap="goPublish" wx:if="{{demandList.length > 0}}">
    <text>+</text>
  </view>
</view>