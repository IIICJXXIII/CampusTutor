<view class="container">
  <block wx:if="{{!loading && tutorList.length === 0}}">
      <view class="empty-state" wx:if="{{!fallbackMessage}}">
        <image class="empty-img" src="/static/images/empty.png" wx:if="{{false}}"></image>
        <text>未找到匹配的老师。可能原因：定位/坐标未填写、定位权限被拒，或当前无可见老师。</text>
        <view style="margin-top:16rpx;display:flex;gap:12rpx;justify-content:center;">
          <button class="btn show-rec" bindtap="showSystemRecommend">显示系统推荐</button>
          <button class="btn show-all" bindtap="showAllTeachers">查看全部老师</button>
          <button class="btn diag" bindtap="runVisibilityDiagnostic">诊断可见性</button>
        </view>
      </view>
      <view class="empty-state" wx:elif="{{fallbackMessage}}">
        <text>{{fallbackMessage}}</text>
        <button class="btn refresh" bindtap="refreshList">重新加载</button>
      </view>
    </block>

  <view class="header-placeholder"></view>

  <!-- 排序选择器 -->
  <view class="sort-container">
    <picker bindchange="onSortChange" value="{{activeSort}}" range="{{sortOptions}}" range-key="label">
      <view class="sort-picker">
        <text>排序：{{sortOptions[activeSort].label}}</text>
        <image class="sort-arrow" src="/static/images/arrow-down.png" mode="aspectFit"></image>
      </view>
    </picker>
  </view>

  <view class="list-container">
    <block wx:for="{{tutorList}}" wx:key="id">
      <view class="tutor-card" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="card-left">
          <image class="avatar" src="{{item.avatarUrl || '/static/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="rating-badge" wx:if="{{item.rating}}">⭐ {{item.rating}}</view>
          <!-- 匹配等级徽章 -->
          <view class="match-badge {{item.matchLevel}}" wx:if="{{item.matchScore}}">
            <text wx:if="{{item.matchLevel === 'excellent'}}">✨ 极佳匹配</text>
            <text wx:elif="{{item.matchLevel === 'good'}}">👍 优质匹配</text>
            <text wx:elif="{{item.matchLevel === 'fair'}}">🙂 一般匹配</text>
            <text wx:else>🤔 基础匹配</text>
          </view>
        </view>

        <view class="card-right">
          <view class="row-1">
            <text class="name">{{item.realName}}</text>
            <view class="score-badge" wx:if="{{item.matchScore}}">
              <text class="score-icon">🎯</text>
              <text class="score-value">{{item.matchScore.toFixed(0)}}</text>
              <text class="score-unit">分</text>
            </view>
            <text class="price">¥{{item.expectPrice}}<text class="unit">/小时</text></text>
          </view>

          <view class="row-2">
            <text class="uni">{{item.universityName}}</text>
            <text class="sep">|</text>
            <text class="major">{{item.major}}</text>
            <text class="sep">|</text>
            <text class="edu">{{eduMap[item.education]}}</text>
            <text class="sep" wx:if="{{item.distText}}">|</text>
            <text class="distance" wx:if="{{item.distText}}">📍 {{item.distText}}</text>
          </view>

          <view class="tags-container">
            <view class="tags-row">
              <block wx:for="{{item.teachSubjects}}" wx:key="*this" wx:for-item="sub" wx:if="{{index < 4}}">
                <text class="tag tag-subject">{{sub}}</text>
              </block>
            </view>
            <view class="tags-row">
              <block wx:for="{{item.teachGrades}}" wx:key="*this" wx:for-item="grade" wx:if="{{index < 3}}">
                <text class="tag tag-grade">{{grade}}</text>
              </block>
            </view>
            <!-- 匹配标签 -->
            <view class="tags-row" wx:if="{{item.matchTags && item.matchTags.length > 0}}">
              <block wx:for="{{item.matchTags}}" wx:key="*this" wx:for-item="tag">
                <text class="tag tag-match">{{tag}}</text>
              </block>
            </view>
          </view>

          <view class="intro">{{item.introduction || '暂无简介'}}</view>
          
          <!-- 教学方式标签 -->
          <view class="teach-mode" wx:if="{{item.canVisit || item.canOnline}}">
            <text class="mode-tag" wx:if="{{item.canVisit}}">🏠 可上门</text>
            <text class="mode-tag" wx:if="{{item.canOnline}}">💻 可网课</text>
          </view>
        </view>
      </view>
    </block>

    <view class="loading-more" wx:if="{{loading}}">加载中...</view>
    <view class="no-more" wx:if="{{!loading && !hasMore && tutorList.length > 0}}">—— 到底啦 ——</view>
  </view>
</view>