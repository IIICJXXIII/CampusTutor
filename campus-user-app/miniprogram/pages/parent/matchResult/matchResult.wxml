<view class="container">
  <view class="header-fixed">
    <view class="search-bar">
      <view class="search-input-box">
        <icon type="search" size="16" color="#999"></icon>
        <input class="input" placeholder="搜索科目/姓名" confirm-type="search" bindconfirm="onSearchConfirm" bindinput="onSearchInput" value="{{query.subject}}"/>
      </view>
    </view>

    <view class="filter-bar">
      <picker range="{{subjects}}" bindchange="onSubjectChange" value="{{activeSubject}}">
        <view class="filter-item {{activeSubject>0?'active':''}}">
          {{activeSubject>0 ? subjects[activeSubject] : '科目'}} ▾
        </view>
      </picker>
      
      <picker range="{{grades}}" bindchange="onGradeChange" value="{{activeGrade}}">
        <view class="filter-item {{activeGrade>0?'active':''}}">
          {{activeGrade>0 ? grades[activeGrade] : '年级'}} ▾
        </view>
      </picker>

      <picker range="{{sortOptions}}" range-key="label" bindchange="onSortChange" value="{{activeSort}}">
        <view class="filter-item {{activeSort>0?'active':''}}">
          {{sortOptions[activeSort].label}} ▾
        </view>
      </picker>
    </view>
  </view>

  <view class="header-placeholder"></view>

  <view class="list-container">
    <block wx:for="{{tutorList}}" wx:key="id">
      <view class="tutor-card" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="card-left">
          <image class="avatar" src="{{item.avatarUrl || '/static/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="rating-badge" wx:if="{{item.rating}}">⭐ {{item.rating}}</view>
        </view>

        <view class="card-right">
          <view class="row-1">
            <text class="name">{{item.realName}}</text>
            <text class="price">¥{{item.expectPrice}}<text class="unit">/小时</text></text>
          </view>

          <view class="row-2">
            <text class="uni">{{item.universityName}}</text>
            <text class="sep">|</text>
            <text class="major">{{item.major}}</text>
            <text class="sep">|</text>
            <text class="edu">{{eduMap[item.education]}}</text>
          </view>

          <view class="tags-row">
            <block wx:for="{{item.teachSubjects}}" wx:key="*this" wx:for-item="sub" wx:if="{{index < 3}}">
              <text class="tag">{{sub}}</text>
            </block>
            <text class="distance" wx:if="{{item.distText}}">📍 {{item.distText}}</text>
          </view>

          <view class="intro">{{item.introduction || '暂无简介'}}</view>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && tutorList.length === 0}}" class="empty-state">
      <image class="empty-img" src="/static/images/empty.png" wx:if="{{false}}"></image>
      <text>暂无符合条件的老师，换个条件试试？</text>
    </view>

    <view class="loading-more" wx:if="{{loading}}">加载中...</view>
    <view class="no-more" wx:if="{{!loading && !hasMore && tutorList.length > 0}}">—— 到底啦 ——</view>
  </view>
</view>