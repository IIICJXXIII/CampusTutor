page {
  background-color: #f6f7f9;
}

/* 顶部固定区域 */
.header-fixed {
  position: fixed;
  top: 0; left: 0; right: 0;
  background: #fff;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.header-placeholder {
  height: 88rpx; /* filter(88) only */
}

/* 防止卡片内容溢出 */
.tutor-card { overflow: hidden; }
.intro { white-space: normal; word-break: break-word; }
.tags-row { flex-wrap: wrap; }

/* 确保图片和容器不会导致横向滚动 */
.page-img, image { max-width: 100%; }


/* 搜索已移除：保持顶部区域简洁 */
.btn.show-rec { margin-top: 20rpx; background: #409EFF; color: #fff; padding: 12rpx 24rpx; border-radius: 28rpx; }

/* 筛选条 */
.filter-bar {
  display: flex;
  height: 88rpx;
  align-items: center;
  border-top: 1rpx solid #f5f5f5;
}
.filter-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  height: 88rpx;
  line-height: 88rpx;
}
.filter-item.active {
  color: #409EFF;
  font-weight: bold;
}

/* 列表容器 */
.list-container {
  padding: 20rpx;
}

/* 卡片样式 */
.tutor-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
}

.card-left {
  position: relative;
  margin-right: 24rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #eee;
}
.rating-badge {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #ff9900;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  white-space: nowrap;
}

.card-right {
  flex: 1;
}

.row-1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.price {
  font-size: 32rpx;
  color: #f56c6c;
  font-weight: bold;
}
.unit {
  font-size: 22rpx;
  font-weight: normal;
  color: #999;
}

.row-2 {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.sep {
  margin: 0 8rpx;
  color: #ddd;
}

.tags-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 22rpx;
  color: #409EFF;
  background: #ecf5ff;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}
.tag-match {
  background: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #fae6ce;
}
.score-badge {
  background: #fff2f6;
  color: #ff6b6b;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

/* 状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
.loading-more, .no-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}