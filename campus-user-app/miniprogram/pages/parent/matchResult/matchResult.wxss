page {
  background-color: #f6f7f9;
}

/* 顶部固定区域 */
.header-fixed {
  position: fixed;
  top: 0; left: 0; right: 0;
  background: #fff;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.header-placeholder {
  height: 88rpx; /* filter(88) only */
}

/* 防止卡片内容溢出 */
.tutor-card { overflow: hidden; }
.intro { white-space: normal; word-break: break-word; }
.tags-row { flex-wrap: wrap; }

/* 确保图片和容器不会导致横向滚动 */
.page-img, image { max-width: 100%; }


/* 搜索已移除：保持顶部区域简洁 */
.btn.show-rec { margin-top: 20rpx; background: #409EFF; color: #fff; padding: 12rpx 24rpx; border-radius: 28rpx; }

/* 筛选条 */
.filter-bar {
  display: flex;
  height: 88rpx;
  align-items: center;
  border-top: 1rpx solid #f5f5f5;
}
.filter-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  height: 88rpx;
  line-height: 88rpx;
}
.filter-item.active {
  color: #409EFF;
  font-weight: bold;
}

/* 排序选择器 */
.sort-container {
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f5f5f5;
}

.sort-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  background-color: #f5f7fa;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #303133;
  max-width: 280rpx;
  margin: 0 auto;
}

.sort-arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 10rpx;
}

/* 列表容器 */
.list-container {
  padding: 20rpx;
}

/* 卡片样式 */
.tutor-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.tutor-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.card-left {
  position: relative;
  margin-right: 28rpx;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #f5f7fa;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
.rating-badge {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #ff9900, #ffb74d);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  box-shadow: 0 4rpx 8rpx rgba(255, 153, 0, 0.3);
  font-weight: 500;
}

.card-right {
  flex: 1;
}

.row-1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}
.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #303133;
  flex: 1;
}
.price {
  font-size: 34rpx;
  color: #f56c6c;
  font-weight: bold;
  white-space: nowrap;
}
.unit {
  font-size: 24rpx;
  font-weight: normal;
  color: #c0c4cc;
}

.row-2 {
  font-size: 26rpx;
  color: #606266;
  margin-bottom: 16rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.sep {
  margin: 0 8rpx;
  color: #ddd;
}

.tags-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}
.tag {
  font-size: 24rpx;
  color: #409EFF;
  background: #ecf5ff;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  transition: all 0.2s ease;
  font-weight: 500;
}

.tag:active {
  transform: scale(0.95);
}

.tag-match {
  background: #fff7e6;
  color: #fa8c16;
  border: 2rpx solid #fae6ce;
}

.tag-subject {
  background: #ecf5ff;
  color: #409EFF;
  border: 2rpx solid #d9ecff;
}

.tag-grade {
  background: #f0f9eb;
  color: #67c23a;
  border: 2rpx solid #e1f3d8;
}
.score-badge {
  background: #fff2f6;
  color: #ff6b6b;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  border: 2rpx solid #ffe0e6;
  font-weight: 500;
}
.score-icon {
  font-size: 26rpx;
}
.score-value {
  font-weight: bold;
  font-size: 26rpx;
}
.match-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  color: white;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}
.match-badge.excellent {
  background: linear-gradient(135deg, #67c23a, #85ce61);
}
.match-badge.good {
  background: linear-gradient(135deg, #e6a23c, #ebb563);
}
.match-badge.fair {
  background: linear-gradient(135deg, #409EFF, #66b1ff);
}
.match-badge.poor {
  background: linear-gradient(135deg, #909399, #a6a9ad);
}
.tags-container {
  margin-bottom: 16rpx;
}
.tags-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.intro {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  padding-right: 10rpx;
}

.teach-mode {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.mode-tag {
  background: #f0f9eb;
  color: #67c23a;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: 2rpx solid #e1f3d8;
  transition: all 0.2s ease;
}

.mode-tag:active {
  transform: scale(0.95);
}

/* 状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
.loading-more, .no-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}