.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  display: flex;
  flex-direction: column;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #fff;
  padding: 24rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.filter-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.filter-item.active {
  color: #409EFF;
  font-weight: bold;
}
.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background: #409EFF;
  border-radius: 2rpx;
}

/* Loading 动画区 */
.loading-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-icon {
  width: 120rpx;
  height: 120rpx;
  animation: rotate 2s linear infinite; /* 确保有对应的 keyframes */
  margin-bottom: 30rpx;
}
@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 结果列表 */
.result-list {
  padding: 20rpx 30rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 150rpx;
}
.empty-state .text {
  margin-top: 20rpx;
  color: #999;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #ccc;
  font-size: 24rpx;
}