<view class="container">
  <view class="tutor-card">
    <view class="row">
      <text class="name">{{tutorName}}</text>
      <text class="price">¥{{unitPrice}}/小时</text>
    </view>
    <view class="subject-tag">{{subject}}</view>
  </view>

  <view class="form-box">
    <view class="input-group">
      <view class="label">上课学生</view>
      <picker bindchange="handleStudentChange" value="{{studentIndex}}" range="{{studentList}}" range-key="studentName">
        <view class="picker-val {{studentIndex === -1 ? 'placeholder' : ''}}">
          {{studentIndex === -1 ? '请选择学生' : studentList[studentIndex].studentName}}
        </view>
      </picker>
      <view class="arrow">></view>
    </view>

    <view class="input-group">
      <view class="label">当前年级</view>
      <picker bindchange="handleGradeChange" value="{{gradeIndex}}" range="{{grades}}">
        <view class="picker-val">
          {{grade || '请选择年级'}}
        </view>
      </picker>
      <view class="arrow">></view>
    </view>

    <view class="input-group">
      <view class="label">授课方式</view>
      <view class="radio-group">
        <view class="radio-item {{teachMode === 1 ? 'active' : ''}}" bindtap="selectMode" data-mode="1">上门</view>
        <view class="radio-item {{teachMode === 2 ? 'active' : ''}}" bindtap="selectMode" data-mode="2">在线</view>
      </view>
    </view>

    <view class="input-group">
      <view class="label">购买课时</view>
      <view class="stepper">
        <view class="step-btn minus {{totalHours <= 1 ? 'disabled' : ''}}" bindtap="changeHours" data-delta="-1">-</view>
        <input class="step-input" type="number" value="{{totalHours}}" disabled />
        <view class="step-btn plus" bindtap="changeHours" data-delta="1">+</view>
      </view>
    </view>

    <view class="input-group vertical">
      <view class="label">备注要求</view>
      <textarea class="remark-input" placeholder="请输入特殊要求..." bindinput="handleInput" data-field="remark"></textarea>
    </view>

    <view class="protocol-group">
      <checkbox-group bindchange="handleProtocolChange">
        <label class="checkbox-label">
          <checkbox value="agree" checked="{{agreeProtocol}}" />
          <text class="protocol-text">我已阅读并同意《家教服务协议》和《隐私政策》</text>
        </label>
      </checkbox-group>
    </view>
  </view>

  <view class="footer-bar">
    <view class="total-box">
      <text class="label">总计：</text>
      <text class="symbol">¥</text>
      <text class="amount">{{totalAmount}}</text>
    </view>
    <button class="pay-btn" bindtap="submitOrder" loading="{{isSubmitting}}" disabled="{{!agreeProtocol}}">提交订单</button>
  </view>

  <view class="modal-mask" wx:if="{{showPayModal}}" bindtap="closePayModal">
    <view class="modal-content" catchtap="return">
      <view class="modal-title">选择支付方式</view>
      <view class="pay-amount">¥ {{totalAmount}}</view>
      
      <view class="pay-options">
        <view class="pay-item" bindtap="confirmPay" data-type="1">
          <text class="icon wallet">👜</text> 钱包支付
          <text class="wallet-balance">余额: ¥{{walletBalance || 0}}</text>
        </view>
        <view class="pay-item" bindtap="confirmPay" data-type="2">
          <text class="icon wx">💚</text> 微信支付
        </view>
      </view>
    </view>
  </view>
</view>