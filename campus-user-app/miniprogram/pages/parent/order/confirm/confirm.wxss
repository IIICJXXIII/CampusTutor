.container {
  min-height: 100vh;
  background-color: #f6f7f9;
  padding: 20rpx 30rpx 140rpx; /* 底部留出按钮空间 */
}

/* 教员卡片 */
.tutor-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.tutor-card .name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.tutor-card .price {
  font-size: 32rpx;
  color: #f56c6c;
  font-weight: bold;
}
.subject-tag {
  display: inline-block;
  background: #ecf5ff;
  color: #409EFF;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 表单区域 */
.form-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
}
.input-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.input-group.vertical {
  display: block;
  border-bottom: none;
}
.input-group:last-child {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: #333;
}
.vertical .label {
  margin-bottom: 20rpx;
}

.picker-val {
  font-size: 30rpx;
  color: #333;
  text-align: right;
  width: 400rpx;
}
.picker-val.placeholder {
  color: #ccc;
}
.arrow {
  color: #ccc;
  margin-left: 10rpx;
}

/* 单选框 */
.radio-group {
  display: flex;
}
.radio-item {
  margin-left: 20rpx;
  padding: 8rpx 30rpx;
  background: #f5f7fa;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  border: 1px solid transparent;
}
.radio-item.active {
  background: #ecf5ff;
  color: #409EFF;
  border-color: #409EFF;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 50rpx;
  height: 50rpx;
  background: #f5f7fa;
  text-align: center;
  line-height: 50rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.step-btn.disabled {
  color: #ccc;
  background: #fcfcfc;
}
.step-input {
  width: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 备注框 */
.remark-input {
  width: 100%;
  height: 160rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 底部栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-sizing: border-box;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 10;
  padding-bottom: env(safe-area-inset-bottom);
}

.total-box {
  font-size: 28rpx;
  color: #333;
}
.total-box .symbol {
  color: #f56c6c;
  font-weight: bold;
}
.total-box .amount {
  color: #f56c6c;
  font-size: 40rpx;
  font-weight: bold;
}

.pay-btn {
  margin: 0;
  background: #409EFF;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 支付弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 30rpx 80rpx;
}
.modal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}
.pay-amount {
  text-align: center;
  font-size: 60rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 60rpx;
}
.pay-options {
  border-top: 1rpx solid #eee;
}
.pay-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  border-bottom: 1rpx solid #eee;
}
.pay-item:active {
  background-color: #f9f9f9;
}
.icon.wx { margin-right: 16rpx; font-size: 40rpx; }

/* 协议签署 */
.protocol-group {
  padding: 34rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.checkbox-label {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.protocol-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 36rpx;
}

checkbox {
  margin-top: 6rpx;
  transform: scale(0.8);
}