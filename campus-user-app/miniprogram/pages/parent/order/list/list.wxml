<wxs module="tools">
  // 状态映射辅助函数
  var statusMap = {
    '-1': { text: '待确认', color: '#909399' },
    '0': { text: '待支付', color: '#ff9900' },
    '1': { text: '待开课', color: '#409EFF' },
    '2': { text: '进行中', color: '#67c23a' },
    '3': { text: '已完成', color: '#909399' },
    '4': { text: '已取消', color: '#c0c4cc' },
    '5': { text: '退款中', color: '#e6a23c' },
    '6': { text: '已退款', color: '#909399' }
  };
  module.exports.getStatus = function(status) {
    return statusMap[status + ''] || { text: '未知', color: '#333' };
  }
</wxs>

<view class="container">
  <view class="tabs">
    <view class="tab-item {{currentTab === -1 ? 'active' : ''}}" bindtap="switchTab" data-status="-1">全部</view>
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-status="0">待支付</view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-status="1">待开课</view>
    <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-status="2">进行中</view>
  </view>

  <view class="order-list">
    <block wx:for="{{orderList}}" wx:key="id">
      <view class="order-card" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="card-header">
          <text class="order-no">订单号：{{item.orderNo}}</text>
          <text class="status-text" style="color: {{tools.getStatus(item.status).color}}">
            {{tools.getStatus(item.status).text}}
          </text>
        </view>

        <view class="card-body">
          <view class="course-title">{{item.subject}} - {{item.grade}}</view>
          <view class="info-row">
            <text class="label">课时安排：</text>
            <text class="value">{{item.totalHours}} 课时 ({{item.teachMode === 1 ? '线下上门' : '在线授课'}})</text>
          </view>
          <view class="info-row">
            <text class="label">下单时间：</text>
            <text class="value">{{item.createTime}}</text>
          </view>
        </view>

        <view class="card-footer">
          <view class="price-box">
            <text class="label">总价：</text>
            <text class="symbol">¥</text>
            <text class="amount">{{item.totalAmount}}</text>
          </view>
          
          <view class="btn-group">
            <block wx:if="{{item.status === 0}}">
              <button class="btn plain" catchtap="handleCancel" data-id="{{item.id}}">取消</button>
              <button class="btn primary" catchtap="handlePay" data-id="{{item.id}}">去支付</button>
            </block>

            <block wx:if="{{item.status === -1}}">
              <button class="btn plain" catchtap="handleCancel" data-id="{{item.id}}">拒绝</button>
              <button class="btn primary" catchtap="handleConfirm" data-id="{{item.id}}">确认</button>
            </block>

            <block wx:if="{{item.status === 1}}">
              <button class="btn plain" catchtap="handleCancel" data-id="{{item.id}}">申请退款</button>
              <button class="btn primary disabled">等待开课</button>
            </block>

            <block wx:if="{{item.status === 2}}">
              <button class="btn primary" catchtap="handleComplete" data-id="{{item.id}}">确认结课</button>
            </block>
            
            </view>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && orderList.length === 0}}" class="empty-state">
      <text>暂无相关订单</text>
    </view>

    <view wx:if="{{loading}}" class="loading-more">加载中...</view>
    <view wx:if="{{!hasMore && orderList.length > 0}}" class="no-more">—— 没有更多了 ——</view>
  </view>
</view>