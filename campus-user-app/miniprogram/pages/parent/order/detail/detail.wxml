<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{order}}" class="order-box">
    <view class="row"><text class="label">订单号：</text><text>{{order.orderNo}}</text></view>
    <view class="row"><text class="label">老师：</text><text>{{order.realName || order.tutorName}}</text></view>
    <view class="row"><text class="label">科目/年级：</text><text>{{order.subject}} · {{order.grade}}</text></view>
    <view class="row"><text class="label">课时：</text><text>{{order.totalHours}} × {{order.unitPrice}} 元</text></view>
    <view class="row"><text class="label">总额：</text><text class="amount">{{order.totalAmount}} 元</text></view>
    <view class="row"><text class="label">状态：</text><text>{{statusText}}</text></view>
    <view class="divider"></view>

    <view class="actions">
      <block wx:if="{{order.status === 0}}">
        <button class="btn primary" bindtap="showPayOptions">去支付</button>
        <button class="btn" bindtap="handleCancel">取消订单</button>
      </block>

      <block wx:elif="{{order.status === 1}}">
        <text class="muted">已支付，等待老师确认开课</text>
      </block>

      <block wx:elif="{{order.status === 2}}">
        <button class="btn primary" bindtap="handleComplete">确认结课</button>
      </block>

      <block wx:elif="{{order.status === 3}}">
        <text class="muted">订单已完成</text>
      </block>

      <block wx:elif="{{order.status === 4}}">
        <text class="muted">订单已取消</text>
      </block>
    </view>
  </view>
</view>