<!-- 家长端首页 - index.wxml -->
<view class="container">
  <!-- 顶部欢迎区域 -->
  <view class="header">
    <view class="welcome">
      <text class="greeting">您好，{{userInfo.nickname || '家长'}} 👋</text>
      <text class="subtitle">为孩子找到最适合的家教</text>
    </view>
  </view>

  <!-- 快捷功能区 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="goToPublish">
      <view class="action-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%)">
        <text class="icon-text">📝</text>
      </view>
      <text class="action-title">发布需求</text>
      <text class="action-desc">快速找家教</text>
    </view>
    <view class="action-item" bindtap="goToMyDemands">
      <view class="action-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%)">
        <text class="icon-text">📋</text>
      </view>
      <text class="action-title">我的需求</text>
      <text class="action-desc">查看进度</text>
    </view>
    <view class="action-item" bindtap="goToOrders">
      <view class="action-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)">
        <text class="icon-text">📚</text>
      </view>
      <text class="action-title">我的订单</text>
      <text class="action-desc">课程管理</text>
    </view>
  </view>

  <!-- 最近需求 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">我的需求</text>
      <text class="section-more" bindtap="goToMyDemands">查看全部 ></text>
    </view>
    <view class="demand-list" wx:if="{{demandList.length > 0}}">
      <block wx:for="{{demandList}}" wx:key="id">
        <view class="demand-card" bindtap="goToDemandDetail" data-id="{{item.id}}">
          <view class="demand-info">
            <text class="demand-title">{{item.subject}} - {{item.grade}}</text>
            <text class="demand-time">{{item.createTime}}</text>
          </view>
          <view class="demand-status {{item.status === 2 ? 'matched' : 'active'}}">
            {{item.status === 2 ? '已匹配' : item.status === 1 ? '寻找中' : '已下架'}}
          </view>
        </view>
      </block>
    </view>
    <view class="empty-tip" wx:else>
      <text>暂无需求，点击上方发布</text>
    </view>
  </view>

  <!-- 最近订单 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">进行中的订单</text>
      <text class="section-more" bindtap="goToOrders">查看全部 ></text>
    </view>
    <view class="order-list" wx:if="{{orderList.length > 0}}">
      <block wx:for="{{orderList}}" wx:key="id">
        <view class="order-card" bindtap="goToOrderDetail" data-id="{{item.id}}">
          <view class="order-info">
            <text class="order-subject">{{item.subject}}</text>
            <text class="order-progress">已上 {{item.usedHours}}/{{item.totalHours}} 课时</text>
          </view>
          <view class="order-action">
            <text class="order-btn">查看详情</text>
          </view>
        </view>
      </block>
    </view>
    <view class="empty-tip" wx:else>
      <text>暂无进行中的订单</text>
    </view>
  </view>
</view>
