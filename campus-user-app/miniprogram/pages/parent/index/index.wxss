/* 家长端首页样式 - index.wxss */
page {
  background: #f6f7f9;
}

.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 顶部欢迎区域 */
.header {
  padding: 32rpx 0;
}

.welcome {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 快捷功能区 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.action-item {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.action-item:first-child {
  margin-left: 0;
}

.action-item:last-child {
  margin-right: 0;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.icon-text {
  font-size: 36rpx;
}

.action-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 22rpx;
  color: #999;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #667eea;
}

/* 需求卡片 */
.demand-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.demand-card:last-child {
  border-bottom: none;
}

.demand-info {
  display: flex;
  flex-direction: column;
}

.demand-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.demand-time {
  font-size: 24rpx;
  color: #999;
}

.demand-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.demand-status.active {
  background: #e8f4fd;
  color: #409EFF;
}

.demand-status.matched {
  background: #f0f9eb;
  color: #67c23a;
}

.demand-status.completed {
  background: #f4f4f5;
  color: #909399;
}

/* 订单卡片 */
.order-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-card:last-child {
  border-bottom: none;
}

.order-info {
  display: flex;
  flex-direction: column;
}

.order-subject {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.order-progress {
  font-size: 24rpx;
  color: #999;
}

.order-btn {
  font-size: 26rpx;
  color: #667eea;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}
