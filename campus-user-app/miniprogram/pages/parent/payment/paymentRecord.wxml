<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="header-left" bindtap="navigateBack">
      <text class="back-icon">←</text>
    </view>
    <view class="header-center">
      <text class="title">支付记录</text>
    </view>
    <view class="header-right"></view>
  </view>

  <!-- 状态筛选 -->
  <view class="filter-section">
    <scroll-view scroll-x="true" class="filter-scroll">
      <view 
        wx:for="{{statuses}}" 
        wx:key="id"
        class="filter-item {{selectedStatus === item.id ? 'active' : ''}}"
        bindtap="selectStatus"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <!-- 支付记录列表 -->
  <view class="list-section">
    <view wx:if="{{payments.length === 0 && !isLoading}}" class="empty-state">
      <text class="empty-text">暂无支付记录</text>
    </view>

    <view wx:for="{{payments}}" wx:key="id" class="payment-item">
      <view class="payment-header">
        <text class="payment-order">订单号：{{item.orderNo}}</text>
        <text class="payment-status {{getStatusClass(item.status)}}">{{getStatusText(item.status)}}</text>
      </view>
      <view class="payment-info">
        <text class="info-item">课程：{{item.subject}}</text>
        <text class="info-item">课时：{{item.totalHours}}小时</text>
        <text class="info-item">金额：¥{{item.totalAmount}}</text>
        <text class="info-item">时间：{{formatTime(item.createTime)}}</text>
      </view>
      <view class="payment-footer">
        <view wx:if="{{item.status === 1}}" class="action-buttons">
          <button class="pay-btn" bindtap="payAgain" data-id="{{item.id}}">去支付</button>
        </view>
        <button class="detail-btn" bindtap="goToOrderDetail" data-id="{{item.id}}">查看详情</button>
      </view>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{isLoading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>