<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="header-left" bindtap="navigateBack">
      <text class="back-icon">←</text>
    </view>
    <view class="header-center">
      <text class="title">申请退款</text>
    </view>
    <view class="header-right"></view>
  </view>

  <!-- 订单信息 -->
  <view class="order-info">
    <view class="order-item">
      <text class="order-label">订单号</text>
      <text class="order-value">{{order.orderNo}}</text>
    </view>
    <view class="order-item">
      <text class="order-label">课程</text>
      <text class="order-value">{{order.subject}}</text>
    </view>
    <view class="order-item">
      <text class="order-label">总金额</text>
      <text class="order-value amount">¥{{order.totalAmount}}</text>
    </view>
    <view class="order-item">
      <text class="order-label">已上课时</text>
      <text class="order-value">{{order.usedHours || 0}}小时</text>
    </view>
    <view class="order-item">
      <text class="order-label">剩余课时</text>
      <text class="order-value">{{order.totalHours - (order.usedHours || 0)}}小时</text>
    </view>
  </view>

  <!-- 退款信息 -->
  <view class="refund-info">
    <view class="info-item">
      <text class="info-label">退款类型</text>
      <view class="refund-type">
        <view class="type-item {{refundType === 1 ? 'active' : ''}}" bindtap="selectRefundType" data-type="1">
          全额退款
        </view>
        <view class="type-item {{refundType === 2 ? 'active' : ''}}" bindtap="selectRefundType" data-type="2">
          部分退款
        </view>
      </view>
    </view>

    <view class="info-item" wx:if="{{refundType === 2}}">
      <text class="info-label">退款金额</text>
      <view class="amount-input">
        <text class="amount-symbol">¥</text>
        <input 
          class="amount-input" 
          type="number" 
          placeholder="请输入退款金额" 
          value="{{refundAmount}}"
          bindinput="handleAmountInput"
        />
      </view>
      <text class="amount-hint">可退金额：¥{{refundableAmount}}</text>
    </view>

    <view class="info-item">
      <text class="info-label">退款原因</text>
      <textarea 
        class="reason-input" 
        placeholder="请输入退款原因" 
        value="{{refundReason}}"
        bindinput="handleReasonInput"
      />
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button 
      class="submit-btn" 
      bindtap="submitRefund"
      loading="{{isSubmitting}}"
      disabled="{{isSubmitting}}"
    >
      提交退款申请
    </button>
  </view>
</view>