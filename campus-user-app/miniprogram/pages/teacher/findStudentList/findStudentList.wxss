/* 学生列表页面样式 - findStudentList.wxss */
.container {
  min-height: 100vh;
  background-color: var(--bg-body);
}

/* 页面头部 - Glassmorphism but Warmer */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 96rpx;
  padding: 0 32rpx;
  background-color: rgba(255, 251, 247, 0.95); /* Warm White Translucent */
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid var(--border);
}

.header-left {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 44rpx;
  color: var(--text-main);
  transition: all 0.3s ease;
}

.back-icon:active {
  transform: translateX(-4rpx);
  color: var(--primary);
}

.header-center {
  flex: 1;
  text-align: center;
  padding: 0 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: 1rpx;
}

.header-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 科目滚动栏 */
.subject-scroll {
  height: 110rpx;
  background-color: var(--bg-body);
  margin-bottom: 0;
  position: sticky;
  top: 96rpx;
  z-index: 90;
  padding: 16rpx 0;
}

.subject-container {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 32rpx;
  gap: 20rpx;
}

.subject-item {
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  white-space: nowrap;
  transition: all 0.3s ease;
  border: 1rpx solid transparent;
  box-shadow: var(--shadow-sm);
}

.subject-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-hover);
  transform: scale(1.02);
  border-color: rgba(255,255,255,0.2);
}

/* 排序选择器 */
.sort-container {
  background-color: var(--bg-body);
  margin-bottom: 16rpx;
  padding: 0 32rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  position: sticky;
  top: 206rpx;
  z-index: 80;
}

.sort-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  background: var(--bg-card);
  padding: 12rpx 30rpx;
  border-radius: 36rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
}

.sort-arrow {
  font-size: 20rpx;
  color: var(--primary);
}

/* 需求列表 */
.demand-list {
  padding: 0 32rpx 32rpx;
}

.demand-card {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  position: relative;
  overflow: hidden;
}

.demand-card:active {
  transform: scale(0.99);
  border-color: var(--secondary);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.subject {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-main);
}

.grade-tag {
  padding: 6rpx 20rpx;
  background-color: #F0EEE9; /* Warmer Grey */
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.price-area {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary); /* Caramel Brown for Price */
  line-height: 1;
  margin-bottom: 10rpx;
  letter-spacing: -1rpx;
}

/* 匹配等级徽章 - Softer Colors */
.match-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.match-badge.excellent { background: rgba(102, 187, 106, 0.15); color: var(--success); }
.match-badge.good { background: rgba(248, 200, 180, 0.2); color: #E67E22; }
.match-badge.fair { background: rgba(255, 183, 77, 0.15); color: var(--warning); }
.match-badge.basic { background: rgba(140, 129, 119, 0.1); color: var(--text-secondary); }

/* 匹配分数徽章 */
.score-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: rgba(139, 90, 43, 0.08); /* Light Caramel */
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--primary);
}

.score-value {
  font-weight: 700;
}

/* 匹配标签 */
.match-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.match-tags .tag {
  padding: 10rpx 24rpx;
  background-color: #FFFBF7; /* Light Body BG */
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 1rpx solid rgba(139, 90, 43, 0.1);
}

/* 卡片内容 */
.card-body {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #FFFBF7; /* Light warm bg inside card */
  border-radius: var(--radius-md);
  border: 1rpx dashed var(--border);
}

.info-item {
  display: flex;
  margin-bottom: 16rpx;
  align-items: flex-start;
  gap: 20rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  width: 100rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  line-height: 1.5;
  font-weight: 500;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.5;
}

.value.address {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(0,0,0,0.03);
  gap: 24rpx; 
}

.status-tag {
  padding: 10rpx 28rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.status-tag.active {
  background-color: rgba(102, 187, 106, 0.1);
  color: var(--success);
}

.status-tag.inactive {
  background-color: #F0F2F5;
  color: var(--text-placeholder);
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.btn {
  padding: 16rpx 32rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  white-space: nowrap;
  line-height: normal;
  margin: 0;
}

.btn.detail {
  background: transparent;
  color: var(--text-secondary);
  border: 1rpx solid var(--border);
}

.btn.contact {
  background: var(--secondary); /* Soft Orange Pink */
  color: var(--primary); /* Caramel Text */
  border: none;
  box-shadow: var(--shadow-sm);
}

.btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 600rpx;
  text-align: center;
  padding: 0 32rpx;
  background-color: var(--bg-card);
  margin: 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx dashed var(--border);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: var(--text-placeholder);
  font-size: 26rpx;
}

/* 加载状态 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: var(--text-secondary);
}

.retry-btn {
  margin-top: 24rpx;
  background: var(--secondary);
  color: var(--primary);
  padding: 14rpx 36rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
}
