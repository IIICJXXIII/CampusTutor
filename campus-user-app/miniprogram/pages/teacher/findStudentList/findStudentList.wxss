/* 学生列表页面样式 - findStudentList.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 页面头部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #e9ecef;
}

.header-left {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 48rpx;
  color: #495057;
  font-weight: 300;
  transition: all 0.3s ease;
}

.back-icon:active {
  transform: translateX(-10rpx);
  color: #007bff;
}

.header-center {
  flex: 1;
  text-align: center;
  padding: 0 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #212529;
  letter-spacing: 2rpx;
  width: 100%;
  text-align: center;
}

.header-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 科目滚动栏 */
.subject-scroll {
  height: 96rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #e9ecef;
  margin-bottom: 12rpx;
  position: sticky;
  top: 88rpx;
  z-index: 90;
}

/* 排序选择器 */
.sort-container {
  background-color: #fff;
  border-bottom: 1rpx solid #e9ecef;
  margin-bottom: 12rpx;
  padding: 0 32rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  position: sticky;
  top: 184rpx;
  z-index: 80;
}

.sort-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  font-size: 28rpx;
  color: #495057;
  padding: 16rpx 36rpx;
  background-color: #f8f9fa;
  border-radius: 28rpx;
  transition: all 0.3s ease;
  min-width: 320rpx;
  width: 100%;
  max-width: 480rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.sort-picker:active {
  background-color: #e9ecef;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.sort-arrow {
  width: 24rpx;
  height: 24rpx;
  transition: all 0.3s ease;
  opacity: 0.6;
}

.subject-container {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 32rpx;
  gap: 24rpx;
}

.subject-item {
  padding: 16rpx 32rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #6c757d;
  white-space: nowrap;
  transition: all 0.3s ease;
  background-color: #f8f9fa;
  border: 1rpx solid #dee2e6;
}

.subject-item.active {
  background: linear-gradient(135deg, #007bff 0%, #0069d9 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(0, 123, 255, 0.4);
  border: none;
  transform: translateY(-2rpx);
}

/* 需求列表 */
.demand-list {
  padding: 0 32rpx 20rpx;
}

.demand-card {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  border: 1rpx solid #e9ecef;
  position: relative;
  overflow: hidden;
}

.demand-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
  background: linear-gradient(180deg, #007bff 0%, #0069d9 100%);
  border-radius: 4rpx 0 0 4rpx;
}

.demand-card:active {
  transform: translateY(-8rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.subject {
  font-size: 34rpx;
  font-weight: 700;
  color: #212529;
  line-height: 1.2;
}

.grade-tag {
  padding: 8rpx 20rpx;
  background-color: #e3f2fd;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #1976d2;
  font-weight: 500;
  border: 1rpx solid #bbdefb;
}

.price {
  font-size: 40rpx;
  font-weight: 700;
  color: #dc3545;
  margin-bottom: 8rpx;
  font-family: 'Roboto', sans-serif;
}

.unit {
  font-size: 24rpx;
  font-weight: 400;
}

/* 匹配等级徽章 */
.match-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.match-badge.excellent {
  background-color: #e8f5e8;
  color: #2e7d32;
  border: 1rpx solid #c8e6c9;
}

.match-badge.good {
  background-color: #e3f2fd;
  color: #1565c0;
  border: 1rpx solid #bbdefb;
}

.match-badge.fair {
  background-color: #fff8e1;
  color: #ef6c00;
  border: 1rpx solid #ffecb3;
}

.match-badge.poor {
  background-color: #ffebee;
  color: #c62828;
  border: 1rpx solid #ffcdd2;
}

/* 匹配分数徽章 */
.score-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(23, 162, 184, 0.4);
  font-weight: 600;
}

.score-icon {
  font-size: 32rpx;
}

.score-value {
  font-size: 32rpx;
  font-weight: 700;
  font-family: 'Roboto', sans-serif;
}

.score-unit {
  font-size: 22rpx;
  font-weight: 400;
}

/* 匹配标签 */
.match-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.match-tags .tag {
  padding: 8rpx 20rpx;
  background-color: #f8f9fa;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #495057;
  white-space: nowrap;
  border: 1rpx solid #dee2e6;
  transition: all 0.3s ease;
}

.match-tags .tag:active {
  background-color: #e9ecef;
  transform: scale(0.95);
}

/* 卡片头部右侧 */
.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

/* 卡片内容 */
.card-body {
  margin-bottom: 28rpx;
}

.info-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
  gap: 16rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  width: 120rpx;
  font-size: 26rpx;
  color: #6c757d;
  flex-shrink: 0;
  line-height: 1.4;
  font-weight: 500;
}

.value {
  flex: 1;
  font-size: 26rpx;
  color: #495057;
  line-height: 1.5;
}

.value.address {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.value.description {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 28rpx;
  border-top: 1rpx solid #e9ecef;
}

.status-tag {
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.status-tag.active {
  background-color: #e8f5e8;
  color: #2e7d32;
  border: 1rpx solid #c8e6c9;
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 50, 0.2);
}

.status-tag.inactive {
  background-color: #f8f9fa;
  color: #6c757d;
  border: 1rpx solid #dee2e6;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.btn {
  padding: 16rpx 40rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  border: none;
  min-width: 160rpx;
  text-align: center;
}

.btn.detail {
  background: linear-gradient(135deg, #007bff 0%, #0069d9 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(0, 123, 255, 0.4);
  position: relative;
  overflow: hidden;
}

.btn.detail::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.6s;
}

.btn.detail:active::before {
  left: 100%;
}

.btn.detail:active {
  transform: translateY(4rpx) scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(0, 123, 255, 0.6);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  text-align: center;
  padding: 0 32rpx;
  background-color: #fff;
  margin: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1rpx dashed #dee2e6;
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 40rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #212529;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #6c757d;
  line-height: 1.5;
  max-width: 80%;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  padding: 32rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #6c757d;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.loading-text::before {
  content: '';
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #e9ecef;
  border-top-color: #007bff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  text-align: center;
  padding: 0 32rpx;
  background-color: #fff;
  margin: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f8d7da;
}

.error-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  color: #dc3545;
}

.error-text {
  font-size: 28rpx;
  color: #495057;
  margin-bottom: 32rpx;
  line-height: 1.5;
  max-width: 80%;
}

.retry-btn {
  padding: 20rpx 56rpx;
  background: linear-gradient(135deg, #007bff 0%, #0069d9 100%);
  color: #fff;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(0, 123, 255, 0.4);
  transition: all 0.3s ease;
  border: none;
}

.retry-btn:active {
  transform: scale(0.95);
  box-shadow: 0 3rpx 10rpx rgba(0, 123, 255, 0.6);
}

/* 响应式设计 */
@media (max-width: 375px) {
  .subject {
    font-size: 30rpx;
  }
  
  .price {
    font-size: 36rpx;
  }
  
  .info-item {
    font-size: 24rpx;
  }
  
  .demand-card {
    padding: 28rpx;
  }
  
  .btn {
    padding: 14rpx 32rpx;
    font-size: 24rpx;
  }
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 8rpx;
  height: 8rpx;
}

::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 4rpx;
}

::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 4rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}