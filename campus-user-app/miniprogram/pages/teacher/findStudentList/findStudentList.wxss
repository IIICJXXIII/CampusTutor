/* 学生列表页面样式 - findStudentList.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 页面头部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
  transition: all 0.3s ease;
}

.back-icon:active {
  transform: translateX(-10rpx);
}

.header-center {
  flex: 1;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  letter-spacing: 2rpx;
}

.header-right {
  width: 80rpx;
}

/* 科目滚动栏 */
.subject-scroll {
  height: 96rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 12rpx;
  position: sticky;
  top: 88rpx;
  z-index: 90;
}

/* 排序选择器 */
.sort-container {
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 12rpx;
  padding: 0 32rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  position: sticky;
  top: 184rpx;
  z-index: 80;
}

.sort-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.sort-arrow {
  width: 24rpx;
  height: 24rpx;
  transition: all 0.3s ease;
}

.subject-container {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 32rpx;
  gap: 24rpx;
}

.subject-item {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #666;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.subject-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

/* 需求列表 */
.demand-list {
  padding: 0 32rpx 20rpx;
}

.demand-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.demand-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.subject {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.grade-tag {
  padding: 4rpx 16rpx;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff6b6b;
  margin-bottom: 8rpx;
}

.unit {
  font-size: 24rpx;
  font-weight: 400;
}

/* 匹配等级徽章 */
.match-badge {
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.match-badge.excellent {
  background-color: #e8f5e8;
  color: #4caf50;
}

.match-badge.good {
  background-color: #e3f2fd;
  color: #2196f3;
}

.match-badge.fair {
  background-color: #fff8e1;
  color: #ff9800;
}

.match-badge.poor {
  background-color: #ffebee;
  color: #f44336;
}

/* 匹配分数徽章 */
.score-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

.score-icon {
  font-size: 28rpx;
}

.score-value {
  font-size: 28rpx;
  font-weight: 600;
}

.score-unit {
  font-size: 20rpx;
  font-weight: 400;
}

/* 匹配标签 */
.match-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.match-tags .tag {
  padding: 6rpx 16rpx;
  background-color: #f0f0f0;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #666;
  white-space: nowrap;
}

/* 卡片头部右侧 */
.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

/* 卡片内容 */
.card-body {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  margin-bottom: 16rpx;
  align-items: flex-start;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  width: 120rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.value {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.value.address {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.value.description {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.status-tag {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-tag.active {
  background-color: #e8f4fd;
  color: #409eff;
}

.status-tag.inactive {
  background-color: #f5f5f5;
  color: #999;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.btn {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.btn.detail {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

.btn.detail:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.6);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  text-align: center;
  padding: 0 32rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  text-align: center;
  padding: 0 32rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
  line-height: 1.4;
}

.retry-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s ease;
}

.retry-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.6);
}

/* 响应式设计 */
@media (max-width: 375px) {
  .subject {
    font-size: 28rpx;
  }
  
  .price {
    font-size: 28rpx;
  }
  
  .info-item {
    font-size: 24rpx;
  }
}