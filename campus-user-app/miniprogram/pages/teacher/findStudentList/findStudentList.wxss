/* 学生列表页面样式 - findStudentList.wxss */
.container {
  min-height: 100vh;
  background-color: var(--bg-body);
}

/* 页面头部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 40rpx;
  color: var(--text-main);
  transition: all 0.3s ease;
}

.back-icon:active {
  transform: translateX(-4rpx);
  opacity: 0.7;
}

.header-center {
  flex: 1;
  text-align: center;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.header-right {
  width: 80rpx;
}

/* 科目滚动栏 */
.subject-scroll {
  height: 100rpx;
  background-color: var(--bg-body);
  margin-bottom: 0;
  position: sticky;
  top: 88rpx;
  z-index: 90;
  padding: 12rpx 0;
}

.subject-container {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 32rpx;
  gap: 16rpx;
}

.subject-item {
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  white-space: nowrap;
  transition: all 0.3s ease;
  border: 1rpx solid transparent;
  box-shadow: var(--shadow-sm);
}

.subject-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
  transform: scale(1.05);
}

/* 排序选择器 */
.sort-container {
  background-color: var(--bg-body);
  margin-bottom: 12rpx;
  padding: 0 32rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  position: sticky;
  top: 188rpx;
  z-index: 80;
}

.sort-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 600;
  background: var(--bg-card);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  box-shadow: var(--shadow-sm);
}

.sort-arrow {
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* 需求列表 */
.demand-list {
  padding: 0 32rpx 20rpx;
}

.demand-card {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
  border: 1rpx solid transparent;
  position: relative;
  overflow: hidden;
}

.demand-card:active {
  transform: scale(0.99);
  border-color: var(--primary-light);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.subject {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.grade-tag {
  padding: 4rpx 16rpx;
  background-color: #F0F2F5;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.price-area {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--secondary);
  line-height: 1;
  margin-bottom: 8rpx;
}

/* 匹配等级徽章 */
.match-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.match-badge.excellent { background: rgba(0, 191, 165, 0.1); color: var(--success); }
.match-badge.good { background: rgba(41, 121, 255, 0.1); color: var(--info); }
.match-badge.fair { background: rgba(255, 171, 0, 0.1); color: var(--warning); }
.match-badge.basic { background: rgba(113, 128, 150, 0.1); color: var(--text-secondary); }

/* 匹配分数徽章 */
.score-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  background: var(--primary-fade);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--primary);
}

.score-value {
  font-weight: 700;
}

/* 匹配标签 */
.match-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.match-tags .tag {
  padding: 8rpx 20rpx;
  background-color: var(--bg-body);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 卡片内容 */
.card-body {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: var(--bg-body);
  border-radius: var(--radius-md);
}

.info-item {
  display: flex;
  margin-bottom: 12rpx;
  align-items: flex-start;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  width: 100rpx;
  font-size: 26rpx;
  color: var(--text-placeholder);
  flex-shrink: 0;
}

.value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-main);
  line-height: 1.5;
}

.value.address {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  gap: 20rpx; /* Ensure space between status and buttons */
}

.status-tag {
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap; /* Prevent text wrapping */
  flex-shrink: 0; /* Prevent tag from shrinking */
}

.status-tag.active {
  background-color: var(--primary-fade);
  color: var(--primary);
}

.status-tag.inactive {
  background-color: #F0F2F5;
  color: var(--text-placeholder);
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  flex: 1; /* Take up remaining space */
  min-width: 0; /* Allow shrinking if absolutely necessary */
}

.btn {
  padding: 14rpx 24rpx; /* Reduced padding */
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  white-space: nowrap; /* Prevent button text wrapping */
  line-height: normal;
  margin: 0;
}

.btn.detail {
  background: var(--bg-card);
  color: var(--text-main);
  border: 1rpx solid var(--border);
  flex-shrink: 1; /* Allow detail button to shrink slightly if needed */
}

.btn.contact {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  border: none;
  box-shadow: var(--shadow-primary);
  flex-shrink: 0; /* Contact button is primary, shouldn't shrink */
}

.btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 600rpx;
  text-align: center;
  padding: 0 32rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: var(--text-placeholder);
  font-size: 24rpx;
}

/* 加载状态 */
.loading-state, .error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: var(--text-secondary);
}

.retry-btn {
  margin-top: 24rpx;
  background: var(--primary);
  color: #fff;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}
