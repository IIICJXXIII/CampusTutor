.container { padding: 20rpx; background: #fff; }
.filters { display:flex; gap:12rpx; margin-bottom:12rpx; flex-wrap:wrap }
.filter-item { padding:10rpx 14rpx; border-radius:8rpx; background:#f5f7fa; font-size:26rpx }
.list { margin-top:8rpx }
.item { display:flex; justify-content:space-between; padding:18rpx; border-bottom:1rpx solid #f0f0f0 }
.title { font-size:28rpx; font-weight:600 }
.meta { color:#999; margin-top:8rpx }
.price { color:#34c759; font-weight:700; margin-bottom:8rpx }
.actions button { margin-left:8rpx }
.empty { text-align:center; color:#999; padding:30rpx }
.loading { text-align:center; padding:20rpx; color:#666 }
.load-more { width:100%; margin-top:12rpx }
.btn.small { padding:6rpx 8rpx; font-size:24rpx }
.btn.ghost { background:#fff; border:1rpx solid #ddd }
