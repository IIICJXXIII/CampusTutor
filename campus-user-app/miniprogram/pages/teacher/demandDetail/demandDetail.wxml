<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="error-container">
    <icon type="warn" size="64" color="#E2E8F0"></icon>
    <text class="error-text">获取详情失败</text>
    <button class="btn-reload" bindtap="handleReload">重新加载</button>
  </view>

  <!-- 详情内容 -->
  <scroll-view wx:else class="detail-scroll" scroll-y>
    
    <!-- 顶部概览卡片 -->
    <view class="header-card">
      <view class="card-top">
        <view class="subject-row">
          <text class="subject">{{demand.subject}}</text>
          <text class="grade-tag">{{demand.grade}}</text>
        </view>
        <view class="price-row">
          <text class="currency">¥</text>
          <text class="price">{{demand.expectPrice}}</text>
          <text class="unit">/小时</text>
        </view>
      </view>
      <view class="publish-time">发布于 {{demand.createTime}}</view>
    </view>

    <!-- 主要信息区域 -->
    <view class="content-section">
      
      <!-- 需求详情 -->
      <view class="info-card">
        <view class="section-header">
          <view class="section-icon-box">
            <text class="icon-text">📝</text> 
          </view>
          <text class="section-title">需求描述</text>
        </view>
        <view class="detail-content">
          <text class="detail-text">{{demand.detail || '家长未填写详细描述'}}</text>
        </view>
      </view>

      <!-- 基本要求 -->
      <view class="info-card">
        <view class="section-header">
          <view class="section-icon-box">
             <text class="icon-text">📌</text>
          </view>
          <text class="section-title">基本要求</text>
        </view>
        
        <view class="requirement-list">
          <view class="req-item">
            <text class="req-label">时间要求</text>
            <text class="req-value">{{demand.scheduleRequire || '暂无时间要求'}}</text>
          </view>
          <view class="req-item">
            <text class="req-label">其他要求</text>
            <text class="req-value">{{demand.otherRequire || '暂无其他要求'}}</text>
          </view>
           <view class="req-item" wx:if="{{demand.studentId}}">
            <text class="req-label">学生编号</text>
            <text class="req-value">#{{demand.studentId}}</text>
          </view>
        </view>
      </view>

      <!-- 上课地址 -->
      <view class="info-card">
        <view class="section-header">
          <view class="section-icon-box">
             <text class="icon-text">📍</text>
          </view>
          <text class="section-title">上课地点</text>
        </view>
        <view class="address-box">
          <text class="address-text">{{demand.address || '未显示详细地址'}}</text>
        </view>
        <view class="map-container">
          <map 
            class="mini-map" 
            latitude="{{demand.latitude}}" 
            longitude="{{demand.longitude}}" 
            markers="{{markers}}"
            scale="15"
            show-location
            enable-scroll="{{false}}"
            enable-zoom="{{false}}"
          ></map>
        </view>
      </view>

    </view>
    
    <!-- 底部占位，防止内容被按钮遮挡 -->
    <view class="bottom-spacer"></view>
  </scroll-view>

    <!-- 底部操作栏 -->
    <view class="bottom-action-bar">
      <button class="btn-secondary" bindtap="handleContact">联系家长</button>
      <block wx:if="{{demand && demand.status === 1}}">
        <button class="btn-primary" bindtap="handleInviteToOrder">立即接单</button>
      </block>
      <block wx:elif="{{demand && demand.status === 2}}">
        <button class="btn-disabled">已被接单</button>
      </block>
      <block wx:else>
        <button class="btn-disabled">不可接单</button>
      </block>
    </view>
</view>
