<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="error-container">
    <text class="error-text">获取详情失败</text>
    <button class="btn-reload" bindtap="handleReload">重新加载</button>
  </view>

  <!-- 详情内容 -->
  <scroll-view wx:else class="detail-scroll" scroll-y>
    <!-- 需求基本信息 -->
    <view class="detail-card">
      <view class="card-header">
        <view class="title-row">
          <text class="subject">{{demand.subject}}</text>
          <text class="grade-tag">{{demand.grade}}</text>
        </view>
        <text class="price">¥{{demand.expectPrice}}<text class="unit">/小时</text></text>
      </view>

      <view class="card-content">
        <view class="info-section">
          <text class="section-title">需求详情</text>
          <text class="detail-text">{{demand.detail || '暂无详细描述'}}</text>
        </view>

        <view class="info-section">
          <text class="section-title">上课地址</text>
          <text class="address-text">{{demand.address || '未显示详细地址'}}</text>
          <view class="map-preview">
            <map 
              class="mini-map" 
              latitude="{{demand.latitude}}" 
              longitude="{{demand.longitude}}" 
              markers="{{markers}}"
              scale="16"
              show-location
              enable-scroll
              enable-zoom
            ></map>
          </view>
        </view>

        <view class="info-section">
          <text class="section-title">时间要求</text>
          <text class="schedule-text">{{demand.scheduleRequire || '暂无时间要求'}}</text>
        </view>

        <view class="info-section">
          <text class="section-title">其他要求</text>
          <text class="other-text">{{demand.otherRequire || '暂无其他要求'}}</text>
        </view>

        <view class="info-section">
          <text class="section-title">发布时间</text>
          <text class="time-text">{{demand.createTime || '未知'}}</text>
        </view>

        <!-- 学生信息（简略） -->
        <view class="info-section">
          <text class="section-title">学生信息</text>
          <view class="student-info">
            <view class="info-item">
              <text class="label">学生ID：</text>
              <text class="value">{{demand.studentId}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="btn-contact" bindtap="handleContact">联系家长</button>
      <block wx:if="{{demand.status === 1}}">
        <button class="btn-accept" bindtap="handleInviteToOrder">联系并邀约下单</button>
      </block>
      <block wx:elif="{{demand.status === 2}}">
        <button class="btn-accept disabled">已被接单</button>
      </block>
      <block wx:else>
        <button class="btn-accept disabled">不可接单</button>
      </block>
    </view>
  </scroll-view>

  <!-- 返回按钮 -->
  <view class="back-button" bindtap="handleBack">
    <text class="back-icon">←</text>
    <text class="back-text">返回</text>
  </view>
</view>
