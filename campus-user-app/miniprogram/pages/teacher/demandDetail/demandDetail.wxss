/* 教师详情页样式 - 简约专业风 */
page {
  background-color: #F8F9FA;
  --prof-primary: #1E6F9F;
  --prof-primary-dark: #165b85;
  --prof-secondary: #E8F8F5;
  --prof-accent: #0D9488; /* Teal accent for icons */
  --prof-border: #E2E8F0;
  --prof-card-bg: #FFFFFF;
  --text-main: #1A202C;
  --text-sub: #718096;
  --danger: #E53E3E;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Loading & Error */
.loading-container, .error-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--prof-border);
  border-top-color: var(--prof-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text, .error-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

.btn-reload {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--prof-primary);
  background: var(--prof-secondary);
  border: none;
  border-radius: 30rpx;
  padding: 10rpx 40rpx;
}

/* 滚动区域 */
.detail-scroll {
  flex: 1;
  box-sizing: border-box;
}

/* 顶部概览卡片 */
.header-card {
  background: linear-gradient(135deg, #1E6F9F 0%, #2B6CB0 100%);
  padding: 40rpx 32rpx;
  padding-bottom: 60rpx;
  color: white;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  margin-bottom: -40rpx; /* Creates overlap effect */
  position: relative;
  z-index: 1;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.subject-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.subject {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.grade-tag {
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  backdrop-filter: blur(4px);
}

.price-row {
  display: flex;
  align-items: baseline;
  background: rgba(0, 0, 0, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.currency {
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 4rpx;
}

.price {
  font-size: 40rpx;
  font-weight: 800;
}

.unit {
  font-size: 24rpx;
  opacity: 0.8;
  margin-left: 4rpx;
}

.publish-time {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 内容区域 */
.content-section {
  padding: 0 24rpx;
  position: relative;
  z-index: 2;
}

/* 通用信息卡片 */
.info-card {
  background: var(--prof-card-bg);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid var(--prof-border);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F4F8;
}

.section-icon-box {
  width: 56rpx;
  height: 56rpx;
  background: var(--prof-secondary);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.icon-text {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* 详情文本 */
.detail-text {
  font-size: 28rpx;
  color: #4A5568;
  line-height: 1.7;
  text-align: justify;
}

/* 要求列表 */
.requirement-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.req-item {
  display: flex;
  font-size: 28rpx;
}

.req-label {
  color: var(--text-sub);
  width: 140rpx;
  flex-shrink: 0;
}

.req-value {
  color: var(--text-main);
  font-weight: 500;
  flex: 1;
}

/* 地址与地图 */
.address-box {
  margin-bottom: 20rpx;
}

.address-text {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.5;
}

.map-container {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid var(--prof-border);
}

.mini-map {
  width: 100%;
  height: 100%;
}

.bottom-spacer {
  height: 160rpx;
}

/* 底部操作栏 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 100;
}

.action-btn-group {
  flex: 1;
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--prof-secondary);
  color: var(--prof-primary);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary:active {
  background: #D1EAE7;
}

.btn-primary {
  flex: 1.5;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--prof-primary);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  transform: translateY(2rpx);
  background: var(--prof-primary-dark);
}

.btn-disabled {
  flex: 1.5;
  height: 88rpx;
  line-height: 88rpx;
  background: #EDF2F7;
  color: #A0AEC0;
  font-size: 28rpx;
  font-weight: 600;
}
