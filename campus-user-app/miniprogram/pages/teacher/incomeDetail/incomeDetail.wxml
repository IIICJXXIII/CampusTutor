<!-- 收入明细页面 - incomeDetail.wxml -->
<wxs module="tools">
  // 流水类型映射
  var flowTypeMap = {
    '1': { text: '充值', icon: '+', color: '#67c23a' },
    '2': { text: '支付订单', icon: '-', color: '#f56c6c' },
    '3': { text: '课时费收入', icon: '+', color: '#67c23a' },
    '4': { text: '提现', icon: '-', color: '#f56c6c' },
    '5': { text: '退款', icon: '+', color: '#67c23a' }
  };
  module.exports.getFlowType = function(type) {
    return flowTypeMap[type + ''] || { text: '未知', icon: '', color: '#999' };
  };
  
  // 提现状态映射
  var withdrawStatusMap = {
    '0': { text: '审核中', color: '#ff9900' },
    '1': { text: '已打款', color: '#67c23a' },
    '2': { text: '已驳回', color: '#f56c6c' }
  };
  module.exports.getWithdrawStatus = function(status) {
    return withdrawStatusMap[status + ''] || { text: '未知', color: '#999' };
  };
</wxs>

<view class="container">
  <!-- 钱包概览卡片 -->
  <view class="wallet-card">
    <view class="wallet-header">
      <text class="wallet-title">我的钱包</text>
    </view>
    <view class="wallet-body">
      <view class="balance-section">
        <view class="balance-item main">
          <text class="label">可用余额</text>
          <view class="amount-row">
            <text class="symbol">¥</text>
            <text class="amount">{{walletInfo.balance || '0.00'}}</text>
          </view>
        </view>
        <view class="divider"></view>
        <view class="balance-item">
          <text class="label">冻结金额</text>
          <view class="amount-row">
            <text class="symbol small">¥</text>
            <text class="amount small">{{walletInfo.frozenAmount || '0.00'}}</text>
          </view>
        </view>
      </view>
      <view class="wallet-actions">
        <button class="btn-withdraw" bindtap="showWithdrawPopup">
          <text>提现</text>
        </button>
      </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="tabs">
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">
      <text>交易流水</text>
    </view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">
      <text>提现记录</text>
    </view>
  </view>

  <!-- 交易流水列表 -->
  <scroll-view 
    wx:if="{{currentTab === 0}}"
    class="list-container"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    bindscrolltolower="loadMoreTransactions"
    refresher-enabled
    bindrefresherrefresh="refreshTransactions"
    refresher-triggered="{{transactionRefreshing}}"
  >
    <view class="flow-list">
      <block wx:for="{{transactionList}}" wx:key="id">
        <view class="flow-item">
          <view class="flow-left">
            <view class="flow-icon" style="color: {{tools.getFlowType(item.flowType).color}}">
              {{tools.getFlowType(item.flowType).icon}}
            </view>
            <view class="flow-info">
              <text class="flow-title">{{tools.getFlowType(item.flowType).text}}</text>
              <text class="flow-time">{{item.createTime}}</text>
            </view>
          </view>
          <view class="flow-right">
            <text class="flow-amount" style="color: {{tools.getFlowType(item.flowType).color}}">
              {{item.amount >= 0 ? '+' : ''}}{{item.amount}}
            </text>
            <text class="flow-balance">余额: ¥{{item.balanceAfter}}</text>
          </view>
        </view>
      </block>
    </view>
    <view wx:if="{{!transactionLoading && transactionList.length === 0}}" class="empty-state">
      <text>暂无交易记录</text>
    </view>
    <view wx:if="{{transactionLoading}}" class="loading-more">加载中...</view>
    <view wx:if="{{!transactionHasMore && transactionList.length > 0}}" class="no-more">—— 没有更多了 ——</view>
  </scroll-view>

  <!-- 提现记录列表 -->
  <scroll-view 
    wx:if="{{currentTab === 1}}"
    class="list-container"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    bindscrolltolower="loadMoreWithdrawals"
    refresher-enabled
    bindrefresherrefresh="refreshWithdrawals"
    refresher-triggered="{{withdrawalRefreshing}}"
  >
    <view class="withdrawal-list">
      <block wx:for="{{withdrawalList}}" wx:key="id">
        <view class="withdrawal-item">
          <view class="withdrawal-left">
            <view class="withdrawal-info">
              <text class="withdrawal-amount">¥{{item.amount}}</text>
              <text class="withdrawal-channel">
                {{item.channel === 1 ? '微信' : item.channel === 2 ? '支付宝' : '银行卡'}}
              </text>
            </view>
            <text class="withdrawal-time">{{item.createTime}}</text>
          </view>
          <view class="withdrawal-right">
            <text class="withdrawal-status" style="color: {{tools.getWithdrawStatus(item.status).color}}">
              {{tools.getWithdrawStatus(item.status).text}}
            </text>
            <text wx:if="{{item.status === 2}}" class="audit-remark">{{item.auditRemark}}</text>
          </view>
        </view>
      </block>
    </view>
    <view wx:if="{{!withdrawalLoading && withdrawalList.length === 0}}" class="empty-state">
      <text>暂无提现记录</text>
    </view>
    <view wx:if="{{withdrawalLoading}}" class="loading-more">加载中...</view>
    <view wx:if="{{!withdrawalHasMore && withdrawalList.length > 0}}" class="no-more">—— 没有更多了 ——</view>
  </scroll-view>
</view>

<!-- 提现弹窗 -->
<view class="popup-mask" wx:if="{{showWithdraw}}" bindtap="hideWithdrawPopup"></view>
<view class="popup-container {{showWithdraw ? 'show' : ''}}">
  <view class="popup-header">
    <text class="popup-title">发起提现</text>
    <view class="popup-close" bindtap="hideWithdrawPopup">×</view>
  </view>
  <view class="popup-body">
    <view class="form-item">
      <text class="form-label">提现金额</text>
      <view class="form-input-wrap">
        <text class="input-prefix">¥</text>
        <input 
          class="form-input" 
          type="digit" 
          placeholder="请输入提现金额"
          value="{{withdrawForm.amount}}"
          bindinput="onAmountInput"
        />
      </view>
      <text class="form-tip">可提现余额: ¥{{walletInfo.balance || '0.00'}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">提现方式</text>
      <view class="channel-options">
        <view 
          class="channel-item {{withdrawForm.channel === 1 ? 'active' : ''}}" 
          bindtap="selectChannel" 
          data-channel="1"
        >
          <text>微信</text>
        </view>
        <view 
          class="channel-item {{withdrawForm.channel === 2 ? 'active' : ''}}" 
          bindtap="selectChannel" 
          data-channel="2"
        >
          <text>支付宝</text>
        </view>
        <view 
          class="channel-item {{withdrawForm.channel === 3 ? 'active' : ''}}" 
          bindtap="selectChannel" 
          data-channel="3"
        >
          <text>银行卡</text>
        </view>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">收款账号</text>
      <input 
        class="form-input" 
        placeholder="请输入收款账号"
        value="{{withdrawForm.accountNo}}"
        bindinput="onAccountInput"
      />
    </view>
  </view>
  <view class="popup-footer">
    <button class="btn-cancel" bindtap="hideWithdrawPopup">取消</button>
    <button class="btn-submit" bindtap="submitWithdraw" loading="{{submitLoading}}">确认提现</button>
  </view>
</view>
