/* 收入明细页面样式 - incomeDetail.wxss */
page {
  background-color: var(--bg-body);
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 钱包概览卡片 */
.wallet-card {
  margin: 32rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  border-radius: var(--radius-xl);
  padding: 40rpx;
  box-shadow: var(--shadow-primary);
  color: #fff;
  position: relative;
  overflow: hidden;
}

/* 装饰性背景圆圈 */
.wallet-card::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
}

.wallet-header {
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.wallet-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.wallet-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  position: relative;
  z-index: 1;
}

.balance-section {
  display: flex;
  align-items: center;
}

.balance-item {
  display: flex;
  flex-direction: column;
}

.balance-item .label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
}

.amount-row .symbol {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
  margin-right: 4rpx;
}

.amount-row .symbol.small {
  font-size: 24rpx;
}

.amount-row .amount {
  font-size: 64rpx;
  color: #fff;
  font-weight: 800;
  line-height: 1;
}

.amount-row .amount.small {
  font-size: 40rpx;
}

.divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 40rpx;
}

.wallet-actions {
  display: flex;
}

.btn-withdraw {
  background: rgba(255, 255, 255, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 36rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(4px);
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-withdraw:active {
  background: rgba(255, 255, 255, 0.4);
  transform: scale(0.96);
}

/* Tab 切换 */
.tabs {
  display: flex;
  background: transparent;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  margin-right: 48rpx;
  padding: 16rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: var(--text-main);
  font-weight: 700;
  font-size: 32rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(108, 99, 255, 0.3);
}

/* 列表容器 */
.list-container {
  flex: 1;
  padding: 0 32rpx;
}

/* 流水列表 */
.flow-list, .withdrawal-list {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.flow-item, .withdrawal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--bg-body);
  transition: background 0.2s;
}

.flow-item:active, .withdrawal-item:active {
  background-color: var(--bg-body);
}

.flow-item:last-child, .withdrawal-item:last-child {
  border-bottom: none;
}

.flow-left {
  display: flex;
  align-items: center;
}

.flow-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: var(--bg-body);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  margin-right: 24rpx;
}

.flow-info {
  display: flex;
  flex-direction: column;
}

.flow-title {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.flow-time {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.flow-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.flow-amount {
  font-size: 34rpx;
  font-weight: 700;
}

.flow-balance {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 提现记录列表 */
.withdrawal-left {
  display: flex;
  flex-direction: column;
}

.withdrawal-info {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.withdrawal-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 16rpx;
}

.withdrawal-channel {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg-body);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.withdrawal-time {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.withdrawal-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.withdrawal-status {
  font-size: 26rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: var(--bg-body);
}

.audit-remark {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 8rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态和加载状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: var(--text-placeholder);
  font-size: 28rpx;
}

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* 提现弹窗 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  z-index: 1000;
}

.popup-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding-bottom: env(safe-area-inset-bottom);
}

.popup-container.show {
  transform: translateY(0);
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid var(--bg-body);
}

.popup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.popup-close {
  font-size: 48rpx;
  color: var(--text-placeholder);
  line-height: 1;
  padding: 10rpx;
}

.popup-body {
  padding: 40rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 20rpx;
  font-weight: 600;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-body);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
}

.input-prefix {
  font-size: 40rpx;
  color: var(--text-main);
  font-weight: 700;
  margin-right: 16rpx;
}

.form-input {
  flex: 1;
  height: 60rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-main);
}

.form-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
}

/* 渠道选择 */
.channel-options {
  display: flex;
  gap: 20rpx;
}
.channel-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  background: var(--bg-body);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  font-weight: 500;
  transition: all 0.3s;
}

.channel-item.active {
  background: rgba(108, 99, 255, 0.05);
  border-color: var(--primary);
  color: var(--primary);
}

/* 弹窗底部按钮 */
.popup-footer {
  display: flex;
  padding: 0 40rpx 40rpx;
  gap: 32rpx;
}

.btn-cancel, .btn-submit {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.btn-cancel {
  background: var(--bg-body);
  color: var(--text-secondary);
}

.btn-submit {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  box-shadow: var(--shadow-primary);
}

.btn-submit:active {
  opacity: 0.9;
  transform: scale(0.98);
}
