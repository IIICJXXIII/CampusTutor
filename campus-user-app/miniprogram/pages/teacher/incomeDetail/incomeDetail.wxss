/* 收入明细页面样式 - incomeDetail.wxss */
page {
  background-color: #f6f7f9;
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 钱包概览卡片 */
.wallet-card {
  margin: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
}

.wallet-header {
  margin-bottom: 24rpx;
}

.wallet-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.wallet-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.balance-section {
  display: flex;
  align-items: center;
}

.balance-item {
  display: flex;
  flex-direction: column;
}

.balance-item .label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
}

.amount-row .symbol {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 4rpx;
}

.amount-row .symbol.small {
  font-size: 24rpx;
}

.amount-row .amount {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
}

.amount-row .amount.small {
  font-size: 36rpx;
}

.divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 40rpx;
}

.wallet-actions {
  display: flex;
}

.btn-withdraw {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 32rpx;
  backdrop-filter: blur(10px);
}

.btn-withdraw:active {
  background: rgba(255, 255, 255, 0.3);
}

/* Tab 切换 */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #667eea;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 2rpx;
}

/* 列表容器 */
.list-container {
  flex: 1;
  padding: 24rpx;
}

/* 流水列表 */
.flow-list {
  background: #fff;
  border-radius: 16rpx;
}

.flow-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.flow-item:last-child {
  border-bottom: none;
}

.flow-left {
  display: flex;
  align-items: center;
}

.flow-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.flow-info {
  display: flex;
  flex-direction: column;
}

.flow-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.flow-time {
  font-size: 24rpx;
  color: #999;
}

.flow-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.flow-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.flow-balance {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 提现记录列表 */
.withdrawal-list {
  background: #fff;
  border-radius: 16rpx;
}

.withdrawal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.withdrawal-item:last-child {
  border-bottom: none;
}

.withdrawal-left {
  display: flex;
  flex-direction: column;
}

.withdrawal-info {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.withdrawal-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}

.withdrawal-channel {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.withdrawal-time {
  font-size: 24rpx;
  color: #999;
}

.withdrawal-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.withdrawal-status {
  font-size: 26rpx;
  font-weight: 500;
}

.audit-remark {
  font-size: 22rpx;
  color: #f56c6c;
  margin-top: 4rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态和加载状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-more, .no-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* 提现弹窗 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.popup-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.popup-container.show {
  transform: translateY(0);
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popup-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.popup-body {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.input-prefix {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  margin-right: 12rpx;
}

.form-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
}

.form-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 渠道选择 */
.channel-options {
  display: flex;
  gap: 24rpx;
}

.channel-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.channel-item.active {
  background: rgba(102, 126, 234, 0.1);
  border-color: #667eea;
  color: #667eea;
}

/* 弹窗底部按钮 */
.popup-footer {
  display: flex;
  padding: 32rpx;
  gap: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.btn-cancel, .btn-submit {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-submit {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-submit:active {
  opacity: 0.9;
}
