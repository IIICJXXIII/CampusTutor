<view class="container">
  <view class="header">
    <text class="title">✨ AI 智能助手</text>
    <text class="subtitle">教师专属教学辅助工具</text>
  </view>
  
  <view class="feature-grid">
    <view class="feature-card" bindtap="goToLessonPlan">
      <view class="feature-icon lesson-plan">
        <text>📚</text>
      </view>
      <text class="feature-title">AI 教案生成</text>
      <text class="feature-desc">根据学生情况生成个性化教案</text>
    </view>
    
    <view class="feature-card" bindtap="goToComment">
      <view class="feature-icon comment">
        <text>💬</text>
      </view>
      <text class="feature-title">AI 评语润色</text>
      <text class="feature-desc">专业评语一键润色</text>
    </view>
    
    <view class="feature-card" bindtap="goToChat">
      <view class="feature-icon chat">
        <text>💡</text>
      </view>
      <text class="feature-title">AI 教学咨询</text>
      <text class="feature-desc">解答教学问题，提供专业建议</text>
    </view>
  </view>
  
  <view class="tips-section">
    <text class="tips-title">使用提示</text>
    <view class="tips-list">
      <view class="tip-item">
        <text class="tip-icon">•</text>
        <text class="tip-text">教案生成需要填写学生基本信息</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">•</text>
        <text class="tip-text">评语润色支持多种学科类型</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">•</text>
        <text class="tip-text">所有生成内容仅供参考，请根据实际情况调整</text>
      </view>
    </view>
  </view>
</view>