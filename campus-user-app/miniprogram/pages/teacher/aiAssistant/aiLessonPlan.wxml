<view class="container">
  <view class="header">
    <text class="title">✨ AI 教案生成</text>
    <text class="subtitle">专业教案一键生成</text>
  </view>
  
  <view class="form-section">
    <view class="form-item">
      <text class="label">教学科目</text>
      <input class="input" placeholder="例如：羽毛球" value="{{form.subject}}" bindinput="bindInput" data-field="subject"/>
    </view>
    
    <view class="form-item">
      <text class="label">学生水平</text>
      <input class="input" placeholder="例如：三年级，零基础" value="{{form.studentLevel}}" bindinput="bindInput" data-field="studentLevel"/>
    </view>
    
    <view class="form-item">
      <text class="label">课时时长</text>
      <input class="input" placeholder="例如：60分钟" value="{{form.duration}}" bindinput="bindInput" data-field="duration"/>
    </view>
    
    <view class="form-item">
      <text class="label">学生情况</text>
      <textarea class="textarea" placeholder="例如：第一次上课，身体协调性一般" value="{{form.studentInfo}}" bindinput="bindInput" data-field="studentInfo"/>
    </view>
  </view>
  
  <view class="action-section">
    <button class="btn-generate" bindtap="generatePlan" loading="{{loading}}">
      {{loading ? '生成中...' : '生成教案'}}
    </button>
  </view>
  
  <view class="result-section" wx:if="{{result}}">
    <text class="result-title">生成结果</text>
    <view class="result-content">{{result}}</view>
    <button class="btn-copy" bindtap="copyResult">复制教案</button>
  </view>
</view>