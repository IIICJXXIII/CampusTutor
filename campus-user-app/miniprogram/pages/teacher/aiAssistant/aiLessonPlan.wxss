/* AI教案生成页面样式 */
page {
  background: #F8F9FA;
  --primary: #1E6F9F;
  --primary-light: #E8F8F5;
  --accent: #f093fb;
  --accent-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.container {
  padding: 24rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  background: var(--accent-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: #64748B;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2D3748;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #E2E8F0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #4A5568;
  background: #FAFAFA;
}

.input:focus {
  border-color: var(--primary);
  background: #fff;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #E2E8F0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 24rpx;
  color: #4A5568;
  background: #FAFAFA;
  resize: none;
}

.textarea:focus {
  border-color: var(--primary);
  background: #fff;
}

.action-section {
  margin-bottom: 32rpx;
}

.btn-generate {
  width: 100%;
  height: 96rpx;
  background: var(--accent-gradient);
  color: #fff;
  border: none;
  border-radius: 80rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(240, 147, 251, 0.4);
}

.btn-generate:active {
  transform: scale(0.98);
}

.result-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  margin-bottom: 40rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 16rpx;
  display: block;
}

.result-content {
  font-size: 24rpx;
  line-height: 1.6;
  color: #4A5568;
  white-space: pre-wrap;
  margin-bottom: 24rpx;
  min-height: 200rpx;
}

.btn-copy {
  width: 100%;
  height: 80rpx;
  background: var(--primary-light);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-copy:active {
  background: var(--primary);
  color: #fff;
}