<view class="container">
  <view class="header">
    <text class="title">✨ AI 评语润色</text>
    <text class="subtitle">专业评语一键润色</text>
  </view>
  
  <view class="form-section">
    <view class="form-item">
      <text class="label">原始评语</text>
      <textarea class="textarea" placeholder="例如：今天练了跳绳，经常绊脚，手摇得太高" value="{{form.rawComment}}" bindinput="bindInput" data-field="rawComment"/>
    </view>
    
    <view class="form-item">
      <text class="label">教学科目</text>
      <input class="input" placeholder="例如：跳绳" value="{{form.subject}}" bindinput="bindInput" data-field="subject"/>
    </view>
    
    <view class="form-item">
      <text class="label">学生情况</text>
      <input class="input" placeholder="例如：三年级学生，第一次学跳绳" value="{{form.studentInfo}}" bindinput="bindInput" data-field="studentInfo"/>
    </view>
  </view>
  
  <view class="action-section">
    <button class="btn-generate" bindtap="polishComment" loading="{{loading}}">
      {{loading ? '润色中...' : '润色评语'}}
    </button>
  </view>
  
  <view class="result-section" wx:if="{{result}}">
    <text class="result-title">润色结果</text>
    <view class="result-content">{{result}}</view>
    <button class="btn-copy" bindtap="copyResult">复制评语</button>
  </view>
</view>