<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="header-left" bindtap="navigateBack">
      <text class="back-icon">←</text>
    </view>
    <view class="header-center">
      <text class="title">提现</text>
    </view>
    <view class="header-right"></view>
  </view>

  <!-- 余额信息 -->
  <view class="balance-section">
    <text class="balance-label">可用余额</text>
    <text class="balance-amount">¥{{balance}}</text>
  </view>

  <!-- 提现金额 -->
  <view class="form-section">
    <text class="form-label">提现金额</text>
    <view class="amount-input">
      <text class="amount-symbol">¥</text>
      <input 
        class="amount-input" 
        type="number" 
        placeholder="请输入提现金额" 
        value="{{amount}}"
        bindinput="handleAmountInput"
      />
    </view>
  </view>

  <!-- 提现渠道 -->
  <view class="form-section">
    <text class="form-label">提现渠道</text>
    <view class="channel-list">
      <view 
        wx:for="{{channels}}" 
        wx:key="id"
        class="channel-item {{selectedChannel === item.id ? 'active' : ''}}"
        bindtap="selectChannel"
        data-id="{{item.id}}"
      >
        <text class="channel-name">{{item.name}}</text>
        <view class="channel-radio {{selectedChannel === item.id ? 'checked' : ''}}"></view>
      </view>
    </view>
  </view>

  <!-- 收款账号 -->
  <view class="form-section">
    <text class="form-label">收款账号</text>
    <input 
      class="account-input" 
      placeholder="请输入收款账号" 
      value="{{accountNo}}"
      bindinput="handleAccountInput"
    />
  </view>

  <!-- 支付密码 -->
  <view class="form-section">
    <text class="form-label">支付密码</text>
    <input 
      class="password-input" 
      type="password" 
      placeholder="请输入支付密码" 
      value="{{payPassword}}"
      bindinput="handlePasswordInput"
    />
  </view>

  <!-- 提现规则 -->
  <view class="rules-section">
    <view wx:for="{{rules}}" wx:key="index" class="rule-item">
      <text class="rule-title">{{item.title}}</text>
      <text class="rule-desc">{{item.desc}}</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button 
      class="submit-btn" 
      bindtap="submitWithdraw"
      loading="{{isSubmitting}}"
      disabled="{{isSubmitting}}"
    >
      提交提现申请
    </button>
    <text class="record-link" bindtap="goToWithdrawRecord">查看提现记录</text>
  </view>
</view>
