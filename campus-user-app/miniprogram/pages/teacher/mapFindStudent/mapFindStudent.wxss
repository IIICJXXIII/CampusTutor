.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.map {
  flex: 1;
  width: 100%;
  min-height: 50vh;
}

.footer-panel {
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  padding: 30rpx;
  min-height: 300rpx; /* 保证空状态也有高度 */
  position: relative;
  z-index: 10;
  margin-top: -20rpx; /* 稍微盖住地图一点 */
}

/* 需求卡片样式 */
.demand-card {
  display: flex;
  flex-direction: column;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 20rpx;
}

.title-row {
  display: flex;
  align-items: center;
}

.subject {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.grade-tag {
  font-size: 22rpx;
  color: #409EFF;
  background: #ecf5ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.price {
  font-size: 36rpx;
  color: #f56c6c;
  font-weight: bold;
}

.unit {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.info-list {
  margin-bottom: 30rpx;
}

.info-item {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.label {
  color: #999;
  width: 90rpx;
  flex-shrink: 0;
}

.val {
  color: #333;
  flex: 1;
}

.val.addr, .val.desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 按钮组 */
.btn-row {
  display: flex;
  justify-content: space-between;
}

.btn {
  width: 46%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin: 0;
}

.btn.chat {
  background: #f0f9eb;
  color: #67c23a;
}

.btn.accept {
  background: #409EFF;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.3);
}

/* 空状态样式 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 20rpx;
}

.empty-text {
  text-align: center;
  margin-bottom: 30rpx;
}

.main-tip {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.sub-tip {
  font-size: 26rpx;
  color: #999;
}

.btn.refresh {
  width: 240rpx;
  background: #f5f7fa;
  color: #666;
  border: 1rpx solid #dcdfe6;
}