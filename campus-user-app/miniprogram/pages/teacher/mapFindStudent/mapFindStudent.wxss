/* 地图找生源样式 - mapFindStudent.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-body);
}

.map {
  flex: 1;
  width: 100%;
}

/* 底部面板 */
.footer-panel {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top-left-radius: var(--radius-xl);
  border-top-right-radius: var(--radius-xl);
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.1);
  padding: 32rpx;
  min-height: 380rpx;
  position: relative;
  z-index: 10;
  margin-top: -30rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 装饰性拉手 */
.footer-panel::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 8rpx;
  background-color: #E2E8F0;
  border-radius: 4rpx;
}

/* 需求卡片样式 */
.demand-card {
  display: flex;
  flex-direction: column;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-top: 16rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.subject {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 1rpx;
}

.grade-tag {
  padding: 6rpx 16rpx;
  background-color: var(--primary-fade);
  color: var(--primary);
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.price {
  font-size: 44rpx;
  color: var(--secondary);
  font-weight: 800;
}

.unit {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  margin-left: 4rpx;
}

.info-list {
  margin-bottom: 40rpx;
}

.info-item {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  align-items: flex-start;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  color: var(--text-placeholder);
  width: 100rpx;
  flex-shrink: 0;
}

.val {
  color: var(--text-main);
  flex: 1;
  font-weight: 500;
  line-height: 1.4;
}

.val.addr, .val.desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 按钮组 */
.btn-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin: 0;
  transition: all 0.3s;
}

.btn.detail {
  background: var(--bg-body);
  color: var(--text-main);
  border: 1rpx solid var(--border);
}

.btn.chat {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  box-shadow: var(--shadow-primary);
  border: none;
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 查看列表按钮 */
.list-entry {
  padding-top: 8rpx;
}

.btn.view-list {
  width: 100%;
  background: transparent;
  color: var(--primary);
  font-size: 28rpx;
  height: auto;
  padding: 20rpx 0;
}

.btn.view-list::after {
  content: ' >';
  font-family: monospace;
  margin-left: 8rpx;
}

/* 空状态样式 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-text {
  text-align: center;
  margin-bottom: 40rpx;
}

.main-tip {
  display: block;
  font-size: 36rpx;
  color: var(--text-main);
  font-weight: 700;
  margin-bottom: 12rpx;
}

.sub-tip {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.btn.refresh {
  width: 240rpx;
  height: 80rpx;
  background: var(--bg-card);
  color: var(--text-main);
  border: 1rpx solid var(--border);
  border-radius: 40rpx;
  font-size: 28rpx;
  box-shadow: var(--shadow-sm);
}

