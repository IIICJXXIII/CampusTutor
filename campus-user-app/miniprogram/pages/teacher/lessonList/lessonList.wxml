<!-- 教师课时列表页面 -->
<view class="container">
  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{stats.total || 0}}</text>
      <text class="stat-label">总课时</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.confirmed || 0}}</text>
      <text class="stat-label">已确认</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.pending || 0}}</text>
      <text class="stat-label">待确认</text>
    </view>
  </view>

  <!-- 课时列表 -->
  <view class="list-section">
    <view class="section-title">课时记录</view>
    
    <view class="lesson-list" wx:if="{{lessonList.length > 0}}">
      <block wx:for="{{lessonList}}" wx:key="id">
        <view class="lesson-card" bindtap="goToDetail" data-id="{{item.id}}">
          <view class="lesson-header">
            <text class="lesson-index">第{{item.lessonIndex}}节课</text>
            <view class="lesson-status {{item.status === 1 ? 'confirmed' : item.status === 2 ? 'disputed' : 'pending'}}">
              {{item.statusText || (item.status === 1 ? '已确认' : item.status === 2 ? '申诉中' : '待确认')}}
            </view>
          </view>
          <view class="lesson-info">
            <view class="info-row">
              <text class="info-label">上课时间</text>
              <text class="info-value">{{item.startTimeText || '--'}}</text>
            </view>
            <view class="info-row" wx:if="{{item.endTime}}">
              <text class="info-label">下课时间</text>
              <text class="info-value">{{item.endTimeText || '--'}}</text>
            </view>
          </view>
          <view class="lesson-action" wx:if="{{item.status === 0 && !item.endTime}}">
            <button class="btn-checkout-mini" catchtap="goToCheckOut" data-item="{{item}}">
              下课打卡
            </button>
          </view>
        </view>
      </block>
    </view>

    <view class="empty-tip" wx:else>
      <text>暂无课时记录</text>
    </view>
  </view>

  <!-- 底部打卡按钮 -->
  <view class="bottom-action">
    <button class="btn-new-checkin" bindtap="goToCheckIn">
      开始新课打卡
    </button>
  </view>
</view>
