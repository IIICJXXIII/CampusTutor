/* 教师课时列表样式 - 简约专业风 */
page {
  background: #F8F9FA;
  --prof-primary: #1E6F9F;
  --prof-secondary: #E8F8F5;
  --prof-border: #E2E8F0;
  --prof-card-bg: #FFFFFF;
}

.container {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 统计卡片 */
/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #1E6F9F 0%, #165B85 100%); /* Deep Blue Gradient */
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(30, 111, 159, 0.25);
  color: white;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 10%;
  height: 80%;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.2);
}

.stat-value {
  font-size: 48rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  letter-spacing: 1rpx;
}

/* 列表区域 */
.list-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid var(--prof-border);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 20rpx;
}

/* 课时卡片 */
.lesson-card {
  background: #F8F9FA;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E2E8F0;
}

.lesson-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3748;
}

.lesson-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  font-weight: 500;
}

.lesson-status.pending {
  background: #FFF;
  color: #FF7F50;
  border: 1rpx solid #FF7F50;
}

.lesson-status.confirmed {
  background: var(--prof-secondary);
  color: var(--prof-primary);
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #A0AEC0;
  font-size: 28rpx;
}
.empty-tip::before {
  content: '📝'; /* Simple icon placeholder */
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
  filter: grayscale(1);
}

/* 底部按钮 */
.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-top: 1rpx solid var(--prof-border);
}

.btn-new-checkin {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--prof-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 8rpx;
  border: none;
}
.btn-new-checkin:active {
  background: #165b85;
}
