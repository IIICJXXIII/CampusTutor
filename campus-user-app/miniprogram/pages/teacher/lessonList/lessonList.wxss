/* 教师课时列表样式 */
page {
  background: #f8f9fc;
}

.container {
  padding: 32rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.25);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 列表区域 */
.list-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

/* 课时卡片 */
.lesson-card {
  background: #f8f9fc;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.lesson-card:last-child {
  margin-bottom: 0;
}

.lesson-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.lesson-index {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.lesson-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.lesson-status.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.lesson-status.confirmed {
  background: #f0f9eb;
  color: #52c41a;
}

.lesson-status.disputed {
  background: #fff1f0;
  color: #f5222d;
}

.lesson-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #666;
}

.lesson-action {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-checkout-mini {
  font-size: 26rpx;
  color: #667eea;
  background: #fff;
  border: 1rpx solid #667eea;
  border-radius: 30rpx;
  padding: 0 32rpx;
  height: 60rpx;
  line-height: 58rpx;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 底部按钮 */
.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn-new-checkin {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
}
