<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{order}}" class="detail-box">
    <text class="order-no">订单号：{{order.orderNo}}</text>
    <view class="row"><text>学生：{{order.studentName}}</text><text>科目：{{order.subject}}</text></view>
    <view class="row"><text>课时：{{order.totalHours}}</text><text>单价：{{order.unitPrice}} 元</text></view>
    <view class="row"><text>总额：{{order.totalAmount}} 元</text><text>状态：{{statusText}}</text></view>
    <view class="divider"></view>

    <view class="actions">
      <button class="btn btn-primary" wx:if="{{order.status === 1}}" bindtap="startClass">确认开课</button>
      <button class="btn" wx:if="{{order.status === 2}}" bindtap="markComplete">标记已完成</button>
    </view>
  </view>
</view>