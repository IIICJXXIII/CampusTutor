/* 教师课时打卡页面样式 - 简约专业风 */
page {
  background: #F8F9FA; /* Light Grey Clean BG */
  --prof-primary: #1E6F9F; /* Deep Blue - Professional */
  --prof-primary-dark: #165b85;
  --prof-secondary: #E8F8F5; /* Mint Green - Auxiliary */
  --prof-warning: #FF7F50; /* Coral Orange - Alert */
  --prof-text-main: #2D3748;
  --prof-text-sub: #8C8177;
  --prof-border: #E2E8F0;
  --prof-radius: 12rpx; /* 8px ~ 16rpx, adjusted to fit 12rpx for cards */
}

.container {
  padding: 24rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 订单卡片 */
.order-card {
  background: var(--prof-primary); /* Flat Deep Blue */
  border-radius: var(--prof-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(30, 111, 159, 0.2); /* Minimal Shadow */
}

.order-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-subject {
  font-size: 34rpx; /* Slightly smaller, more precise */
  font-weight: 700;
  margin-right: 16rpx;
}

.order-grade {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-item {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 通用卡片 - Clean Style */
.location-card,
.photo-card,
.content-card {
  background: #fff;
  border-radius: var(--prof-radius);
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05); /* Very subtle shadow */
  border: 1rpx solid #F0F0F0;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--prof-text-main);
  margin-bottom: 20rpx;
}

.card-title .icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

/* 定位区域 */
.location-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
  border: 1rpx solid var(--prof-border);
}

.location-text {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  font-family: monospace; /* Technical feel for coords */
}

.refresh-btn {
  font-size: 24rpx;
  color: var(--prof-primary);
  background: #fff;
  border: 1rpx solid var(--prof-primary);
  border-radius: 8rpx; /* Sharper corners */
  padding: 0 20rpx;
  line-height: 1.8;
}

.location-tip {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  color: #198754; /* Standard success green */
  font-size: 24rpx;
}

.tip-icon {
  margin-right: 8rpx;
}

/* 拍照区域 */
.photo-area {
  width: 100%;
  height: 360rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed #CFD8DC;
}

.photo-preview {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #A0AEC0;
}

.photo-icon {
  font-size: 64rpx;
  color: #A0AEC0;
  line-height: 1;
}

.photo-text {
  font-size: 26rpx;
  margin-top: 12rpx;
}

.photo-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
  display: block;
}

/* 教学内容输入 */
.content-input {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--prof-border);
}

/* 操作按钮 */
.action-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  border-top: 1rpx solid #E2E8F0;
}

.btn-checkin {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--prof-primary); /* Deep Blue */
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx; /* 8px */
  border: none;
  transition: background 0.2s;
}

.btn-checkin:active {
  background: var(--prof-primary-dark);
}

.btn-checkin[disabled] {
  background: #CFD8DC;
  color: #FFF;
}

.btn-checkout {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #198754; /* Success Green */
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.btn-checkout:active {
  background: #157347;
}

/* 选择订单卡片 */
.select-order-card {
  background: #fff;
  border-radius: var(--prof-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
  border: 2rpx dashed var(--prof-primary);
}

.select-order-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.select-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.select-text {
  font-size: 28rpx;
  color: var(--prof-primary);
  font-weight: 600;
}

.select-arrow {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}

.change-order {
  margin-left: auto;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(0, 0, 0, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* 订单选择弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content.order-picker {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.order-picker-list {
  max-height: 60vh;
}

.order-picker-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E2E8F0;
}

.order-picker-item:active {
  background: var(--prof-secondary);
  border-color: var(--prof-primary);
}

.picker-item-main {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.picker-subject {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.picker-grade {
  font-size: 22rpx;
  color: var(--prof-primary);
  background: var(--prof-secondary);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.picker-item-sub {
  font-size: 24rpx;
  color: #666;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

.modal-close-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #F8F9FA;
  color: #666;
  font-size: 30rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
  border: 1rpx solid #E2E8F0;
}
