<!-- 教师课时打卡页面 -->
<view class="container">
  <!-- 选择订单卡片 -->
  <view class="select-order-card" wx:if="{{!orderId}}" bindtap="showOrderPicker">
    <view class="select-order-content">
      <text class="select-icon">📚</text>
      <text class="select-text">点击选择要打卡的订单</text>
      <text class="select-arrow">></text>
    </view>
  </view>

  <!-- 已选订单信息卡片 -->
  <view class="order-card" wx:if="{{orderInfo.id}}" bindtap="showOrderPicker">
    <view class="order-header">
      <text class="order-subject">{{orderInfo.subject}}</text>
      <text class="order-grade">{{orderInfo.grade}}</text>
      <text class="change-order">更换</text>
    </view>
    <view class="order-info">
      <text class="info-item">学生: {{orderInfo.studentName || '未知'}}</text>
      <text class="info-item">已上 {{orderInfo.usedHours || 0}}/{{orderInfo.totalHours || 0}} 课时</text>
    </view>
  </view>

  <!-- 定位信息 -->
  <view class="location-card">
    <view class="card-title">
      <text class="icon">📍</text>
      <text>当前位置</text>
    </view>
    <view class="location-content">
      <text class="location-text" wx:if="{{location.latitude}}">
        经度: {{location.longitude.toFixed(6)}}
        纬度: {{location.latitude.toFixed(6)}}
      </text>
      <text class="location-text" wx:else>正在获取位置...</text>
      <button class="refresh-btn" size="mini" bindtap="refreshLocation">重新定位</button>
    </view>
    <view class="location-tip" wx:if="{{location.latitude}}">
      <text class="tip-icon">✓</text>
      <text>定位成功</text>
    </view>
  </view>

  <!-- 拍照区域 -->
  <view class="photo-card">
    <view class="card-title">
      <text class="icon">📷</text>
      <text>现场拍照</text>
    </view>
    <view class="photo-area" bindtap="takePhoto">
      <image wx:if="{{photoUrl}}" src="{{photoUrl}}" mode="aspectFill" class="photo-preview"/>
      <view wx:else class="photo-placeholder">
        <text class="photo-icon">+</text>
        <text class="photo-text">点击拍照</text>
      </view>
    </view>
    <text class="photo-tip">请拍摄授课现场照片作为打卡凭证</text>
  </view>

  <!-- 教学内容（下课时填写） -->
  <view class="content-card" wx:if="{{checkInRecordId}}">
    <view class="card-title">
      <text class="icon">📝</text>
      <text>教学记录</text>
    </view>
    <textarea class="content-input" placeholder="请填写本节课教学内容摘要..." 
              bindinput="onContentInput" value="{{contentSummary}}" maxlength="500"/>
    <textarea class="content-input" placeholder="请填写布置的作业（选填）..." 
              bindinput="onHomeworkInput" value="{{homeworkAssigned}}" maxlength="200"/>
  </view>

  <!-- 操作按钮 -->
  <view class="action-area">
    <button class="btn-checkin" wx:if="{{!checkInRecordId}}" 
            bindtap="handleCheckIn" loading="{{isSubmitting}}" 
            disabled="{{!location.latitude || !photoUrl || isSubmitting}}">
      开始上课打卡
    </button>
    <button class="btn-checkout" wx:else 
            bindtap="handleCheckOut" loading="{{isSubmitting}}" 
            disabled="{{isSubmitting}}">
      结束下课打卡
    </button>
  </view>
</view>

<!-- 订单选择弹窗 -->
<view class="modal-mask" wx:if="{{showOrderPicker}}" bindtap="hideOrderPicker">
  <view class="modal-content order-picker" catchtap="">
    <view class="modal-title">选择订单</view>
    <scroll-view class="order-picker-list" scroll-y>
      <view class="order-picker-item" wx:for="{{orderList}}" wx:key="id" 
            bindtap="selectOrder" data-order="{{item}}">
        <view class="picker-item-main">
          <text class="picker-subject">{{item.subject}}</text>
          <text class="picker-grade">{{item.grade}}</text>
        </view>
        <view class="picker-item-sub">
          <text>{{item.studentName || '学生'}} · 已上{{item.usedHours || 0}}/{{item.totalHours || 0}}课时</text>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{orderList.length === 0}}">
        <text>暂无进行中的订单</text>
      </view>
    </scroll-view>
    <button class="modal-close-btn" bindtap="hideOrderPicker">取消</button>
  </view>
</view>
