/* 教师订单列表样式 - 简约专业风 */
page {
  background-color: #F8F9FA;
  --prof-primary: #1E6F9F;
  --prof-secondary: #E8F8F5;
  --prof-card-bg: #FFFFFF;
  --prof-border: #E2E8F0;
}

/* 顶部 Tab */
.tabs {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 88rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 100;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.05); /* Minimal shadow */
  border-bottom: 1rpx solid var(--prof-border);
}

.tab-item {
  font-size: 28rpx;
  color: #666;
  height: 88rpx;
  line-height: 88rpx;
  position: relative;
}

.tab-item.active {
  color: var(--prof-primary);
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: var(--prof-primary); /* Deep Blue */
  border-radius: 2rpx;
}

.container {
  padding-top: 108rpx; /* 留出 Tab 高度 */
  padding-bottom: 40rpx;
}

.order-list {
  padding: 0 24rpx;
}

/* 订单卡片 */
.order-card {
  background: var(--prof-card-bg);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.05);
  border: 1rpx solid var(--prof-border);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #F0F0F0;
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.order-no {
  font-size: 24rpx;
  color: #909399;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-text {
  font-size: 26rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background: #F8F9FA;
}

.course-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3748;
  margin-bottom: 12rpx;
}
/* Tabs Interaction */
.tab-item:active {
  background-color: #FAFAFA;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  items-align: center;
  justify-content: center;
  padding-top: 200rpx;
  text-align: center;
}

.empty-state::before {
  content: '';
  display: block;
  width: 200rpx;
  height: 200rpx;
  background-color: #EDF2F7; /* Placeholder for image */
  border-radius: 50%;
  margin: 0 auto 32rpx;
  background-image: radial-gradient(circle at 30% 30%, #E2E8F0 10%, transparent 10%); /* Simple graphic */
}

.empty-state text {
  font-size: 30rpx;
  color: #A0AEC0;
  font-weight: 500;
}

.card-footer {
  border-top: 1rpx solid #F0F0F0;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.price-box .label {
  font-size: 24rpx;
  color: #909399;
}

.price-box .symbol {
  font-size: 24rpx;
  color: #E53E3E;
  margin-left: 8rpx;
}

.price-box .amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #E53E3E;
}

.btn-group {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  flex-wrap: wrap;
}

/* Buttons */
.btn {
  font-size: 24rpx;
  padding: 0 16rpx;
  height: 56rpx;
  border-radius: 8rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.btn.primary {
  background: var(--prof-primary);
  color: #fff;
  border: 1rpx solid var(--prof-primary);
}

.btn.plain {
  background: #fff;
  border: 1rpx solid #DCDFE6;
  color: #606266;
}