page {
  background-color: #f6f7f9;
}

/* 顶部 Tab */
.tabs {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 88rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.tab-item {
  font-size: 28rpx;
  color: #666;
  height: 88rpx;
  line-height: 88rpx;
  position: relative;
}

.tab-item.active {
  color: #409EFF;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #409EFF;
  border-radius: 2rpx;
}

/* 列表容器 */
.container {
  padding-top: 108rpx; /* 留出 Tab 高度 */
  padding-bottom: 40rpx;
}

.order-list {
  padding: 0 24rpx;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.status-text {
  font-size: 26rpx;
  font-weight: bold;
}

.card-body {
  margin-bottom: 20rpx;
}

.course-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  margin-bottom: 8rpx;
}

.info-row .label {
  font-size: 26rpx;
  color: #999;
}

.info-row .value {
  font-size: 26rpx;
  color: #666;
  margin-left: 10rpx;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
}
.price-box .label { font-size: 24rpx; color: #999; }
.price-box .symbol { font-size: 24rpx; color: #f56c6c; font-weight: bold; }
.price-box .amount { font-size: 36rpx; color: #f56c6c; font-weight: bold; }

.btn-group {
  display: flex;
}

.btn {
  margin: 0 0 0 16rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 54rpx; /* border考虑 */
  border-radius: 28rpx;
}

.btn.plain {
  background: #fff;
  border: 1rpx solid #dcdfe6;
  color: #606266;
}

.btn.primary {
  background: #409EFF;
  color: #fff;
  border: 1rpx solid #409EFF;
}

.btn.disabled {
  background: #f5f7fa;
  border-color: #e4e7ed;
  color: #c0c4cc;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding-top: 100rpx;
  color: #999;
  font-size: 28rpx;
}

.loading-more, .no-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}