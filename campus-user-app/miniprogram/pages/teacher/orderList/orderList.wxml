<wxs module="tools">
  var statusMap = {
    '-1': { text: '待确认', color: '#909399' },
    '0': { text: '待支付', color: '#ff9900' },
    '1': { text: '待开课', color: '#409EFF' },
    '2': { text: '进行中', color: '#67c23a' },
    '3': { text: '已完成', color: '#909399' },
    '4': { text: '已取消', color: '#c0c4cc' },
    '5': { text: '退款中', color: '#e6a23c' },
    '6': { text: '已退款', color: '#909399' }
  };
  module.exports.getStatus = function(status) {
    return statusMap[status + ''] || { text: '未知', color: '#333' };
  }
</wxs>

<view class="tabs">
  <view class="tab-item {{status === null ? 'active' : ''}}" bindtap="filterAll" data-status="-1">全部</view>
  <view class="tab-item {{status === -1 ? 'active' : ''}}" bindtap="filterStatus" data-status="-1">待确认</view>
  <view class="tab-item {{status === 0 ? 'active' : ''}}" bindtap="filterStatus" data-status="0">待支付</view>
  <view class="tab-item {{status === 1 ? 'active' : ''}}" bindtap="filterStatus" data-status="1">待开课</view>
  <view class="tab-item {{status === 2 ? 'active' : ''}}" bindtap="filterStatus" data-status="2">进行中</view>
</view>

<view class="container">
  <view class="order-list">
    <block wx:for="{{list}}" wx:key="id">
      <view class="order-card" bindtap="goDetail" data-id="{{item.id}}">
        <view class="card-header">
          <text class="order-no">订单号：{{item.orderNo}}</text>
          <text class="status-text" style="color: {{tools.getStatus(item.status).color}}">{{tools.getStatus(item.status).text}}</text>
        </view>

        <view class="card-body">
          <view class="course-title">{{item.subject}} - {{item.grade}}</view>
          <view class="info-row">
            <text class="label">课时安排：</text>
            <text class="value">{{item.totalHours}} 课时 ({{item.teachMode === 1 ? '线下上门' : '在线授课'}})</text>
          </view>
          <view class="info-row">
            <text class="label">下单时间：</text>
            <text class="value">{{item.createTime}}</text>
          </view>
        </view>

        <view class="card-footer">
          <view class="price-box">
            <text class="label">总价：</text>
            <text class="symbol">¥</text>
            <text class="amount">{{item.totalAmount}}</text>
          </view>

          <view class="btn-group">
            <block wx:if="{{item.status === -1}}">
              <button class="btn plain" catchtap="handleCancel" data-id="{{item.id}}" data-status="{{item.status}}">取消接单</button>
            </block>
            
            <block wx:if="{{item.status === 1}}">
              <button class="btn plain" catchtap="handleCancel" data-id="{{item.id}}" data-status="{{item.status}}">取消订单</button>
              <button class="btn primary" catchtap="startClass" data-id="{{item.id}}">确认开课</button>
            </block>
            
            <block wx:if="{{item.status === 2}}">
              <button class="btn primary" catchtap="handleComplete" data-id="{{item.id}}">确认结课</button>
            </block>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && list.length === 0}}" class="empty-state">暂无订单</view>

    <view wx:if="{{loading}}" class="loading-more">加载中...</view>
    <view wx:if="{{!hasMore && list.length > 0}}" class="no-more">—— 没有更多了 ——</view>
  </view>
</view>