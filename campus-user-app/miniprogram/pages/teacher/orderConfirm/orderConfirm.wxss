.container {
  min-height: 100vh;
  background-color: #f6f7f9;
  padding: 20rpx 30rpx 140rpx;
}

.header {
  position: relative;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  display: block;
}

.back-btn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #333;
}

.loading, .error {
  height: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.error button {
  margin-top: 20rpx;
  padding: 0 40rpx;
}

/* 需求信息卡片 */
.demand-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.demand-card .row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.demand-card .subject {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.demand-card .grade {
  font-size: 28rpx;
  color: #666;
  background: #f0f9eb;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.demand-card .price {
  font-size: 36rpx;
  color: #f56c6c;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.demand-card .address {
  font-size: 24rpx;
  color: #999;
  line-height: 36rpx;
}

/* 表单区域 */
.form-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
}

.input-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.input-group.vertical {
  display: block;
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  color: #333;
}

/* 课时步进器 */
.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 50rpx;
  height: 50rpx;
  background: #f5f7fa;
  text-align: center;
  line-height: 50rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.step-btn.disabled {
  color: #ccc;
  background: #fcfcfc;
}

.step-input {
  width: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 单选框 */
.radio-group {
  display: flex;
}

.radio-item {
  margin-left: 20rpx;
  padding: 8rpx 30rpx;
  background: #f5f7fa;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  border: 1px solid transparent;
}

.radio-item.active {
  background: #ecf5ff;
  color: #409EFF;
  border-color: #409EFF;
}

/* 备注输入框 */
.remark-input {
  width: 100%;
  height: 160rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 协议签署 */
.protocol-group {
  padding: 34rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.checkbox-label {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.protocol-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 36rpx;
}

checkbox {
  margin-top: 6rpx;
  transform: scale(0.8);
}

/* 底部栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-sizing: border-box;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 10;
  padding-bottom: env(safe-area-inset-bottom);
}

.total-box {
  font-size: 28rpx;
  color: #333;
}

.total-box .symbol {
  color: #f56c6c;
  font-weight: bold;
}

.total-box .amount {
  color: #f56c6c;
  font-size: 40rpx;
  font-weight: bold;
}

.submit-btn {
  margin: 0;
  background: #409EFF;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.submit-btn:disabled {
  background: #c0c4cc;
}