.result-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
  background: #fff;
  height: 100vh;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-top: 30rpx;
}
.desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  padding: 30rpx 60rpx;
  line-height: 1.6;
}
.home-btn {
  margin-top: 60rpx;
  background: #fff;
  color: #409EFF;
  border: 1px solid #409EFF;
  width: 300rpx;
  border-radius: 44rpx;
}