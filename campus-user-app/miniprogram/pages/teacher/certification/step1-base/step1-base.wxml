<view class="container">
  <view class="step-header">
    <view class="step-item active">
      <view class="step-num">1</view>
      <text>基础信息</text>
    </view>
    <view class="step-line"></view>
    <view class="step-item">
      <view class="step-num">2</view>
      <text>能力证明</text>
    </view>
    <view class="step-line"></view>
    <view class="step-item">
      <view class="step-num">3</view>
      <text>提交审核</text>
    </view>
  </view>

  <view class="form-box">
    <view class="section-title">身份信息</view>
    <view class="input-group">
      <view class="label">真实姓名</view>
      <input class="input" placeholder="请输入真实姓名" bindinput="handleInput" data-field="realName" value="{{formData.realName}}" />
    </view>
    <view class="input-group">
      <view class="label">身份证号</view>
      <input class="input" type="idcard" placeholder="请输入身份证号" bindinput="handleInput" data-field="idCard" value="{{formData.idCard}}" />
    </view>

    <view class="section-title">学历信息</view>
    <view class="input-group">
      <view class="label">就读高校</view>
      <input class="input" placeholder="例如：北京大学" bindinput="handleInput" data-field="universityName" value="{{formData.universityName}}" />
    </view>
    <view class="input-group">
      <view class="label">专业名称</view>
      <input class="input" placeholder="例如：计算机科学与技术" bindinput="handleInput" data-field="major" value="{{formData.major}}" />
    </view>
    
    <view class="input-group">
      <view class="label">当前学历</view>
      <picker bindchange="handleEducationChange" value="{{educationIndex}}" range="{{educationList}}">
        <view class="picker {{educationIndex === -1 ? 'placeholder' : ''}}">
          {{educationIndex === -1 ? '请选择学历' : educationList[educationIndex]}}
        </view>
      </picker>
    </view>

    <view class="input-group">
      <view class="label">入学年份</view>
      <picker mode="date" fields="year" bindchange="handleYearChange">
         <view class="picker {{!formData.enrollYear ? 'placeholder' : ''}}">
          {{formData.enrollYear || '请选择入学年份'}}
        </view>
      </picker>
    </view>

    <view class="section-title">证件上传 (学生证/校园卡)</view>
    <view class="upload-tip" wx:if="{{!formData.studentCardUrl}}">📷 上传学生证后将自动识别填充信息</view>
    <view class="upload-area" bindtap="chooseImage">
      <image wx:if="{{formData.studentCardUrl}}" src="{{formData.studentCardUrl}}" mode="aspectFill" class="preview-img"></image>
      <view wx:elif="{{isRecognizing}}" class="upload-placeholder">
        <text class="text">识别中...</text>
      </view>
      <view wx:else class="upload-placeholder">
        <text class="icon">+</text>
        <text class="text">点击上传学生证正面</text>
      </view>
    </view>
  </view>

  <button class="next-btn" bindtap="nextStep">下一步</button>
</view>