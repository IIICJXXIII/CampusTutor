.container {
  padding-bottom: 40rpx;
}

/* 步骤条样式 - 通用，建议提取到 app.wxss 或 组件 */
.step-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  background: #fff;
  margin-bottom: 20rpx;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}
.step-item.active {
  color: #409EFF;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eee;
  color: #666;
  text-align: center;
  line-height: 40rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}
.step-item.active .step-num {
  background: #409EFF;
  color: #fff;
}
.step-line {
  width: 60rpx;
  height: 2rpx;
  background: #eee;
  margin: -30rpx 20rpx 0;
}

/* 表单样式 */
.form-box {
  background: #fff;
  padding: 30rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #409EFF;
}
.input-group {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
}
.input, .picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.placeholder {
  color: #ccc;
}

/* 上传区域 */
.upload-area {
  width: 100%;
  height: 300rpx;
  background: #f9f9f9;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}
.upload-placeholder .icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}
.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.next-btn {
  margin: 60rpx 30rpx;
  background: #409EFF;
  color: #fff;
  border-radius: 44rpx;
}