<wxs src="../../../../utils/array.wxs" module="arrayUtil" />
<view class="container">
  <view class="step-header">
    <view class="step-item finished">
      <view class="step-num">✓</view>
      <text>基础信息</text>
    </view>
    <view class="step-line active"></view>
    <view class="step-item active">
      <view class="step-num">2</view>
      <text>能力证明</text>
    </view>
    <view class="step-line"></view>
    <view class="step-item">
      <view class="step-num">3</view>
      <text>提交审核</text>
    </view>
  </view>

  <view class="form-box">
    <view class="tip-box">
      完善的能力证明能让家长更信任你，建议上传教师资格证、英语四六级、竞赛奖项等。
    </view>

    <view class="section-title">获奖证书 (最多9张)</view>
    <view class="upload-grid">
      <block wx:for="{{certImgs}}" wx:key="*this">
        <view class="grid-item">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}"></image>
          <view class="del-btn" catchtap="deleteImg" data-index="{{index}}">×</view>
        </view>
      </block>
      <view class="grid-item add-btn" bindtap="chooseCertImage" wx:if="{{certImgs.length < 9}}">
        <text class="icon">+</text>
      </view>
    </view>

    <view class="section-title">自我介绍/试课视频 (可选)</view>
    <view class="upload-area video-area" bindtap="chooseVideo">
      <video wx:if="{{videoUrl}}" src="{{videoUrl}}" class="preview-video"></video>
      <view wx:else class="upload-placeholder">
        <text class="icon">🎥</text>
        <text class="text">上传1分钟自我介绍</text>
      </view>
    </view>

    <!-- 教学设置 -->
    <view class="section-title">可教授年级 <text class="required">*</text></view>
    <view class="tag-container">
      <view 
        wx:for="{{gradeList}}" 
        wx:key="id" 
        class="tag {{arrayUtil.includes(selectedGrades, item.id) ? 'selected' : ''}}"
        bindtap="toggleGrade"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </view>

    <view class="section-title">可教授科目 <text class="required">*</text></view>
    <view class="tag-container">
      <view 
        wx:for="{{subjectList}}" 
        wx:key="id" 
        class="tag {{arrayUtil.includes(selectedSubjects, item.id) ? 'selected' : ''}}"
        bindtap="toggleSubject"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </view>

    <view class="section-title">期望时薪 <text class="required">*</text></view>
    <view class="price-input-wrap">
      <text class="price-unit">¥</text>
      <input 
        class="price-input" 
        type="digit" 
        placeholder="请输入时薪" 
        value="{{expectPrice}}" 
        bindinput="onPriceInput"
      />
      <text class="price-suffix">/小时</text>
    </view>
  </view>

  <button class="submit-btn" bindtap="submitAll" loading="{{isSubmitting}}">提交认证</button>
</view>