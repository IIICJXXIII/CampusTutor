.container {
  padding-bottom: 40rpx;
}

/* 步骤条样式 - 通用，建议提取到 app.wxss 或 组件 */
.step-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  background: #fff;
  margin-bottom: 20rpx;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}
.step-item.active {
  color: #409EFF;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eee;
  color: #666;
  text-align: center;
  line-height: 40rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}
.step-item.active .step-num {
  background: #409EFF;
  color: #fff;
}
.step-line {
  width: 60rpx;
  height: 2rpx;
  background: #eee;
  margin: -30rpx 20rpx 0;
}

/* 表单样式 */
.form-box {
  background: #fff;
  padding: 30rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #409EFF;
}
.input-group {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
}
.input, .picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.placeholder {
  color: #ccc;
}

/* 上传区域 */
.upload-area {
  width: 100%;
  height: 300rpx;
  background: #f9f9f9;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}
.upload-placeholder .icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}
.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.next-btn {
  margin: 60rpx 30rpx;
  background: #409EFF;
  color: #fff;
  border-radius: 44rpx;
}

.tip-box {
  background: #ecf5ff;
  color: #409EFF;
  font-size: 24rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
}
.grid-item {
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.grid-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.add-btn {
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
  color: #ccc;
  border-radius: 8rpx;
}
.del-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: red;
  color: white;
  border-radius: 50%;
  text-align: center;
  line-height: 34rpx;
  font-size: 24rpx;
}
.submit-btn {
  margin: 60rpx 30rpx;
  background: #409EFF;
  color: #fff;
  border-radius: 44rpx;
}

/* 必填项标记 */
.required {
  color: #ff4d4f;
  margin-left: 8rpx;
}

/* 标签选择器 */
.tag-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border: 2rpx solid #e0e0e0;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
}

.tag.selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-color: #667eea;
}

/* 时薪输入 */
.price-input-wrap {
  display: flex;
  align-items: center;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 30rpx;
}

.price-unit {
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
  margin-right: 12rpx;
}

.price-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  background: transparent;
}

.price-suffix {
  font-size: 28rpx;
  color: #999;
}