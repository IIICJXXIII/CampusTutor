/* 教师课表页面样式 - 简约专业风 */
.container {
  padding: 20rpx;
  flex: 1;
}

/* 布局辅助类 */
.flex-1 {
  flex: 1;
}

.text-20 {
  font-size: 20px;
}

/* 卡片样式扩展 */
.card-secondary {
  background-color: #E8F8F5;
  border-left: 4px solid #1E6F9F;
}

/* 课表滚动容器 */
.schedule-scroll {
  height: 600rpx;
  border: 1px solid #F1F3F5;
  border-radius: 12px;
  overflow: hidden;
}

/* 课表网格 */
.schedule-grid {
  display: flex;
  flex-direction: column;
  min-width: 900rpx;
}

/* 表头 */
.grid-header {
  display: flex;
  background-color: #F8F9FA;
  border-bottom: 1px solid #F1F3F5;
}

.header-cell {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border-right: 1px solid #F1F3F5;
  min-width: 120rpx;
}

.header-cell.corner {
  flex: 0 0 120rpx;
  background-color: #1E6F9F;
  color: #FFFFFF;
  font-weight: 600;
  border-right: 1px solid #1A638A;
}

/* 时段标题 */
.period-section {
  margin-top: 16rpx;
}

.period-title {
  padding: 12rpx 20rpx;
  background-color: #E8F8F5;
  color: #1E6F9F;
  font-weight: 600;
  font-size: 14px;
  border-left: 4px solid #1E6F9F;
}

/* 网格行 */
.grid-row {
  display: flex;
  border-bottom: 1px solid #F1F3F5;
}

/* 时间单元格 */
.time-cell {
  flex: 0 0 120rpx;
  padding: 16rpx;
  background-color: #F8F9FA;
  border-right: 1px solid #F1F3F5;
  border-bottom: 1px solid #F1F3F5;
}

/* 课表单元格 */
.schedule-cell {
  flex: 1;
  min-height: 100rpx;
  border-right: 1px solid #F1F3F5;
  border-bottom: 1px solid #F1F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
  background-color: #FFFFFF;
}

.schedule-cell:active {
  background-color: #F8F9FA;
}

/* 可预约状态 */
.schedule-cell.available {
  background-color: #E8F8F5;
  border: 1px solid #D4F0E8;
}

.available-icon {
  font-size: 24px;
  color: #1E6F9F;
  font-weight: 600;
}

/* 已排课状态 */
.schedule-cell.booked {
  background-color: #1E6F9F;
  color: #FFFFFF;
  border: 1px solid #1A638A;
}

.booked-content {
  padding: 8rpx;
  text-align: center;
  width: 100%;
}

.text-xs {
  font-size: 10px;
  line-height: 1.2;
}

/* 图例样式 */
.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-dot.available {
  background-color: #E8F8F5;
  border: 1px solid #D4F0E8;
}

.legend-dot.booked {
  background-color: #1E6F9F;
  border: 1px solid #1A638A;
}

.legend-dot.unavailable {
  background-color: #F1F3F5;
  border: 1px solid #DEE2E6;
}

/* 月视图样式 */
.month-view {
  border: 1px solid #F1F3F5;
  border-radius: 12px;
  overflow: hidden;
}

.month-header {
  padding: 20rpx;
  background-color: #1E6F9F;
  color: #FFFFFF;
  text-align: center;
}

.month-grid {
  display: flex;
  flex-direction: column;
}

.month-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  border-bottom: 1px solid #F1F3F5;
}

.month-weekday {
  padding: 12rpx;
  text-align: center;
  background-color: #F8F9FA;
  border-right: 1px solid #F1F3F5;
}

.month-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.month-day {
  padding: 16rpx;
  min-height: 100rpx;
  border-right: 1px solid #F1F3F5;
  border-bottom: 1px solid #F1F3F5;
  display: flex;
  flex-direction: column;
}

.day-events {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}

.event-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

/* 表单组样式 */
.form-group {
  margin-bottom: 20rpx;
}

/* 模态框样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background-color: #FFFFFF;
  border-radius: 12px;
  width: 85%;
  max-width: 500rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 0.5px 2px rgba(0, 0, 0, 0.1);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1px solid #F1F3F5;
}

.modal-close {
  font-size: 24px;
  color: #ADB5BD;
  cursor: pointer;
  padding: 4rpx;
}

.modal-close:active {
  color: #6C757D;
}

.modal-body {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: 16rpx;
  }
  
  .schedule-scroll {
    height: 500rpx;
  }
  
  .schedule-grid {
    min-width: 700rpx;
  }
  
  .header-cell {
    min-width: 100rpx;
  }
  
  .time-cell {
    flex: 0 0 100rpx;
  }
  
  .header-cell.corner {
    flex: 0 0 100rpx;
  }
  
  .schedule-cell {
    min-height: 80rpx;
  }
}