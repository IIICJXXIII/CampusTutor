/* 教师课表页面样式 - 修复版本 */

/* 页面容器 - 移除复杂背景 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 0;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top);
}

/* 说明卡片 */
.info-card {
  margin: 20rpx 24rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #E8F8F5 0%, #D4F0E8 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(30, 111, 159, 0.08);
}

.info-icon {
  font-size: 32rpx;
}

.info-text {
  font-size: 24rpx;
  color: #1E6F9F;
  font-weight: 500;
  line-height: 1.4;
}

/* 课表主卡片 */
.schedule-card {
  margin: 0 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 课表容器 - 不需要滚动，自适应宽度 */
.schedule-wrapper {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

/* 课表网格 - 100%宽度 */
.schedule-grid {
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* 表头 */
.grid-header {
  display: flex;
  background: linear-gradient(135deg, #1E6F9F 0%, #2D8CC9 100%);
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-cell {
  flex: 1;
  padding: 16rpx 4rpx;
  text-align: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
}

.header-cell:last-child {
  border-right: none;
}

.header-cell.corner {
  flex: 0 0 90rpx;
  background: rgba(0, 0, 0, 0.1);
  font-weight: 600;
}

/* 时段分组标题 */
.period-title {
  padding: 12rpx 16rpx;
  background: #E8F8F5;
  color: #1E6F9F;
  font-weight: 600;
  font-size: 24rpx;
  border-left: 4rpx solid #1E6F9F;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.period-icon {
  font-size: 24rpx;
}

/* 网格行 */
.grid-row {
  display: flex;
  border-bottom: 1rpx solid #F1F3F5;
}

.grid-row:last-child {
  border-bottom: none;
}

/* 时间单元格 - 紧凑版 */
.time-cell {
  flex: 0 0 90rpx;
  padding: 12rpx 6rpx;
  background: #FAFBFC;
  border-right: 1rpx solid #F1F3F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.time-start {
  font-size: 22rpx;
  font-weight: 600;
  color: #343A40;
}

.time-end {
  font-size: 18rpx;
  color: #ADB5BD;
}

/* 课表单元格 - 紧凑版 */
.schedule-cell {
  flex: 1;
  min-height: 70rpx;
  border-right: 1rpx solid #F1F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  transition: all 0.2s ease;
}

.schedule-cell:last-child {
  border-right: none;
}

.schedule-cell:active {
  background: #F0F0F0;
}

/* 选中/可预约状态 */
.schedule-cell.active {
  background: linear-gradient(135deg, #1E6F9F 0%, #2D8CC9 100%);
}

.schedule-cell.active text {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 图例区域 */
.legend {
  margin: 20rpx 24rpx;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  gap: 48rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
  background: #F1F3F5;
  border: 1rpx solid #DEE2E6;
}

.legend-dot.active {
  background: linear-gradient(135deg, #1E6F9F 0%, #2D8CC9 100%);
  border: none;
}

.legend-item text {
  font-size: 24rpx;
  color: #495057;
}

/* 操作区域 */
.action-area {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-save {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1E6F9F 0%, #2D8CC9 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(30, 111, 159, 0.3);
}

.btn-save:active {
  opacity: 0.9;
}

.btn-save[disabled] {
  background: #CED4DA;
  box-shadow: none;
}