/* 教师课表页面样式 - 简约专业风 */
page {
  background: #F8F9FA;
  --prof-primary: #1E6F9F;
  --prof-primary-dark: #165b85;
  --prof-secondary: #E8F8F5;
  --prof-selected-bg: #1E6F9F;
  --prof-border: #E2E8F0;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 说明卡片 */
.info-card {
  display: flex;
  align-items: center;
  background: var(--prof-secondary); /* Mint Green BG */
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin: 16rpx 24rpx;
  flex-shrink: 0;
  border: 1rpx solid #B0E0D8;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.info-text {
  font-size: 24rpx;
  color: var(--prof-primary); /* Deep Blue Text */
  flex: 1;
}

/* 课表滚动区域 */
.schedule-scroll {
  flex: 1;
  margin: 0 24rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid var(--prof-border);
}

.schedule-grid {
  min-width: 650rpx;
}

.grid-header {
  display: flex;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 10;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--prof-border);
}

.header-cell {
  flex: 1;
  min-width: 70rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  padding: 8rpx 0;
}

.header-cell.corner {
  min-width: 100rpx;
  flex: none;
  color: #999;
  font-weight: normal;
}

/* 时段标题 */
.period-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--prof-primary);
  padding: 12rpx 8rpx 4rpx;
  background: transparent;
  margin: 4rpx 0;
  border-radius: 0;
  border-bottom: 1rpx dashed var(--prof-border);
}

.grid-row {
  display: flex;
  margin-bottom: 4rpx;
}

.time-cell {
  min-width: 100rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 8rpx;
}

.time-start {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
  font-family: monospace;
}

.time-end {
  font-size: 18rpx;
  color: #999;
  font-family: monospace;
}

.schedule-cell {
  flex: 1;
  min-width: 70rpx;
  height: 48rpx;
  margin: 2rpx;
  border-radius: 4rpx; /* Sharper */
  background: #F8F9FA;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.1s;
  font-size: 22rpx;
  color: #ccc;
  border: 1rpx solid transparent;
}

.schedule-cell.active {
  background: var(--prof-selected-bg);
  color: #fff;
  font-weight: bold;
  border-color: var(--prof-primary-dark);
}

.schedule-cell:active {
  opacity: 0.8;
}

/* 图例 */
.legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding: 16rpx 0;
  flex-shrink: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #666;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: #F8F9FA;
  margin-right: 8rpx;
  border: 1rpx solid #ddd;
}

.legend-dot.active {
  background: var(--prof-primary);
  border: none;
}

/* 保存按钮 */
.action-area {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
  border-top: 1rpx solid var(--prof-border);
}

.btn-save {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--prof-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 8rpx; /* 4px */
  border: none;
}

.btn-save:active {
  background: var(--prof-primary-dark);
}

.btn-save[disabled] {
  background: #CFD8DC;
}
