/* Global Design System - Warm & Friendly Theme */
page {
  /* Brand Colors - Warm/Family Theme */
  --primary: #8B5A2B; /* Caramel Brown - Emphasis/Buttons */
  --primary-light: #A67B5B;
  --secondary: #F8C8B4; /* Soft Orange Pink - Decorative/Secondary */
  --secondary-light: #FFF0E6;
  
  /* Functional Colors */
  --success: #66BB6A; /* Softer Green */
  --warning: #FFB74D; /* Softer Orange */
  --danger: #EF5350; /* Softer Red */
  --info: #42A5F5;
  
  /* Neutral Colors */
  --bg-body: #FFFBF7; /* Very Light Warm White */
  --bg-card: #F9F2E8; /* Warm Beige */
  --text-main: #4A4036; /* Dark Warm Grey/Brown */
  --text-secondary: #8C8177; /* Warm Grey */
  --text-placeholder: #BDB6B0;
  --border: #E8E0D9;
  
  /* Shadows - Soft & Warm */
  --shadow-sm: 0 4rpx 8rpx rgba(139, 90, 43, 0.05); /* Caramel tint */
  --shadow-md: 0 6rpx 16rpx rgba(139, 90, 43, 0.08);
  --shadow-lg: 0 12rpx 24rpx rgba(139, 90, 43, 0.12);
  --shadow-primary: 0 8rpx 20rpx rgba(139, 90, 43, 0.25);
  --shadow-hover: 0 8rpx 24rpx rgba(248, 200, 180, 0.4); /* Pink-orange shadow */

  /* Spacing & Radius */
  --radius-sm: 12rpx;
  --radius-md: 24rpx; /* ~12px */
  --radius-lg: 32rpx; /* ~16px */
  --radius-xl: 40rpx;
  
  /* Apply global font */
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft Yahei', -apple-system, sans-serif;
  background-color: var(--bg-body);
  color: var(--text-main);
  box-sizing: border-box;
  font-size: 30rpx; /* Slightly larger body text per spec (15px) */
  line-height: 1.5;
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}

/* Global button text centering */
button {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Utility Components */

/* 1. Cards */
.card-box {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 32rpx;
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.5); /* Subtle highlight */
}

.card-box:active {
  transform: scale(0.995);
}

/* 2. Buttons */
.btn-primary {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 24rpx 0;
  text-align: center;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

/* Frosted glass effect overlay */
.btn-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(255,255,255,0.1), rgba(255,255,255,0));
  pointer-events: none;
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: var(--shadow-hover);
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 22rpx 0;
  text-align: center;
}

/* 3. Typography Helpers */
.text-h1 { font-size: 44rpx; font-weight: 600; color: var(--text-main); line-height: 1.4; } /* ~22px */
.text-h2 { font-size: 36rpx; font-weight: 600; color: var(--text-main); line-height: 1.5; } /* ~18px */
.text-h3 { font-size: 32rpx; font-weight: 600; color: var(--text-main); }
.text-body { font-size: 30rpx; color: var(--text-main); }
.text-desc { font-size: 26rpx; color: var(--text-secondary); }

/* 4. Layout Helpers */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.align-center { align-items: center; }
.gap-sm { gap: 16rpx; }
.gap-md { gap: 32rpx; }