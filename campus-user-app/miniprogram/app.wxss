/**app.wxss**/
@import "style/iconfont.wxss";

/* Global Design System */
page {
  /* Brand Colors - Modern Violet/Blue Theme */
  --primary: #6C63FF;
  --primary-light: #8F88FF;
  --primary-dark: #5046e5;
  --primary-fade: rgba(108, 99, 255, 0.1);
  
  /* Secondary Colors */
  --secondary: #F50057;
  --success: #00BFA5;
  --warning: #FFAB00;
  --danger: #FF3D00;
  --info: #2979FF;

  /* Neutral Colors */
  --bg-body: #F4F7F9; /* Cool Gray Background */
  --bg-card: #FFFFFF;
  --text-main: #2D3748; /* Dark Blue-Gray */
  --text-secondary: #718096;
  --text-placeholder: #A0AEC0;
  --border: #E2E8F0;
  
  /* Shadows - Soft & Modern */
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4rpx 6rpx rgba(0, 0, 0, 0.07);
  --shadow-lg: 0 10rpx 15rpx rgba(0, 0, 0, 0.1);
  --shadow-primary: 0 8rpx 20rpx rgba(108, 99, 255, 0.3);

  /* Spacing & Radius */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  
  /* Apply global font */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  background-color: var(--bg-body);
  color: var(--text-main);
  box-sizing: border-box;
  font-size: 28rpx;
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}

/* Utility Components */

/* 1. Cards */
.card-box {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  padding: 24rpx;
  margin-bottom: 24rpx;
  transition: transform 0.2s, box-shadow 0.2s;
}

.card-box:active {
  transform: scale(0.995);
}

/* 2. Buttons */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 20rpx 0;
  text-align: center;
  box-shadow: var(--shadow-primary);
  transition: all 0.3s;
}

.btn-primary:active {
  box-shadow: none;
  transform: translateY(2rpx);
  opacity: 0.9;
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 18rpx 0;
  text-align: center;
}

/* 3. Typography Helpers */
.text-h1 { font-size: 40rpx; font-weight: 700; color: var(--text-main); line-height: 1.2; }
.text-h2 { font-size: 32rpx; font-weight: 700; color: var(--text-main); line-height: 1.3; }
.text-h3 { font-size: 28rpx; font-weight: 600; color: var(--text-main); }
.text-body { font-size: 28rpx; color: var(--text-main); }
.text-desc { font-size: 24rpx; color: var(--text-secondary); }

/* 4. Layout Helpers */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.align-center { align-items: center; }
.gap-sm { gap: 12rpx; }
.gap-md { gap: 24rpx; }