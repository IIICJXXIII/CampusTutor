# ============================================================
# CampusTutor 后端环境变量示例
# 复制本文件为 .env 并填写实际值
# ============================================================

# ---- 数据库 ----
DB_URL=jdbc:mysql://localhost:3306/campus_tutor_db?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=123456

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT 密钥（生产环境务必修改，至少32字节）----
JWT_SECRET=campus-tutor-jwt-secret-key-must-be-at-least-32-bytes
JWT_EXPIRATION=86400000

# ---- 高德地图 Web 服务 API Key ----
AMAP_KEY=395b2de0b9cf263e585280d5d81821a4

# ---- LLM (AI) 配置 ----
LLM_ENABLED=true
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-2673624ce4fa4518b3477ddf012f4734
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 百度 OCR ----
BAIDU_OCR_ENABLED=true
BAIDU_OCR_API_KEY=gI099ZXdFhpgtTCFRh09oEhb
BAIDU_OCR_SECRET_KEY=0XhlchlReiYo7x026ElJYBRXBvMN11mf

# ---- 豆包视觉 OCR ----
DOUBAO_VISION_ENABLED=true
DOUBAO_VISION_API_KEY=0134f705-9ea1-42e6-99ec-5d9156af5cac

# ---- CORS 白名单（逗号分隔）----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3001

# ---- 文件上传 ----
FILE_UPLOAD_PATH=./uploads
FILE_UPLOAD_BASE_URL=http://localhost:8080/uploads
